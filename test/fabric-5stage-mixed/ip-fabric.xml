<data>
    <ip-fabric xmlns="http://example.com/ip-fabric">
        <fabric>
            <name>dc1</name>
            <switch>
                <name>leaf1</name>
                <id>1</id>
                <type>AristaEOS_4_36_3_2M</type>
                <management-address>172.31.37.11/24</management-address>
                <management-gateway>172.31.37.1</management-gateway>
                <role>leaf</role>
                <pod>pod-1</pod>
            </switch>
            <switch>
                <name>leaf2</name>
                <id>2</id>
                <type>NokiaSRLinux_25_3_2</type>
                <role>leaf</role>
                <pod>pod-2</pod>
            </switch>
            <switch>
                <name>spine1</name>
                <id>11</id>
                <type>NokiaSRLinux_25_3_2</type>
                <role>spine</role>
                <pod>pod-1</pod>
                <plane>plane-1</plane>
            </switch>
            <switch>
                <name>spine2</name>
                <id>12</id>
                <type>AristaEOS_4_36_3_2M</type>
                <management-address>172.31.37.22/24</management-address>
                <management-gateway>172.31.37.1</management-gateway>
                <role>spine</role>
                <pod>pod-2</pod>
                <plane>plane-1</plane>
            </switch>
            <switch>
                <name>superspine1</name>
                <id>21</id>
                <type>AristaEOS_4_36_3_2M</type>
                <management-address>172.31.37.31/24</management-address>
                <management-gateway>172.31.37.1</management-gateway>
                <role>super-spine</role>
                <plane>plane-1</plane>
            </switch>
            <fabric-link>
                <lower-switch>leaf1</lower-switch>
                <lower-port>Ethernet49</lower-port>
                <upper-switch>spine1</upper-switch>
                <upper-port>ethernet-1/1</upper-port>
            </fabric-link>
            <fabric-link>
                <lower-switch>leaf2</lower-switch>
                <lower-port>ethernet-1/49</lower-port>
                <upper-switch>spine2</upper-switch>
                <upper-port>Ethernet1</upper-port>
            </fabric-link>
            <fabric-link>
                <lower-switch>spine1</lower-switch>
                <lower-port>ethernet-1/31</lower-port>
                <upper-switch>superspine1</upper-switch>
                <upper-port>Ethernet1</upper-port>
            </fabric-link>
            <fabric-link>
                <lower-switch>spine2</lower-switch>
                <lower-port>Ethernet31</lower-port>
                <upper-switch>superspine1</upper-switch>
                <upper-port>Ethernet2</upper-port>
            </fabric-link>
            <server>
                <name>server1</name>
                <connectivity>
                    <profile>dual-homed</profile>
                    <link>
                        <switch>leaf1</switch>
                        <switch-port>Ethernet1</switch-port>
                        <server-port>eth1</server-port>
                    </link>
                    <link>
                        <switch>leaf2</switch>
                        <switch-port>ethernet-1/1</switch-port>
                        <server-port>eth2</server-port>
                    </link>
                </connectivity>
            </server>
            <server>
                <name>server2</name>
                <connectivity>
                    <profile>single-homed</profile>
                    <link>
                        <switch>leaf2</switch>
                        <switch-port>ethernet-1/2</switch-port>
                        <server-port>eth1</server-port>
                    </link>
                </connectivity>
            </server>
            <server>
                <name>server3</name>
                <connectivity>
                    <profile>single-homed</profile>
                    <link>
                        <switch>leaf1</switch>
                        <switch-port>Ethernet2</switch-port>
                        <server-port>eth1</server-port>
                    </link>
                </connectivity>
            </server>
        </fabric>
    </ip-fabric>
</data>
