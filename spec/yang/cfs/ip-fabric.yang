module ip-fabric {
  yang-version 1.1;
  namespace "http://example.com/ip-fabric";
  prefix ipf;

  import stratoweave {
    prefix sw;
  }

  organization "StratoWeave";
  description
    "IP fabric underlay service model.";

  revision 2026-11-06 {
    description "Initial schema-only underlay service model.";
  }

  container ip-fabric {
    description "IP fabric underlay service model.";
    list fabric {
      key name;
      sw:transform dorsi.cfs.Fabric;
      description
        "A complete physical fabric.";
      leaf name {
        type string;
      }

      list switch {
        key name;
        unique id;
        min-elements 2;
        description
          "Fabric switch.";
        leaf name {
          type string;
          description "Switch name.";
        }
        leaf id {
          type uint16;
          mandatory true;
          description
            "Numeric switch identifier, unique in the fabric. Loopback and
             point-to-point addresses and BGP AS numbers are derived from it.";
        }
        leaf type {
          type string;
          mandatory true;
          description "Device type.";
        }
        leaf mock {
          type boolean;
          default false;
        }
        leaf management-address {
          type string;
          description
            "IPv4 address and prefix length of the management interface,
             such as 172.20.20.11/24. dorsi connects to the switch at this
             address and keeps it on the management interface. Required for
             every device type that does not take its management address
             from DHCP: such a device holds the address in configuration that
             dorsi manages, and would lose it without this leaf.";
        }
        leaf management-gateway {
          type string;
          description
            "IPv4 address of the gateway of the management network, such
             as 172.20.20.1, for a switch with a management-address. dorsi
             keeps it as the default route of the management VRF, which it
             would otherwise remove. Without it the switch is reachable
             only from its own management subnet. A device that takes its
             management address from DHCP gets its gateway there too.";
        }
        leaf role {
          type enumeration {
            enum leaf;
            enum spine;
            enum super-spine;
          }
          mandatory true;
        }
        leaf pod {
          when "../role!='super-spine'";
          type string;
          default "pod-1";
          description "Pod membership; normally omitted for three-stage fabrics.";
        }
        leaf plane {
          when "../../switch[role='super-spine'] and ../role!='leaf'";
          type string;
          default "plane-1";
          description
            "Five-stage spine or superspine plane. Every pod must have
             a spine in each plane; every plane must have a superspine.";
        }
      }

      list fabric-link {
        key "lower-switch lower-port upper-switch upper-port";
        min-elements 1;
        unique "lower-switch lower-port";
        unique "upper-switch upper-port";
        must "(../switch[name=current()/lower-switch]/role='leaf' and
                 ../switch[name=current()/upper-switch]/role='spine' and
                 ../switch[name=current()/lower-switch]/pod =
                 ../switch[name=current()/upper-switch]/pod) or
              (../switch[name=current()/lower-switch]/role='spine' and
                 ../switch[name=current()/upper-switch]/role='super-spine' and
                 ../switch[name=current()/lower-switch]/plane =
                 ../switch[name=current()/upper-switch]/plane)" {
          error-message "Fabric links must join adjacent tiers in the same pod or plane.";
        }
        description
          "One routed physical link.";
        leaf lower-switch {
          type leafref {
            path "../../switch/name";
          }
        }
        leaf lower-port {
          type string;
        }
        leaf upper-switch {
          type leafref {
            path "../../switch/name";
          }
        }
        leaf upper-port {
          type string;
        }
        container state {
          config false;
          description
            "State of the link, lifted from the RFS fabric-interface entries
             of its two ends. A status is up only when both ends are up, down
             if either end is down and unknown when either is unavailable.";
          leaf link-status {
            type enumeration {
              enum up;
              enum down;
              enum unknown;
            }
            description "Oper-state of the interfaces on the link.";
          }
          leaf bgp-status {
            type enumeration {
              enum up;
              enum down;
              enum unknown;
            }
            description "State of the eBGP session on the link.";
          }
          leaf bgp-down-seconds {
            type uint32;
            units seconds;
            description
              "How long bgp-status has been down without a break while
               link-status is up, as of the last poll. A session can take up
               to its connect-retry time (120 seconds by default on SR Linux)
               to establish after the link comes up or the configuration
               changes, so some time down is expected. Not reported when
               bgp-status is not down or link-status is not up.";
          }
          leaf cabling-status {
            type enumeration {
              enum ok {
                description "An end sees the other end over LLDP.";
              }
              enum mismatch {
                description
                  "An end sees a different switch or port than the link
                   describes: the cable is plugged in elsewhere.";
              }
              enum no-neighbor {
                description "The ends that are up see no LLDP neighbor.";
              }
              enum unknown;
            }
            description
              "Whether the cable joins the ports the link describes, from the
               LLDP neighbors of its two ends. An end that is not up is left
               out, LLDP needs a working link.";
          }
          container lower-neighbor {
            description "The LLDP neighbor that the lower end sees.";
            leaf device {
              type string;
            }
            leaf interface {
              type string;
            }
          }
          container upper-neighbor {
            description "The LLDP neighbor that the upper end sees.";
            leaf device {
              type string;
            }
            leaf interface {
              type string;
            }
          }
        }
      }

      list tenant {
        key name;
        description
          "A tenant of the EVPN-VXLAN overlay. Its networks are bridged
           between the leaves over VXLAN, with EVPN as the control plane.
           A network is placed only on the leaves of the servers attached
           to it.";
        leaf name {
          type string;
        }
        list vrf {
          key name;
          description
            "A routed VRF: an IP-VRF on each leaf of its networks, routing
             between them with symmetric IRB. A leaf reaches the networks
             of the VRF it has no server in through EVPN IP prefix routes
             (type 5).";
          leaf name {
            type string;
          }
          leaf vni {
            type uint32 {
              range "1..16777215";
            }
            description
              "Layer 3 VNI. Derived from the fabric, tenant and VRF names
               when absent; set it to resolve a clash.";
          }
        }
        list network {
          key name;
          description
            "A layer 2 network: a MAC-VRF on each leaf it is placed on.";
          leaf name {
            type string;
          }
          leaf vni {
            type uint32 {
              range "1..16777215";
            }
            description
              "VXLAN network identifier. Derived from the fabric, tenant
               and network names when absent; set it to resolve a clash
               between two derived VNIs.";
          }
          leaf vrf {
            type string;
            description
              "The VRF of the tenant that routes the network. Absent for a
               network that is only bridged.";
          }
          leaf gateway {
            type string;
            description
              "Address and prefix length of the gateway of the network,
               such as 10.10.10.1/24, for a network in a VRF. Every leaf of
               the network answers on it with the same anycast address and
               MAC.";
          }
        }
      }

      list server {
        key name;
        description
          "Connectivity requirements for a server.";
        leaf name {
          type string;
          description "Server name.";
        }
        list attachment {
          key "tenant network";
          description
            "An overlay network the server is attached to, on all of its
             links.";
          leaf tenant {
            type leafref {
              path "../../../tenant/name";
            }
          }
          leaf network {
            type string;
            description "A network of the tenant.";
          }
          leaf vlan {
            type uint16 {
              range "1..4094";
            }
            description
              "VLAN tag the server sends the network with, absent when it
               sends it untagged.";
          }
          leaf ipv4-address {
            type string;
            description
              "Address and prefix length of the server in the network, such
               as 10.10.10.11/24. dorsi does not configure servers; the
               address is checked against the other servers of the network
               and documents the test setup.";
          }
        }
        container connectivity {
          must "(profile='single-homed' and
                   not(link[switch!=current()/link[1]/switch])) or
                (profile='dual-homed' and
                   link[switch!=current()/link[1]/switch] and
                   not(link[switch!=current()/link[1]/switch and
                     switch!=current()/link[switch!=current()/link[1]/switch][1]/switch]))" {
            error-message "The profile requires links to exactly one or two distinct leaves.";
          }
          description
            "Server connectivity profile.";
          leaf profile {
            type enumeration {
              enum single-homed {
                description
                  "One leaf, with one or more NIC links. Leaf-failure
                   survival is not required by this profile.";
              }
              enum dual-homed {
                description
                  "Two distinct leaves, with at least one NIC link to
                   each. Default profile for highly available workloads;
                   connectivity must survive the failure of either leaf.";
              }
            }
            default dual-homed;
          }
          list link {
            key "switch switch-port";
            min-elements 1;
            unique server-port;
            must "../../../switch[name=current()/switch]/role='leaf'" {
              error-message "Endpoint links must terminate on leaves.";
            }
            leaf switch {
              type leafref {
                path "../../../../switch/name";
              }
            }
            leaf switch-port {
              type string;
            }
            leaf server-port {
              type string;
              mandatory true;
            }
            container state {
              config false;
              description
                "State of the link, lifted from the RFS server-port entry of
                 its leaf port.";
              leaf link-status {
                type enumeration {
                  enum up;
                  enum down;
                  enum unknown;
                }
                description "Oper-state of the leaf port.";
              }
              leaf cabling-status {
                type enumeration {
                  enum ok {
                    description "The leaf port sees the server over LLDP.";
                  }
                  enum mismatch {
                    description
                      "The leaf port sees another system, or another port of
                       the server: the cable is plugged in elsewhere.";
                  }
                }
                description
                  "Whether the cable joins the leaf port to the server port,
                   from the LLDP neighbor of the leaf port. Not reported when
                   the server sends no LLDP; the port is only compared when
                   the server sends its name, not its MAC address.";
              }
              container neighbor {
                description "The LLDP neighbor that the leaf port sees.";
                leaf device {
                  type string;
                }
                leaf interface {
                  type string;
                }
              }
            }
          }
        }
      }
    }
  }
}
