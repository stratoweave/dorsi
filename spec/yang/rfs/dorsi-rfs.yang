module dorsi-rfs {
    yang-version "1.1";
    namespace "http://example.com/dorsi-rfs";
    prefix "dorsi-rfs";

    import stratoweave-rfs {
        prefix sw-rfs;
    }
    import ietf-inet-types {
      prefix inet;
    }
    import stratoweave {
      prefix sw;
    }

    augment "/sw-rfs:rfs" {
        list fabric-base-config {
            description
                "Base configuration of an IP fabric switch: loopback, BGP
                 autonomous system and the policy that advertises the loopback.
                 A switch has a single entry. It is a list keyed by the AS
                 number and not a container, because a container with a
                 transform and no data would send an empty configuration to
                 the device before its modules are known.";
            key asn;
            sw:rfs-transform dorsi.rfs.FabricBaseConfig;
            leaf asn {
                type inet:as-number;
            }
            container dynstate {
                description
                    "What the device has made of its own that dorsi must keep
                     in its configuration.";
                sw:dynstate;
                leaf-list eos-dynamic-vlan-interface {
                    description
                        "The VLAN interfaces EOS makes for the layer 3 VNIs of
                         its VRFs, such as Vlan4097. They are in the
                         configuration of the device, but EOS refuses to have
                         them created or removed, so the transform renders
                         them as EOS has them.";
                    type string;
                }
            }
            leaf role {
                type string;
            }
            leaf ipv4-address {
                description "Loopback address, used as router-id.";
                type string;
                mandatory true;
            }
            leaf management-address {
                description
                    "Address and prefix length of the management interface,
                     such as 172.20.20.11/24. Absent on a device that takes
                     its management address from DHCP.";
                type string;
            }
            leaf management-gateway {
                description
                    "Gateway of the management network, such as 172.20.20.1,
                     the default route of the management VRF.";
                type string;
            }
            leaf evpn {
                description
                    "Carry EVPN routes in BGP for the overlay. A leaf also
                     gets the VXLAN tunnel interface and a VTEP on its
                     loopback; a spine or super-spine passes the routes on
                     with their next hop, the VTEP that sent them.";
                type boolean;
                default false;
            }
            leaf-list fabric-port {
                description
                    "The ports of the switch's fabric links. Cisco NX-OS
                     cannot delete a physical port and reports every setting
                     of every port, so its base configuration renders all
                     its physical ports, these as routed ports.";
                type string;
            }
            list overlay-peer {
                description
                    "An eBGP session between loopbacks that carries EVPN
                     only, multihop. Juniper cRPD advertises the EVPN routes
                     of its own networks with the local address of the
                     session as next hop, whatever the export policy sets,
                     so a cRPD leaf sends them from its loopback, its VTEP,
                     to the loopbacks of its spines instead of over the
                     sessions of the links.";
                key address;
                leaf address {
                    description "Loopback of the peer.";
                    type string;
                }
                leaf asn {
                    type inet:as-number;
                    mandatory true;
                }
                leaf device {
                    description "Name of the peer, for the description.";
                    type string;
                }
            }
        }
        list mac-vrf {
            description
                "A layer 2 network of the overlay on a leaf: a MAC-VRF
                 bridged over VXLAN, with EVPN routes for MAC addresses
                 (type 2) and for flooding by ingress replication (type 3).";
            key name;
            sw:rfs-transform dorsi.rfs.MacVrf;
            leaf name {
                type string;
            }
            leaf vni {
                type uint32 {
                    range "1..16777215";
                }
                mandatory true;
            }
            leaf evi {
                type uint32 {
                    range "1..65535";
                }
                mandatory true;
            }
            leaf route-distinguisher {
                description "Such as 10.0.0.1:100, unique per leaf.";
                type string;
                mandatory true;
            }
            leaf route-target {
                description
                    "Such as target:100:10010, the same on every leaf of the
                     network.";
                type string;
                mandatory true;
            }
            leaf vlan {
                description
                    "The VLAN of the network inside a switch that bridges in
                     VLANs, such as Arista EOS, apart from the VLAN tags of
                     the servers. SR Linux has no use for it.";
                type uint16 {
                    range "2..4094";
                }
            }
            container irb {
                presence "The network is routed.";
                description
                    "The anycast gateway of the network, on irb0.";
                leaf index {
                    type uint16 {
                        range "1..9999";
                    }
                    mandatory true;
                }
                leaf gateway {
                    description "Such as 10.10.10.1/24.";
                    type string;
                    mandatory true;
                }
            }
            container state {
                config false;
                description
                    "Operational state of the MAC-VRF, polled from the
                     device.";
                leaf oper-status {
                    description "The oper-state of the network instance.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                leaf evpn-status {
                    description
                        "The oper-state of its EVPN instance, which bridges it
                         over VXLAN to the other leaves.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
            }
            list interface {
                description "A server-facing port or LAG in the network.";
                key name;
                leaf name {
                    description "Port or LAG, such as ethernet-1/1 or lag1.";
                    type string;
                }
                leaf vlan {
                    description
                        "VLAN tag of the server traffic, absent for untagged
                         traffic. It is also the subinterface index.";
                    type uint16 {
                        range "1..4094";
                    }
                }
            }
        }
        list ip-vrf {
            description
                "A routed VRF of the overlay on a leaf: an IP-VRF with a
                 layer 3 VNI, which routes between the IRB interfaces of its
                 networks and exchanges EVPN IP prefix routes (type 5).";
            key name;
            sw:rfs-transform dorsi.rfs.IpVrf;
            leaf name {
                type string;
            }
            leaf vni {
                type uint32 {
                    range "1..16777215";
                }
                mandatory true;
            }
            leaf evi {
                type uint32 {
                    range "1..65535";
                }
                mandatory true;
            }
            leaf route-distinguisher {
                type string;
                mandatory true;
            }
            leaf route-target {
                type string;
                mandatory true;
            }
            leaf-list irb-interface {
                description "IRB subinterfaces of its networks, such as irb0.10.";
                type string;
            }
            container state {
                config false;
                description
                    "Operational state of the IP-VRF, polled from the device.";
                leaf oper-status {
                    description "The oper-state of the network instance.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                leaf evpn-status {
                    description "The oper-state of its EVPN instance.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
            }
        }
        list server-lag {
            description
                "A LAG with LACP towards a server. On a dual-homed server it
                 is an all-active EVPN ethernet segment: both leaves use the
                 same ESI and LACP system ID, so that the server sees one
                 LACP partner.";
            key name;
            sw:rfs-transform dorsi.rfs.ServerLag;
            leaf name {
                description "Such as lag1.";
                type string;
            }
            leaf server {
                type string;
                mandatory true;
            }
            leaf lacp-system-id {
                type string;
                mandatory true;
            }
            leaf lacp-admin-key {
                type uint16 {
                    range "1..65535";
                }
                mandatory true;
            }
            leaf esi {
                description
                    "Ethernet segment identifier of a dual-homed server,
                     absent for a single-homed one.";
                type string;
            }
            container dynstate {
                description
                    "What the device reports of the LAG. EOS takes an
                     ethernet segment only on a LAG that is already there,
                     so the transform adds it once the LAG is.";
                sw:dynstate;
                leaf lag-present {
                    description "Whether the device has the LAG.";
                    type boolean;
                }
            }
            container state {
                config false;
                description
                    "Operational state of the LAG and its ethernet segment,
                     polled from the device.";
                leaf oper-status {
                    description "The oper-state of the LAG.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                leaf es-status {
                    description
                        "The oper-state of the ethernet segment, absent for a
                         LAG that is not one.";
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
            }
        }
        list fabric-interface {
            description
                "Routed point-to-point fabric link with its eBGP session.";
            key name;
            sw:rfs-transform dorsi.rfs.FabricInterface;
            leaf name {
                type string;
            }
            leaf ipv4-address {
                type string;
                mandatory true;
            }
            leaf ipv4-prefix-length {
                type uint8 {
                    range "0..32";
                }
                default "31";
            }
            container remote {
                leaf device {
                    type string;
                    mandatory true;
                }
                leaf interface {
                    type string;
                    mandatory true;
                }
            }
            container bgp {
                leaf peer-address {
                    type string;
                    mandatory true;
                }
                leaf peer-asn {
                    type inet:as-number;
                    mandatory true;
                }
            }

            container state {
                config false;
                description
                    "Operational state of the fabric interface, polled from the
                     device. oper-status is the interface oper-state and
                     bgp-status is the state of the eBGP session on it: up when
                     it is established, down for any other session state.";
                leaf oper-status {
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                leaf bgp-status {
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                container lldp-neighbor {
                    description
                        "The neighbor that LLDP reports on the interface, which
                         is where the cable actually goes. Empty when no LLDP
                         neighbor is seen.";
                    leaf device {
                        description "System name of the neighbor.";
                        type string;
                    }
                    leaf interface {
                        description "Port ID of the neighbor.";
                        type string;
                    }
                }
            }
        }
        list server-port {
            description
                "Leaf port facing a server.";
            key name;
            sw:rfs-transform dorsi.rfs.ServerPort;
            leaf name {
                type string;
            }
            leaf server {
                type string;
                mandatory true;
            }
            leaf server-port {
                type string;
                mandatory true;
            }
            leaf profile {
                description "Connectivity profile of the server.";
                type string;
                mandatory true;
            }
            leaf lag {
                description "The server-lag the port is a member of.";
                type string;
            }
            leaf-list trunk-vlan {
                description
                    "The VLANs of the networks of the port, on a switch that
                     sets the VLANs a trunk carries in one value, Cisco NX-OS,
                     where the network VLAN is the VLAN tag of its servers.";
                type uint16 {
                    range "1..4094";
                }
            }
            leaf native-vlan {
                description
                    "The VLAN of the network that the port carries untagged,
                     on Cisco NX-OS, among trunk-vlan.";
                type uint16 {
                    range "1..4094";
                }
            }

            container state {
                config false;
                description
                    "Operational state of the leaf port, polled from the
                     device.";
                leaf oper-status {
                    type enumeration {
                        enum up;
                        enum down;
                        enum unknown;
                    }
                }
                container lldp-neighbor {
                    description
                        "The neighbor that LLDP reports on the port. Empty when
                         the server sends no LLDP, which many do not.";
                    leaf device {
                        description "System name of the neighbor.";
                        type string;
                    }
                    leaf interface {
                        description "Port ID of the neighbor.";
                        type string;
                    }
                }
            }
        }
  }
}
