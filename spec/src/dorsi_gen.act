    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/config/ip-prefix",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/config/masklength-range",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/config/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/config/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/conditions/match-prefix-set/config/prefix-set",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/conditions/bgp-conditions/config/afi-safi-in",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/actions/config/policy-result",
    # EVPN-VXLAN overlay: IP MTU of the fabric links and EVPN in BGP
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv4/config/mtu",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv6/config/mtu",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/afi-safis/afi-safi/next-hop/config/preserve-next-hop",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/evpn/import-target",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/evpn/export-target",
    "/oc-sys:system/mac-address/config/routing-mac",
    # VXLAN tunnel interface (Arista experimental): VTEP, VLAN and VRF VNIs
    "/oc-if:interfaces/interface/arista-vxlan/config/src-ip-intf",
    "/oc-if:interfaces/interface/arista-vxlan/config/udp-port",
    "/oc-if:interfaces/interface/arista-vxlan/vlan-to-vnis/vlan-to-vni/vlan",
    "/oc-if:interfaces/interface/arista-vxlan/vlan-to-vnis/vlan-to-vni/config/vlan",
    "/oc-if:interfaces/interface/arista-vxlan/vlan-to-vnis/vlan-to-vni/config/vni",
    "/oc-if:interfaces/interface/arista-vxlan/vrf-to-vnis/vrf-to-vni/vrf",
    "/oc-if:interfaces/interface/arista-vxlan/vrf-to-vnis/vrf-to-vni/config/vrf",
    "/oc-if:interfaces/interface/arista-vxlan/vrf-to-vnis/vrf-to-vni/config/vni",
    # MAC-VRF (Arista experimental EVPN instance per VLAN)
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/name",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/config/name",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/config/route-distinguisher",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/config/redistribute",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/route-target/config/import",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/route-target/config/export",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/vlans/vlan/vlan-id",
    "/eos-exp:arista/eos/evpn/evpn-instances/evpn-instance/vlans/vlan/config/vlan-id",
    # VLANs, trunks with VLAN translation, and the anycast gateway (VARP)
    "/oc-netinst:network-instances/network-instance/config/route-distinguisher",
    "/oc-netinst:network-instances/network-instance/vlans/vlan/vlan-id",
    "/oc-netinst:network-instances/network-instance/vlans/vlan/config/vlan-id",
    "/oc-netinst:network-instances/network-instance/vlans/vlan/config/name",
    # State of a network: its VLAN and the interfaces that forward in it,
    # Vxlan1 among them while the network is bridged over VXLAN
    "/oc-netinst:network-instances/network-instance/vlans/vlan/state/vlan-id",
    "/oc-netinst:network-instances/network-instance/vlans/vlan/members/member/state/interface",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/config/interface-mode",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/config/native-vlan",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/config/trunk-vlans",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/ingress/translation-key",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/ingress/config/translation-key",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/ingress/config/bridging-vlan",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/egress/translation-key",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/egress/config/translation-key",
    "/oc-if:interfaces/interface/ethernet/switched-vlan/vlan-translation/egress/config/bridging-vlan",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/config/interface-mode",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/config/native-vlan",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/config/trunk-vlans",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/ingress/translation-key",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/ingress/config/translation-key",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/ingress/config/bridging-vlan",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/egress/translation-key",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/egress/config/translation-key",
    "/oc-if:interfaces/interface/aggregation/switched-vlan/vlan-translation/egress/config/bridging-vlan",
    "/oc-if:interfaces/interface/routed-vlan/config/vlan",
    "/oc-if:interfaces/interface/arista-varp/virtual-address/config/ip",
    "/oc-if:interfaces/interface/arista-varp/virtual-address/config/prefix-length",
    # Server LAGs with LACP
    "/oc-if:interfaces/interface/aggregation/config/lag-type",
    "/oc-if:interfaces/interface/ethernet/config/aggregate-id",
    "/oc-lacp:lacp/interfaces/interface/name",
    "/oc-lacp:lacp/interfaces/interface/config/name",
    "/oc-lacp:lacp/interfaces/interface/config/interval",
    "/oc-lacp:lacp/interfaces/interface/config/lacp-mode",
    "/oc-lacp:lacp/interfaces/interface/config/system-id-mac",
    # The ethernet segment of a dual-homed server
    "/oc-es:ethernet-segments/ethernet-segment/name",
    "/oc-es:ethernet-segments/ethernet-segment/config/name",
    "/oc-es:ethernet-segments/ethernet-segment/config/esi-type",
    "/oc-es:ethernet-segments/ethernet-segment/config/esi",
    "/oc-es:ethernet-segments/ethernet-segment/config/redundancy-mode",
    "/oc-es:ethernet-segments/ethernet-segment/config/es-import-route-target",
    "/oc-es:ethernet-segments/ethernet-segment/config/interface",
    ]

    # The paths referenced by these leafrefs are invalid - missing module
    # imports. We explicitly allow resolving the target leaf type to fallback to
    # a string so that we can avoid adding more models here ...
    broken_leafrefs = [
        "/network-instance/protocols/isis/instance/export-policy",
        "/network-instance/protocols/isis/instance/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/level/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/authentication/keychain",
        "/network-instance/protocols/isis/instance/level/authentication/keychain",
        "/network-instance/protocols/bgp/authentication/keychain",
        "/network-instance/protocols/bgp/rib-management/table/route-table-import",
        "/network-instance/protocols/bgp/group/authentication/keychain",
        "/network-instance/protocols/bgp/group/send-default-route/export-policy",
        "/network-instance/protocols/bgp/neighbor/authentication/keychain",
        "/network-instance/protocols/bgp/neighbor/send-default-route/export-policy",
    ]

    proc def __startup__():
        try:
            cfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/cfs")
            cfs_layer.models.extend([
                swyang.stratoweave,
                swyang.ietf_inet_types,
                swyang.ietf_yang_types,
                tmf_yang.ietf_yang_tmf_map,
                tmf_yang.swtmf.replace("TMF640_STORE_TRANSFORM", "dorsi.tmf.Tmf640Store"),
                tmf_yang.swtmf640
            ])
            rfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/rfs")
            rfs_layer.models.extend([swyang.stratoweave, swyang.rfs, swyang.ssh, swyang.ietf_inet_types, swyang.ietf_yang_types])

            spec = stratoweave.build.SysSpec("dorsi", [
                cfs_layer,
                rfs_layer,
            ], [
                stratoweave.build.DeviceType.from_dir(fc, "AristaEOS_4_36_3_2M", "yang/AristaEOS_4_36_3_2M",
                    transforms=[
                        swds.filter_schema(eos_paths),
                    ]),
                stratoweave.build.DeviceType.from_dir(fc, "CiscoIosXr_25_3_1", "yang/CiscoIosXr_25_3_1",
                    transforms=[
                        swds.filter_schema(xr_paths),
                    ]),
                stratoweave.build.DeviceType.from_dir(fc, "JuniperCRPD_24_4R1_9", "yang/JuniperCRPD_24_4R1_9",
                    transforms=[
                        swds.filter_schema(crpd_paths),
                        swds.remove_list_user_order(crpd_order_paths),
                    ]),
                stratoweave.build.DeviceType.from_dir(fc, "CiscoNXOS_10_6_4M", "yang/CiscoNXOS_10_6_4M",
                    transforms=[
                        swds.filter_schema(nxos_paths),
                    ]),
                stratoweave.build.DeviceType.from_dir(fc, "NokiaSRLinux_25_3_2", "yang/NokiaSRLinux_25_3_2",
                    transforms=[
                        swds.filter_schema(srl_paths),
                    ]),
            ])
            compiled_spec = spec.compile(broken_leafrefs)
            compiled_spec.gen_app(fc, "../src/")
        except Exception as exc:
            print(exc, err=True)
            env.exit(1)
        else:
            env.exit(0)
