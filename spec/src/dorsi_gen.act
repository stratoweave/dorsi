    "/oc-netinst:network-instances/network-instance/interfaces/interface/config/interface",
    "/oc-netinst:network-instances/network-instance/interfaces/interface/config/subinterface",
    # and the default route of that VRF, to the management gateway
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/prefix",
