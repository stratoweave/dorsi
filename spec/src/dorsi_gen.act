import file

import stratoweave.build
import stratoweave.device_schema as swds
import stratoweave.swyang as swyang
import tmf.tmf_yang as tmf_yang

actor main(env):
    fc = file.FileCap(env.cap)

    # JUNOS marks lists "ordered-by user" in many places where the order has no
    # effect on the applied configuration.
    crpd_order_paths = [
            "/jc:configuration/protocols/bgp/group/neighbor",
            "/jc:configuration/protocols/mpls/interface",
    ]

    # Keep only the XR nodes that dorsi actively uses.
    xr_paths = [
    "/um-hostname-cfg:hostname",
    "/um-hostname-cfg:hostname/system-network-name",
    "/um-interface-cfg:interfaces",
    "/um-interface-cfg:interfaces/interface",
    "/um-interface-cfg:interfaces/interface/interface-name",
    "/um-interface-cfg:interfaces/interface/description",
    "/um-interface-cfg:interfaces/interface/shutdown",
    "/um-interface-cfg:interfaces/interface/ipv4",
    "/um-interface-cfg:interfaces/interface/ipv4/um-if-ip-address-cfg:addresses",
    "/um-interface-cfg:interfaces/interface/ipv4/um-if-ip-address-cfg:addresses/address",
    "/um-interface-cfg:interfaces/interface/ipv4/um-if-ip-address-cfg:addresses/address/address",
    "/um-interface-cfg:interfaces/interface/ipv4/um-if-ip-address-cfg:addresses/address/netmask",
    "/um-interface-cfg:interfaces/interface/um-l2-ethernet-cfg:encapsulation",
    "/um-interface-cfg:interfaces/interface/um-l2-ethernet-cfg:encapsulation/dot1q",
    "/um-interface-cfg:interfaces/interface/um-l2-ethernet-cfg:encapsulation/dot1q/vlan-id",
    "/um-router-isis-cfg:router",
    "/um-router-isis-cfg:router/isis",
    "/um-router-isis-cfg:router/isis/processes",
    "/um-router-isis-cfg:router/isis/processes/process",
    "/um-router-isis-cfg:router/isis/processes/process/process-id",
    "/um-router-isis-cfg:router/isis/processes/process/is-type",
    "/um-router-isis-cfg:router/isis/processes/process/nets",
    "/um-router-isis-cfg:router/isis/processes/process/nets/net",
    "/um-router-isis-cfg:router/isis/processes/process/nets/net/net-id",
    "/um-router-isis-cfg:router/isis/processes/process/address-families",
    "/um-router-isis-cfg:router/isis/processes/process/address-families/address-family",
    "/um-router-isis-cfg:router/isis/processes/process/address-families/address-family/af-name",
    "/um-router-isis-cfg:router/isis/processes/process/address-families/address-family/saf-name",
    "/um-router-isis-cfg:router/isis/processes/process/address-families/address-family/metric-style",
    "/um-router-isis-cfg:router/isis/processes/process/address-families/address-family/metric-style/wide",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/interface-name",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/circuit-type",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/point-to-point",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/state",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/af-name",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/saf-name",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/metric-levels",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/metric-levels/metric-level",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/metric-levels/metric-level/level-number",
    "/um-router-isis-cfg:router/isis/processes/process/interfaces/interface/address-families/address-family/metric-levels/metric-level/default-metric",
    "/um-mpls-ldp-cfg:mpls",
    "/um-mpls-ldp-cfg:mpls/ldp",
    "/um-mpls-ldp-cfg:mpls/ldp/interfaces",
    "/um-mpls-ldp-cfg:mpls/ldp/interfaces/interface",
    "/um-mpls-ldp-cfg:mpls/ldp/interfaces/interface/interface-name",
    "/um-mpls-ldp-cfg:mpls/ldp/address-families",
    "/um-mpls-ldp-cfg:mpls/ldp/address-families/address-family",
    "/um-mpls-ldp-cfg:mpls/ldp/address-families/address-family/af-name",
    "/um-router-bgp-cfg:router",
    "/um-router-bgp-cfg:router/bgp",
    "/um-router-bgp-cfg:router/bgp/as",
    "/um-router-bgp-cfg:router/bgp/as/as-number",
    "/um-router-bgp-cfg:router/bgp/as/bgp",
    "/um-router-bgp-cfg:router/bgp/as/bgp/router-id",
    "/um-router-bgp-cfg:router/bgp/as/address-families",
    "/um-router-bgp-cfg:router/bgp/as/address-families/address-family",
    "/um-router-bgp-cfg:router/bgp/as/address-families/address-family/af-name",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/neighbor-group-name",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/remote-as",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/update-source",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/password",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/password/encrypted",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/address-families",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/address-families/address-family",
    "/um-router-bgp-cfg:router/bgp/as/neighbor-groups/neighbor-group/address-families/address-family/af-name",
    "/um-router-bgp-cfg:router/bgp/as/neighbors",
    "/um-router-bgp-cfg:router/bgp/as/neighbors/neighbor",
    "/um-router-bgp-cfg:router/bgp/as/neighbors/neighbor/address",
    "/um-router-bgp-cfg:router/bgp/as/neighbors/neighbor/description",
    "/um-router-bgp-cfg:router/bgp/as/neighbors/neighbor/use",
    "/um-router-bgp-cfg:router/bgp/as/neighbors/neighbor/use/neighbor-group",
    "/um-route-policy-cfg:routing-policy",
    "/um-route-policy-cfg:routing-policy/route-policies",
    "/um-route-policy-cfg:routing-policy/route-policies/route-policy",
    "/um-route-policy-cfg:routing-policy/route-policies/route-policy/route-policy-name",
    "/um-route-policy-cfg:routing-policy/route-policies/route-policy/rpl-route-policy",
    "/pfi-im-cmd-oper:interfaces",
    "/pfi-im-cmd-oper:interfaces/interface-xr",
    "/pfi-im-cmd-oper:interfaces/interface-xr/interface",
    "/pfi-im-cmd-oper:interfaces/interface-xr/interface/interface-name",
    "/pfi-im-cmd-oper:interfaces/interface-xr/interface/state",
]

    # Keep only the cRPD configuration nodes that dorsi's RFS transforms
    # actively write to.
    crpd_paths = [
    "/jc:configuration/interfaces/interface/description",
    "/jc:configuration/interfaces/interface/mac",
    "/jc:configuration/interfaces/interface/mtu",
    "/jc:configuration/interfaces/interface/name",
    "/jc:configuration/interfaces/interface/native-vlan-id",
    "/jc:configuration/interfaces/interface/unit/alias",
    "/jc:configuration/interfaces/interface/unit/description",
    "/jc:configuration/interfaces/interface/unit/encapsulation",
    "/jc:configuration/interfaces/interface/unit/family/inet",
    "/jc:configuration/interfaces/interface/unit/family/inet/address/name",
    "/jc:configuration/interfaces/interface/unit/family/inet6",
    "/jc:configuration/interfaces/interface/unit/family/inet6/address/name",
    "/jc:configuration/interfaces/interface/unit/family/iso",
    "/jc:configuration/interfaces/interface/unit/family/iso/address/name",
    "/jc:configuration/interfaces/interface/unit/mac",
    "/jc:configuration/interfaces/interface/unit/mtu",
    "/jc:configuration/interfaces/interface/unit/name",
    "/jc:configuration/interfaces/interface/unit/vlan-id",
    "/jc:configuration/protocols/bgp/group/authentication-algorithm",
    "/jc:configuration/protocols/bgp/group/authentication-key",
    "/jc:configuration/protocols/bgp/group/authentication-key-chain",
    "/jc:configuration/protocols/bgp/group/description",
    "/jc:configuration/protocols/bgp/group/export",
    "/jc:configuration/protocols/bgp/group/family/evpn/signaling",
    "/jc:configuration/protocols/bgp/group/family/inet-vpn/unicast",
    "/jc:configuration/protocols/bgp/group/family/inet6-vpn/unicast",
    "/jc:configuration/protocols/bgp/group/family/route-target",
    "/jc:configuration/protocols/bgp/group/hold-time",
    "/jc:configuration/protocols/bgp/group/local-address",
    "/jc:configuration/protocols/bgp/group/name",
    "/jc:configuration/protocols/bgp/group/neighbor/description",
    "/jc:configuration/protocols/bgp/group/neighbor/name",
    "/jc:configuration/protocols/bgp/group/neighbor/passive",
    "/jc:configuration/protocols/bgp/group/tcp-mss",
    "/jc:configuration/protocols/bgp/group/tcpao-auth-mismatch",
    "/jc:configuration/protocols/bgp/group/type",
    "/jc:configuration/protocols/bgp/log-updown",
    "/jc:configuration/protocols/isis/interface/family/name",
    "/jc:configuration/protocols/isis/interface/ldp-synchronization",
    "/jc:configuration/protocols/isis/interface/ldp-synchronization/disable",
    "/jc:configuration/protocols/isis/interface/ldp-synchronization/hold-time",
    "/jc:configuration/protocols/isis/interface/level/disable",
    "/jc:configuration/protocols/isis/interface/level/metric",
    "/jc:configuration/protocols/isis/interface/level/name",
    "/jc:configuration/protocols/isis/interface/lsp-interval",
    "/jc:configuration/protocols/isis/interface/name",
    "/jc:configuration/protocols/isis/interface/passive",
    "/jc:configuration/protocols/isis/interface/passive/remote-node-id",
    "/jc:configuration/protocols/isis/interface/passive/remote-node-iso",
    "/jc:configuration/protocols/isis/interface/point-to-point",
    "/jc:configuration/protocols/isis/level/authentication-key",
    "/jc:configuration/protocols/isis/level/authentication-type",
    "/jc:configuration/protocols/isis/level/disable",
    "/jc:configuration/protocols/isis/level/name",
    "/jc:configuration/protocols/isis/level/no-csnp-authentication",
    "/jc:configuration/protocols/isis/level/no-hello-authentication",
    "/jc:configuration/protocols/isis/level/no-psnp-authentication",
    "/jc:configuration/protocols/isis/level/wide-metrics-only",
    "/jc:configuration/protocols/isis/lsp-lifetime",
    "/jc:configuration/protocols/ldp/interface/disable",
    "/jc:configuration/protocols/ldp/interface/hello-interval",
    "/jc:configuration/protocols/ldp/interface/hold-time",
    "/jc:configuration/protocols/ldp/interface/name",
    "/jc:configuration/protocols/ldp/interface/transport-address",
    "/jc:configuration/protocols/ldp/preference",
    "/jc:configuration/protocols/ldp/transport-address",
    "/jc:configuration/protocols/mpls/interface/disable",
    "/jc:configuration/protocols/mpls/interface/name",
    "/jc:configuration/protocols/mpls/no-propagate-ttl",
    "/jc:configuration/rcsid",
    "/jc:configuration/routing-options/autonomous-system/as-number",
    "/jc:configuration/system/host-name",
    "/jc:configuration/system/services",
    "/jc:configuration/system/services/netconf/rfc-compliant",
    "/jc:configuration/system/services/netconf/yang-compliant",
    "/jc:configuration/version",
]

    # Keep only the SRL configuration nodes that dorsi's RFS transforms
    # actively write to.
    srl_paths = [
    "/srl_nokia-system:system/name/host-name",
    "/srl_nokia-if:interface/name",
    "/srl_nokia-if:interface/description",
    "/srl_nokia-if:interface/admin-state",
    "/srl_nokia-if:interface/oper-state",
    "/srl_nokia-if:interface/vlan-tagging",
    "/srl_nokia-if:interface/subinterface/index",
    "/srl_nokia-if:interface/subinterface/description",
    "/srl_nokia-if:interface/subinterface/admin-state",
    "/srl_nokia-if:interface/subinterface/ipv4/admin-state",
    "/srl_nokia-if:interface/subinterface/ipv4/address/ip-prefix",
    "/srl_nokia-if:interface/subinterface/ipv6/admin-state",
    "/srl_nokia-if:interface/subinterface/vlan/encap/single-tagged/vlan-id",
    "/srl_nokia-netinst:network-instance/name",
    "/srl_nokia-netinst:network-instance/type",
    "/srl_nokia-netinst:network-instance/admin-state",
    "/srl_nokia-netinst:network-instance/description",
    "/srl_nokia-netinst:network-instance/interface/name",
    "/srl_nokia-netinst:network-instance/protocols/bgp/autonomous-system",
    "/srl_nokia-netinst:network-instance/protocols/bgp/router-id",
    "/srl_nokia-netinst:network-instance/protocols/bgp/afi-safi/afi-safi-name",
    "/srl_nokia-netinst:network-instance/protocols/bgp/afi-safi/admin-state",
    "/srl_nokia-netinst:network-instance/protocols/bgp/group/group-name",
    "/srl_nokia-netinst:network-instance/protocols/bgp/group/peer-as",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/peer-address",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/admin-state",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/description",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/peer-as",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/peer-group",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/authentication/password",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/timers/connect-retry",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/timers/hold-time",
    "/srl_nokia-netinst:network-instance/protocols/bgp/neighbor/timers/keepalive-interval",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/name",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/admin-state",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/level-capability",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/net",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/ipv4-unicast/admin-state",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/interface-name",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/admin-state",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/passive",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/circuit-type",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/level/level-number",
    "/srl_nokia-netinst:network-instance/protocols/isis/instance/interface/level/metric",
]

    # The paths referenced by these leafrefs are invalid - missing module
    # imports. We explicitly allow resolving the target leaf type to fallback to
    # a string so that we can avoid adding more models here ...
    broken_leafrefs = [
        "/network-instance/protocols/isis/instance/export-policy",
        "/network-instance/protocols/isis/instance/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/level/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/authentication/keychain",
        "/network-instance/protocols/isis/instance/level/authentication/keychain",
        "/network-instance/protocols/bgp/authentication/keychain",
        "/network-instance/protocols/bgp/rib-management/table/route-table-import",
        "/network-instance/protocols/bgp/group/authentication/keychain",
        "/network-instance/protocols/bgp/group/send-default-route/export-policy",
        "/network-instance/protocols/bgp/neighbor/authentication/keychain",
        "/network-instance/protocols/bgp/neighbor/send-default-route/export-policy",
    ]

    try:
        cfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/cfs")
        cfs_layer.models.extend([
            swyang.stratoweave,
            swyang.ietf_inet_types,
            tmf_yang.ietf_yang_tmf_map,
            tmf_yang.swtmf.replace("TMF640_STORE_TRANSFORM", "dorsi.tmf.Tmf640Store"),
            tmf_yang.swtmf640
        ])
        rfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/rfs")
        rfs_layer.models.extend([swyang.stratoweave, swyang.rfs, swyang.ssh, swyang.ietf_inet_types, swyang.ietf_yang_types])

        spec = stratoweave.build.SysSpec("dorsi", [
            cfs_layer,
            rfs_layer,
        ], [
            stratoweave.build.DeviceType.from_dir(fc, "CiscoIosXr_25_3_1", "yang/CiscoIosXr_25_3_1",
                transforms=[
                    swds.filter_schema(xr_paths),
                ]),
            stratoweave.build.DeviceType.from_dir(fc, "JuniperCRPD_24_4R1_9", "yang/JuniperCRPD_24_4R1_9",
                transforms=[
                    swds.filter_schema(crpd_paths),
                    swds.remove_list_user_order(crpd_order_paths),
                ]),
            stratoweave.build.DeviceType.from_dir(fc, "NokiaSRLinux_25_3_2", "yang/NokiaSRLinux_25_3_2",
                transforms=[
                    swds.filter_schema(srl_paths),
                ]),
        ])
        compiled_spec = spec.compile(broken_leafrefs)
        compiled_spec.gen_app(fc, "../src/")
    except Exception as exc:
        print(exc, err=True)
        env.exit(1)
    else:
        env.exit(0)
