    # Keep only the EOS OpenConfig nodes that dorsi's RFS transforms actively
    # write to or poll. EOS has no use-multiple-paths/config, so ECMP is set
    # through use-multiple-paths/ebgp only; policy-definitions become RCF
    # functions on the device. BGP advertises only routes in BGP, so the
    # loopback gets there through a table-connection (redistribute connected).
    eos_paths = [
    "/oc-sys:system/config/hostname",
    "/oc-lldp:lldp/config/enabled",
    "/oc-lldp:lldp/interfaces/interface/name",
    "/oc-lldp:lldp/interfaces/interface/config/name",
    "/oc-lldp:lldp/interfaces/interface/config/enabled",
