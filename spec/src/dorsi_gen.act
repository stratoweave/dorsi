    "/oc-lldp:lldp/interfaces/interface/neighbors/neighbor/state/port-id",
    "/oc-if:interfaces/interface/name",
    "/oc-if:interfaces/interface/config/name",
    "/oc-if:interfaces/interface/config/type",
    "/oc-if:interfaces/interface/config/description",
    "/oc-if:interfaces/interface/config/enabled",
    "/oc-if:interfaces/interface/state/oper-status",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/index",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/config/index",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/config/description",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/config/enabled",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv4/config/enabled",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv4/addresses/address/ip",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv4/addresses/address/config/ip",
    "/oc-if:interfaces/interface/subinterfaces/subinterface/ipv4/addresses/address/config/prefix-length",
    "/oc-netinst:network-instances/network-instance/name",
    "/oc-netinst:network-instances/network-instance/config/name",
    "/oc-netinst:network-instances/network-instance/config/type",
    "/oc-netinst:network-instances/network-instance/config/ipv4-routing-enabled",
    # Management0 sits in a management VRF, an L3VRF network instance
    "/oc-netinst:network-instances/network-instance/interfaces/interface/id",
    "/oc-netinst:network-instances/network-instance/interfaces/interface/config/id",
    "/oc-netinst:network-instances/network-instance/interfaces/interface/config/interface",
    "/oc-netinst:network-instances/network-instance/interfaces/interface/config/subinterface",
    # and the default route of that VRF, to the management gateway
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/prefix",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/config/prefix",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/next-hops/next-hop/index",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/next-hops/next-hop/config/index",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/static-routes/static/next-hops/next-hop/config/next-hop",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/src-protocol",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/dst-protocol",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/address-family",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/config/src-protocol",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/config/dst-protocol",
    "/oc-netinst:network-instances/network-instance/table-connections/table-connection/config/address-family",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/identifier",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/config/identifier",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/config/name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/config/as",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/config/router-id",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/afi-safis/afi-safi/afi-safi-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/afi-safis/afi-safi/config/afi-safi-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/afi-safis/afi-safi/config/enabled",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/global/afi-safis/afi-safi/use-multiple-paths/ebgp/config/maximum-paths",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/peer-group-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/config/peer-group-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/apply-policy/config/import-policy",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/apply-policy/config/export-policy",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/afi-safis/afi-safi/afi-safi-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/afi-safis/afi-safi/config/afi-safi-name",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/peer-groups/peer-group/afi-safis/afi-safi/config/enabled",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/neighbor-address",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/config/neighbor-address",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/config/peer-group",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/config/peer-as",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/config/enabled",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/config/description",
    "/oc-netinst:network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state/session-state",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/name",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/config/name",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/config/mode",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/ip-prefix",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/masklength-range",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/config/ip-prefix",
    "/oc-rpol:routing-policy/defined-sets/prefix-sets/prefix-set/prefixes/prefix/config/masklength-range",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/config/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/config/name",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/conditions/match-prefix-set/config/prefix-set",
    "/oc-rpol:routing-policy/policy-definitions/policy-definition/statements/statement/actions/config/policy-result",
]

    # The paths referenced by these leafrefs are invalid - missing module
    # imports. We explicitly allow resolving the target leaf type to fallback to
    # a string so that we can avoid adding more models here ...
    broken_leafrefs = [
        "/network-instance/protocols/isis/instance/export-policy",
        "/network-instance/protocols/isis/instance/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/level/authentication/keychain",
        "/network-instance/protocols/isis/instance/interface/authentication/keychain",
        "/network-instance/protocols/isis/instance/level/authentication/keychain",
        "/network-instance/protocols/bgp/authentication/keychain",
        "/network-instance/protocols/bgp/rib-management/table/route-table-import",
        "/network-instance/protocols/bgp/group/authentication/keychain",
        "/network-instance/protocols/bgp/group/send-default-route/export-policy",
        "/network-instance/protocols/bgp/neighbor/authentication/keychain",
        "/network-instance/protocols/bgp/neighbor/send-default-route/export-policy",
    ]

    try:
        cfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/cfs")
        cfs_layer.models.extend([
            swyang.stratoweave,
            swyang.ietf_inet_types,
            tmf_yang.ietf_yang_tmf_map,
            tmf_yang.swtmf.replace("TMF640_STORE_TRANSFORM", "dorsi.tmf.Tmf640Store"),
            tmf_yang.swtmf640
        ])
        rfs_layer = stratoweave.build.Layer.from_dir(fc, "yang/rfs")
        rfs_layer.models.extend([swyang.stratoweave, swyang.rfs, swyang.ssh, swyang.ietf_inet_types, swyang.ietf_yang_types])

        spec = stratoweave.build.SysSpec("dorsi", [
            cfs_layer,
            rfs_layer,
        ], [
            stratoweave.build.DeviceType.from_dir(fc, "AristaEOS_4_36_3_2M", "yang/AristaEOS_4_36_3_2M",
                transforms=[
                    swds.filter_schema(eos_paths),
                ]),
            stratoweave.build.DeviceType.from_dir(fc, "CiscoIosXr_25_3_1", "yang/CiscoIosXr_25_3_1",
                transforms=[
                    swds.filter_schema(xr_paths),
                ]),
            stratoweave.build.DeviceType.from_dir(fc, "JuniperCRPD_24_4R1_9", "yang/JuniperCRPD_24_4R1_9",
                transforms=[
                    swds.filter_schema(crpd_paths),
                    swds.remove_list_user_order(crpd_order_paths),
                ]),
            stratoweave.build.DeviceType.from_dir(fc, "NokiaSRLinux_25_3_2", "yang/NokiaSRLinux_25_3_2",
                transforms=[
                    swds.filter_schema(srl_paths),
                ]),
        ])
        compiled_spec = spec.compile(broken_leafrefs)
        compiled_spec.gen_app(fc, "../src/")
    except Exception as exc:
        print(exc, err=True)
        env.exit(1)
    else:
        env.exit(0)
