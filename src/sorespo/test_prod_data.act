import testing

import sorespo.sysspec as sysspec
import sorespo.layers.y_0 as cfs_layer
import stratoweave.test_rig as swts


actor _test_complete_prod_data(t: testing.AsyncT):
    # Test input config
    gs = cfs_layer.netinfra__netinfra__global_settings('ibgp-authentication-key')
    root = cfs_layer.root(cfs_layer.netinfra__netinfra(gs))

    ###################################
    # Core routers
    ###################################
    ams = root.netinfra.router.create('AMS-CORE-1', 1, 'CiscoIosXr_25_3_1', 65001)
    ams.role = 'edge'
    ams.mock = True

    fra = root.netinfra.router.create('FRA-CORE-1', 2, 'CiscoIosXr_25_3_1', 65001)
    fra.role = 'edge'
    fra.mock = True

    sto = root.netinfra.router.create('STO-CORE-1', 3, 'JuniperCRPD_24_4R1_9', 65001)
    sto.role = 'edge'
    sto.mock = True

    lju = root.netinfra.router.create('LJU-CORE-1', 4, 'JuniperCRPD_24_4R1_9', 65001)
    lju.role = 'edge'
    lju.mock = True

    ###################################
    # Backbone links
    ###################################

    root.netinfra.backbone_link.create(('FRA-CORE-1', 'GigabitEthernet0/0/0/1', 'STO-CORE-1', 'eth2'))
    root.netinfra.backbone_link.create(('AMS-CORE-1', 'GigabitEthernet0/0/0/0', 'FRA-CORE-1', 'GigabitEthernet0/0/0/0'))
    root.netinfra.backbone_link.create(('AMS-CORE-1', 'GigabitEthernet0/0/0/1', 'STO-CORE-1', 'eth1'))
    root.netinfra.backbone_link.create(('STO-CORE-1', 'eth3', 'LJU-CORE-1', 'eth2'))
    root.netinfra.backbone_link.create(('FRA-CORE-1', 'GigabitEthernet0/0/0/2', 'LJU-CORE-1', 'eth1'))


    swts.TransformTester(t, sysspec.SYSSPEC, root.to_gdata())

