import yang.gdata as gdata

import sorespo.layers.y_0_loose as cfs_layer
from sorespo.layers.y_0_loose import netinfra__netinfra
from sorespo.layers.y_2_loose import stratoweave_rfs__rfs__backbone_interface
import sorespo.discovery.rfs_discovery as rfsd


class BackboneEndpointKey(object):
    router: str
    interface: str

    def __init__(self, router: str, interface: str) -> None:
        self.router = router
        self.interface = interface

    def is_less(self, other: BackboneEndpointKey) -> bool:
        if self.router != other.router:
            return self.router < other.router
        return self.interface < other.interface


extension BackboneEndpointKey(Hashable):
    def __eq__(self, other: BackboneEndpointKey) -> bool:
        return self.router == other.router and self.interface == other.interface

    def hash(self, hasher) -> None:
        self.router.hash(hasher)
        self.interface.hash(hasher)


class BackboneLinkKey(object):
    left: BackboneEndpointKey
    right: BackboneEndpointKey

    def __init__(self, left: BackboneEndpointKey, right: BackboneEndpointKey) -> None:
        self.left = left
        self.right = right

    def is_less(self, other: BackboneLinkKey) -> bool:
        if self.left != other.left:
            return self.left.is_less(other.left)
        return self.right.is_less(other.right)


extension BackboneLinkKey(Hashable):
    def __eq__(self, other: BackboneLinkKey) -> bool:
        return self.left == other.left and self.right == other.right

    def hash(self, hasher) -> None:
        self.left.hash(hasher)
        self.right.hash(hasher)


def _is_left_side(ipv4_address: ?str) -> ?bool:
    """Backbone link endpoints use .1 for left and .2 for right."""
    if ipv4_address is None:
        return None
    parts = ipv4_address!.split(".")
    if len(parts) != 4:
        return None
    if parts[3] == "1":
        return True
    if parts[3] == "2":
        return False
    return None


def _aggregate_backbone_links(per_device: dict[str, stratoweave_rfs__rfs__backbone_interface], netinfra: netinfra__netinfra) -> None:
    pairs: set[BackboneLinkKey] = set()
    for local in sorted([n for n in per_device.keys()]):
        for bbi in per_device[local]:
            remote_device = bbi.remote.device
            remote_interface = bbi.remote.interface
            if remote_device is None or remote_interface is None:
                continue
            if per_device.get(remote_device!) is None:
                continue
            local_is_left = _is_left_side(bbi.ipv4_address)
            if local_is_left == True:
                left_r, left_i, right_r, right_i = local, bbi.name, remote_device!, remote_interface!
            elif local_is_left == False:
                left_r, left_i, right_r, right_i = remote_device!, remote_interface!, local, bbi.name
            else:
                local_endpoint = BackboneEndpointKey(local, bbi.name)
                remote_endpoint = BackboneEndpointKey(remote_device!, remote_interface!)
                if local_endpoint.is_less(remote_endpoint):
                    left_r, left_i, right_r, right_i = local, bbi.name, remote_device!, remote_interface!
                else:
                    left_r, left_i, right_r, right_i = remote_device!, remote_interface!, local, bbi.name
            pairs.add(BackboneLinkKey(BackboneEndpointKey(left_r, left_i), BackboneEndpointKey(right_r, right_i)))
    ordered_pairs: list[BackboneLinkKey] = []
    for pair in pairs:
        inserted = False
        for i in range(len(ordered_pairs)):
            if pair.is_less(ordered_pairs[i]):
                ordered_pairs.insert(i, pair)
                inserted = True
                break
        if not inserted:
            ordered_pairs.append(pair)
    for pair in ordered_pairs:
        netinfra.backbone_link.create((pair.left.router, pair.left.interface, pair.right.router, pair.right.interface))


def _set_or_assert_ibgp_authentication_key(existing: ?str, discovered: ?str) -> ?str:
    if discovered is None:
        return existing
    if existing is None:
        return discovered!
    if existing! != discovered!:
        raise ValueError("Discovered iBGP authentication key mismatch across devices")
    return existing


def discover(devices: dict[str, gdata.Node], authentication_key_hints: list[str]) -> gdata.Node:
    cfs_root = cfs_layer.root()
    rfs_root = rfsd.discover_rfs_root(devices, authentication_key_hints)
    bb_interfaces_by_device: dict[str, stratoweave_rfs__rfs__backbone_interface] = {}
    ibgp_authentication_key: ?str = None

    for rfs_entry in rfs_root.rfs:
        name = rfs_entry.name
        base_config = rfs_entry.base_config
        ibgp_authentication_key = _set_or_assert_ibgp_authentication_key(
            ibgp_authentication_key, base_config.ibgp_authentication_key)
        router_id = rfsd.router_id_from_ipv4(base_config.ipv4_address)
        if router_id is None or base_config.asn is None:
            continue

        device_type: ?str = None
        rfs_device = rfs_root.device.get(name)
        if rfs_device is not None:
            device_type = rfs_device!.type

        cfs_root.netinfra.router.create(
            name,
            id=router_id!,
            type=device_type,
            role=base_config.role,
            asn=base_config.asn!,
            mock=True,
        )

        bb_interfaces_by_device[name] = rfs_entry.backbone_interface

    _aggregate_backbone_links(bb_interfaces_by_device, cfs_root.netinfra)
    if ibgp_authentication_key is None:
        raise ValueError("No iBGP authentication key discovered from recognized devices")
    cfs_root.netinfra.global_settings = cfs_layer.netinfra__netinfra__global_settings(
        ibgp_authentication_key=ibgp_authentication_key!
    )
    return cfs_root.to_gdata()
