import testing

import dorsi.cfs as cfs

def _test_end_cabling_matches():
    testing.assertEqual(cfs.end_cabling_status("up", "spine1", "ethernet-1/1", "spine1", "ethernet-1/1"), "ok")

def _test_end_cabling_fully_qualified_name():
    testing.assertEqual(cfs.end_cabling_status("up", "spine1.dc1.example", "ethernet-1/1", "spine1", "ethernet-1/1"), "ok")

def _test_end_cabling_other_switch():
    testing.assertEqual(cfs.end_cabling_status("up", "spine2", "ethernet-1/1", "spine1", "ethernet-1/1"), "mismatch")

def _test_end_cabling_other_port():
    testing.assertEqual(cfs.end_cabling_status("up", "spine1", "ethernet-1/2", "spine1", "ethernet-1/1"), "mismatch")

def _test_end_cabling_name_prefix_is_another_switch():
    testing.assertEqual(cfs.end_cabling_status("up", "spine10", "ethernet-1/1", "spine1", "ethernet-1/1"), "mismatch")

def _test_end_cabling_no_neighbor():
    testing.assertEqual(cfs.end_cabling_status("up", None, None, "spine1", "ethernet-1/1"), "no-neighbor")

def _test_end_cabling_not_up():
    testing.assertEqual(cfs.end_cabling_status("down", None, None, "spine1", "ethernet-1/1"), None)
    testing.assertEqual(cfs.end_cabling_status(None, "spine1", "ethernet-1/1", "spine1", "ethernet-1/1"), None)

def _test_combine_cabling():
    testing.assertEqual(cfs.combine_cabling_status("ok", "ok"), "ok")
    testing.assertEqual(cfs.combine_cabling_status("ok", "mismatch"), "mismatch")
    testing.assertEqual(cfs.combine_cabling_status("mismatch", None), "mismatch")
    testing.assertEqual(cfs.combine_cabling_status("ok", "no-neighbor"), "ok")
    testing.assertEqual(cfs.combine_cabling_status("ok", None), "ok")
    testing.assertEqual(cfs.combine_cabling_status("no-neighbor", "no-neighbor"), "no-neighbor")
    testing.assertEqual(cfs.combine_cabling_status(None, None), None)

def _test_combine_link_status():
    testing.assertEqual(cfs.combine_link_status("up", "up"), "up")
    testing.assertEqual(cfs.combine_link_status("up", "down"), "down")
    testing.assertEqual(cfs.combine_link_status("up", None), "unknown")
    testing.assertEqual(cfs.combine_link_status(None, None), None)

def _test_server_cabling_matches():
    testing.assertEqual(cfs.server_cabling_status("up", "server1", "eth1", "server1", "eth1"), "ok")

def _test_server_cabling_mac_port_id():
    testing.assertEqual(cfs.server_cabling_status("up", "server1", "aa:c1:ab:76:ef:bc", "server1", "eth1"), "ok")

def _test_server_cabling_other_server():
    testing.assertEqual(cfs.server_cabling_status("up", "server2", "eth1", "server1", "eth1"), "mismatch")

def _test_server_cabling_other_port():
    testing.assertEqual(cfs.server_cabling_status("up", "server1", "eth2", "server1", "eth1"), "mismatch")

def _test_server_cabling_no_lldp():
    testing.assertEqual(cfs.server_cabling_status("up", None, None, "server1", "eth1"), None)
    testing.assertEqual(cfs.server_cabling_status("down", "server2", "eth1", "server1", "eth1"), None)

def _test_down_since():
    testing.assertEqual(cfs.down_since("down", None, 100), 100)
    testing.assertEqual(cfs.down_since("down", 40, 100), 40)
    testing.assertEqual(cfs.down_since("up", 40, 100), None)

def _test_down_since_unread_keeps_time():
    testing.assertEqual(cfs.down_since(None, 40, 100), 40)
    testing.assertEqual(cfs.down_since("unknown", 40, 100), 40)
    testing.assertEqual(cfs.down_since(None, None, 100), None)
