	}
	identity "NODE_INFORMATION_QUERY_CODE" {
		base "CODE";
		description "Subcodes for the node information query ICMPv6 type.";
	}
	identity "NODE_INFORMATION_QUERY_IPV6_ADDR" {
		base "NODE_INFORMATION_QUERY_CODE";
		description "The data field contains an IPv6 address which is the subject of the
		             query.";
		reference "RFC4620: IPv6 Node Information Queries";
	}
	identity "NODE_INFORMATION_QUERY_NAME" {
		base "NODE_INFORMATION_QUERY_CODE";
		description "The data field contains a name which is the subject of the
