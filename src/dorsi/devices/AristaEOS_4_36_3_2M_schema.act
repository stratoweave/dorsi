	typedef "arista-as-path-prepend-asn-type" {
		type "union" {
			type "oc-inet:as-number";
			type "enumeration" {
				enum "INBOUND_ASN" {
					description "Use BGP peer's AS";
				}
				enum "OUTBOUND_ASN" {
					description "Use local AS";
				}
			}
			type "string" {
				pattern "((IN|OUT)BOUND_ASN|[1-9][0-9]*)( ((IN|OUT)BOUND_ASN|[1-9][0-9]*))+";
			}
		}
		description "AS number type, can be set to a string containing multiple AS numbers.";
	}
	deviation "/oc-rpol:routing-policy/oc-rpol:policy-definitions/oc-rpol:policy-definition/oc-rpol:statements/oc-rpol:statement/oc-rpol:actions/oc-bgp-pol:bgp-actions/oc-bgp-pol:set-as-path-prepend/oc-bgp-pol:config/oc-bgp-pol:asn" {
		description "EOS allows multiple AS numbers in as-path prepend.";
		deviate "replace" {
			type "arista-as-path-prepend-asn-type";
		}
	}
	deviation "/oc-rpol:routing-policy/oc-rpol:policy-definitions/oc-rpol:policy-definition/oc-rpol:statements/oc-rpol:statement/oc-rpol:actions/oc-bgp-pol:bgp-actions/oc-bgp-pol:set-as-path-prepend/oc-bgp-pol:state/oc-bgp-pol:asn" {
		description "EOS allows multiple AS numbers in as-path prepend.";
		deviate "replace" {
			type "arista-as-path-prepend-asn-type";
		}
	}
	typedef "arista-bgp-set-med-type" {
		type "union" {
			type "uint32";
			type "enumeration" {
				enum "IGP" {
					description "set the MED value to the IGP cost toward the
					             next hop for the route, only applies for BGP learned routes";
				}
				enum "METRIC" {
					description "set the MED value to the IGP metric of a redistributed route";
				}
			}
		}
		description "Type definition for specifying how the BGP MED can be set in BGP
		             policy actions.  The MED can be specified as a direct integer
		             value or setting it to the IGP or METRIC cost.  To be used in conjunction
		             with `bgp-set-med-action` in order to specify the appropriate
		             action to take on this value.";
	}
	typedef "arista-bgp-set-med-action" {
		type "enumeration" {
			enum "SET" {
				description "Action to set the MED to a specific value.";
			}
			enum "ADD" {
				description "Action to increment the previous MED value.";
			}
			enum "SUBTRACT" {
				description "Action to decrement the previous MED value.";
			}
			enum "SET_AND_ADD_IGP" {
				description "Action to set the MED to a specific value and add IGP";
			}
			enum "SET_AND_ADD_METRIC" {
				description "Action to set the MED to a specific value and add METRIC";
			}
		}
		description "Specifies which action to take on the value specified by the
		             bgp-set-med-type.";
	}
	typedef "route-target-community-type" {
		type "union" {
			type "string" {
				pattern "route\\-target:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9]):(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9])";
			}
			type "string" {
				pattern "route\\-target:(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9])";
			}
			type "string" {
				pattern "route\\-target:(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9]):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9])";
			}
		}
		description "route-target community:
		              - route-target:<2b AS>:<4b value> per RFC4360 section 4
		              - route-target:<4b IPv4>:<2b value> per RFC4360 section 4
		              - route-target:<4b AS>:<2b value> per RFC5668 section 4";
	}
	typedef "route-origin-community-type" {
		type "union" {
			type "string" {
				pattern "route\\-origin:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9]):(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9])";
			}
			type "string" {
				pattern "route\\-origin:(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9])";
			}
			type "string" {
				pattern "route\\-origin:(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9]):(6553[0-5]|655[0-2][0-9]|654[0-9]{2}|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9])";
			}
		}
		description "route-origin community:
		              - route-origin:<2b ASN>:<4b value> per RFC4360 section 5
		              - route-origin:<4b IPv4>:<2b value> per RFC4360 section 5
		              - route-origin:<4b AS>:<2b value> per RFC5668 section 4";
	}
	typedef "link-bandwidth-community-type" {
		type "string" {
			pattern "link\\-bandwidth:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9]):(([0-9]|[1-9][0-9]{1,28})(\\.[0-9]+)?[KMG]?)";
			oc-ext:posix-pattern "^link\\-bandwidth:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{1,3}|[0-9]):(([0-9]|[1-9][0-9]{1,28})(\\.[0-9]+)?[KMG]?)$";
		}
		description "link-bandwidth community:
		             - link-bandwidth:<2b AS>:<bandwidth value in bits/sec specified as a floating point number, optionally with Kilo/Mega/Giga suffix> per RFC4360 section 3.1";
	}
	typedef "evpn-es-import-route-target-type" {
		type "string" {
			pattern "evpn\\-es\\-import\\-route\\-target:([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f])";
			oc-ext:posix-pattern "^evpn\\-es\\-import\\-route\\-target:([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f]):([0-9]|[a-f])([0-9]|[a-f])$";
		}
		description "evpn-es-import-route-target community:
		             - evpn-es-import-route-target:<1b hex>:<1b hex>:<1b hex>:<1b hex>:<1b hex>:<1b hex> per RFC 7432 section 7.6";
	}
	typedef "color-community-type" {
		type "string" {
			pattern "color:[0-1]{2}:(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9])";
			oc-ext:posix-pattern "^color:[0-1]{2}:(429496729[0-5]|42949672[0-8][0-9]|4294967[0-1][0-9]{2}|429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|4294[0-8][0-9]{5}|429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[0-1][0-9]{8}|[1-3][0-9]{9}|[1-9][0-9]{1,8}|[0-9])$";
		}
		description "color community:
		             - color:<CO bits>:<4b value> per draft-ietf-idr-segment-routing-te-policysection 3";
	}
	typedef "arista-bgp-ext-community-type" {
		type "union" {
			type "route-target-community-type";
			type "route-origin-community-type";
			type "link-bandwidth-community-type";
			type "evpn-es-import-route-target-type";
			type "color-community-type";
		}
		description "EOS supports a subset of the oc-bgp-types:bgp-ext-community-type:
		              - route-target:<2b AS>:<4b value> per RFC4360 section 4
		              - route-target:<4b IPv4>:<2b value> per RFC4360 section 4
		              - route-target:<4b AS>:<2b value> per RFC5668 section 4
		              - route-origin:<2b ASN>:<4b value> per RFC4360 section 5
		              - route-origin:<4b IPv4>:<2b value> per RFC4360 section 5
		              - route-origin:<4b AS>:<2b value> per RFC5668 section 4
		             as well as the link bandwidth extended community
		              - evpn-es-import-route-target:<1b hex>:<1b hex>:<1b hex>:<1b hex>:<1b hex>:<1b hex> per RFC 7432 section 7.6
		              - link-bandwidth:<2b AS>:<4b value> per RFC4360 section 3.1";
	}
	typedef "arista-isis-set-level" {
		type "union" {
			type "isis-types:level-number";
			type "isis-types:level-type";
		}
		description "Type definition for specifying how the isis level can be set.
		             For compatibility reasons, level-number will be used to suport level1 and level2 values,
		             while level-type is used to support LEVEL_1_2 value.";
	}
	deviation "/oc-rpol:routing-policy/oc-rpol:defined-sets/oc-bgp-pol:bgp-defined-sets/oc-bgp-pol:community-sets/oc-bgp-pol:community-set/oc-bgp-pol:config/oc-bgp-pol:community-set-name" {
