		reference "RFC8883: ICMPv6 Errors for Discarding Packets Due to Processing Limits";
	}
	identity "PARAM_PROBLEM_TOO_MANY_OPTS" {
		base "PARAM_PROBLEM_CODE";
		description "Too many options in extension header.";
