                DContainer(module='junos-conf-interfaces', namespace='http://yang.juniper.net/junos/conf/interfaces', prefix='jc-interfaces', name='inet', config=True, description='IPv4 parameters', presence=True, adata_name='inet', children=[
                    DList(module='junos-conf-interfaces', namespace='http://yang.juniper.net/junos/conf/interfaces', prefix='jc-interfaces', name='address', key=['name'], config=True, description='Interface address/destination prefix', min_elements=0, ordered_by='user', adata_name='address', children=[
