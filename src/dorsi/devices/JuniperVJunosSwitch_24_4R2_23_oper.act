            DLeaf(module='junos-conf-interfaces', namespace='http://yang.juniper.net/junos/conf/interfaces', prefix='jc-interfaces', name='vlan-id', config=True, description='Virtual LAN identifier value for 802.1q VLAN tags', is_key=False, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]), adata_name='vlan_id'),
