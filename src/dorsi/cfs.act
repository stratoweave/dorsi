import yang.adata
import yang.gdata as gdata
import stratoweave.ttt as ttt

import dorsi.layers.base_0 as base
import dorsi.layers.y_0 as y_0
import dorsi.layers.y_0_oper as y_0_oper
import dorsi.layers.y_1_oper as y_1_oper
# TODO: this import is required by the compiler, maybe related to
# https://github.com/actonlang/acton/issues/2390
import yang.identityref


def letter_position(letter):
    """
    Returns the position of the given letter in the English alphabet (1-26).
    """
    if len(letter) != 1 or not letter.isalpha():
        raise ValueError("Input must be a single alphabetic character.")
    letter = letter.lower()
    return ord(letter) - ord('a') + 1


class GlobalSettings(base.GlobalSettings):
    def transform(self, i):
        print("CFS global-settings transform running", err=True)
        return base.o_root()


class IbgpFullmesh(base.IbgpFullmesh):
    def transform(self, i, linked):
        print("CFS ibgp-fullmesh transform running {i.asn}", err=True)
        o = base.o_root()

        # Authentication key from the network-wide global-settings and the
        # router ids from the member routers, both provided via sw:link.
        root = y_0.root.from_gdata(linked)
        key = root.netinfra.global_settings.ibgp_authentication_key
        ids = {}
        for r in root.netinfra.router:
            ids[r.name] = r.id

        for ra in i.router:
            rfs = o.rfs.create(ra)
            rfs.base_config.ibgp_authentication_key = key
            for rb in i.router:
                if ra == rb:
                    continue
                rfs.ibgp_neighbor.create("10.0.0.{ids[rb]}", asn=i.asn, description=rb, ibgp_authentication_key=key)

        return o


class Router(base.Router):
    def transform(self, i):
        o = base.o_root()
        print("CFS router transform running", i.name, i.id)
        dev = o.device.create(i.name, type=i.type, approval_required=i.approval_required)
        dev.address.create("oob", address=i.name)
        dev.credentials.username = "clab"
        dev.credentials.password = "clab@123"
        dev.mock.enabled = i.mock
        dev.feature_flags.runtime_schema_fetch = i.feature_flags.runtime_schema_fetch

        # Assign the loopback interface addresses
        rfs = o.rfs.create(i.name)
        rfs.base_config.role = i.role
        rfs.base_config.ipv4_address = "10.0.0.{i.id}"
        rfs.base_config.ipv6_address = "2001:db8:0:0::{i.id}"
        rfs.base_config.asn = i.asn

        return o


class BBLink(base.BBLink):
    def transform(self, i):
        print("CFS backbonelink transform running %s [%s] <-> %s [%s]" % (i.left_router, i.left_interface, i.right_router, i.right_interface))
        o = base.o_root()
        link_id = letter_position(i.left_router[0]) + letter_position(i.right_router[0])
        left_rfs = o.rfs.create(i.left_router)
        li = left_rfs.backbone_interface.create(i.left_interface, ipv4_address="10.0.{link_id}.1")
        li.remote.device = i.right_router
        li.remote.interface = i.right_interface

        right_rfs = o.rfs.create(i.right_router)
        ri = right_rfs.backbone_interface.create(i.right_interface, ipv4_address="10.0.{link_id}.2")
        ri.remote.device = i.left_router
        ri.remote.interface = i.left_interface

        return o


def combine_link_status(left: ?str, right: ?str) -> ?str:
    if left == "up" and right == "up":
        return "up"
    if left == "down" or right == "down":
        return "down"
    if left is None and right is None:
        return None
    return "unknown"


# --- Backbone link oper-status lift -------------------------------------------
# Combine the two endpoints' RFS backbone-interface oper-status into the
# backbone-link link-status (up only when both ends are up; see
# combine_link_status). Served at data/netinfra:netinfra/backbone-link
actor BBLinkTransform(path: ttt.Path,
                      update_oper: proc(?y_0_oper.netinfra__netinfra__backbone_link_entry)->None,
                      lower_tree_provider: ?gdata.TreeProvider):
    _oper = base.BBLink.new_state(path)
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))

    def on_rfs_state(root: ?y_1_oper.root, err: ?Exception, left_router: str, left_interface: str, right_router: str, right_interface: str):
        if err is not None:
            print("cfs.BBLinkTransform RFS subscription error: {err}", err=True)
            return
        left_status: ?str = None
        right_status: ?str = None
        if root is not None:
            for r in root.rfs:
                if r.name == left_router:
                    for bi in r.backbone_interface:
                        if bi.name == left_interface:
                            left_status = bi.state.oper_status
                if r.name == right_router:
                    for bi in r.backbone_interface:
                        if bi.name == right_interface:
                            right_status = bi.state.oper_status
        _oper.state.link_status = combine_link_status(left_status, right_status)
        update_oper(_oper)

    def on_conf(conf: y_0.netinfra__netinfra__backbone_link_entry):
        lr = conf.left_router
        li = conf.left_interface
        rr = conf.right_router
        ri = conf.right_interface
        dst = y_1_oper.dst(lambda r, e: on_rfs_state(r, e, lr, li, rr, ri))
        want: set[gdata.Delivery] = set()
        want.add(dst.deliver({
            y_1_oper.subs.rfs.entry(lr).backbone_interface.entry(li).state.subscribe(period=5.0),
            y_1_oper.subs.rfs.entry(rr).backbone_interface.entry(ri).state.subscribe(period=5.0)
        }))
        _subs.declare(want)

    def shutdown():
        pass
