# --- IP fabric ----------------------------------------------------------------
# Addressing and AS numbers are derived from the switch id so that the
# switch and fabric-link transforms agree without sharing state:
#   loopback        10.0.<id / 256>.<id % 256>/32
#   point-to-point  10.100.0.0/16, one /31 per lower (switch, port) pair
#   AS number       leaf: one per switch; spine: one per pod and plane;
#                   super-spine: one per plane (RFC 7938 section 5.2.1)

def _trailing_int(s: str, default: int) -> int:
    """The number at the end of a name, such as 3 for 'pod-3' or
    'ethernet-1/3'."""
    n = len(s)
    j = n
    while j > 0 and s[j-1] in "0123456789":
        j -= 1
    if j == n:
        return default
    return int(s[j:])


def fabric_loopback(switch_id: int) -> str:
    return "10.0.{switch_id // 256}.{switch_id % 256}"


def fabric_asn(role: str, switch_id: int, pod: str, plane: str) -> int:
    if role == "leaf":
        return 4200000000 + switch_id
    if role == "spine":
        return 4200100000 + _trailing_int(pod, 1) * 100 + _trailing_int(plane, 1)
    return 4200200000 + _trailing_int(plane, 1)


def fabric_link_addresses(lower_id: int, lower_port: str) -> (str, str):
    offset = (lower_id * 64 + _trailing_int(lower_port, 0)) * 2
    third = offset // 256
    fourth = offset % 256
    return ("10.100.{third}.{fourth}", "10.100.{third}.{fourth + 1}")


# --- Overlay identifiers ------------------------------------------------------
# Placeholder allocation. StratoWeave has no allocator yet, so every identifier
# of the EVPN-VXLAN overlay is derived from names with a stable hash: the same
# input gives the same number on every run, and adding a network leaves the
# identifiers of the others as they are. Derived numbers can clash; the fabric
# is then rejected (see validate_fabric) and a network can be given its own
# VNI. Replace these functions with the allocator once it exists.
#   L2 VNI          10000 + fnv1a32(fabric/tenant/network) % 990000
#   L3 VNI          1000000 + fnv1a32(fabric/tenant/vrf) % 900000, apart
#                   from the L2 VNIs
#   EVI             VNI % 65535 + 1, also the vxlan-interface index
#   IRB             irb0.<EVI of the network % 9999 + 1>
#   route target    target:<fnv1a32(fabric) % 65535 + 1>:<VNI>, shared
#   route dist.     <leaf loopback>:<EVI>, unique per leaf and network
#   ESI             type 0, 00:<8 hash bytes of fabric/server>:01
#   LACP system ID  02:<5 hash bytes of lacp/fabric/server>
#   LACP admin key  fnv1a32(fabric/server) % 65535 + 1
#   LAG             lag<lowest port number of the server on the leaf>, on
#                   Arista EOS Port-Channel<the same>
#   internal VLAN   200 + fnv1a32(vlan/<VNI>) % 800, on switches that bridge
#                   in VLANs (EOS, cRPD), below the VLANs EOS keeps for
#                   routed ports from 1006 up. Unique per switch, as is the
#                   IRB: only 800 values, a clash anywhere in the fabric
#                   would be likely with a few dozen networks

def _fnv1a(s: str) -> int:
    """32-bit FNV-1a hash of the UTF-8 bytes of s."""
    h = 0x811c9dc5
    for b in s.encode():
        h = ((h ^ int(b)) * 0x01000193) & 0xffffffff
    return h


def _hash_bytes(s: str, count: int) -> list[str]:
    """count bytes, at most 8, derived from s, as two hex digits each: the
    hashes of s and of s with a suffix, one after the other."""
    digits = "0123456789abcdef"
    words = [_fnv1a(s), _fnv1a(s + "#")]
    res: list[str] = []
    for i in range(count):
        b = (words[i // 4] >> (24 - 8 * (i % 4))) & 0xff
        res.append(digits[b >> 4] + digits[b & 0xf])
    return res


def overlay_vni(fabric: str, tenant: str, network: str) -> int:
    return 10000 + _fnv1a("{fabric}/{tenant}/{network}") % 990000


def overlay_l3_vni(fabric: str, tenant: str, vrf: str) -> int:
    return 1000000 + _fnv1a("{fabric}/{tenant}/{vrf}") % 900000


def overlay_evi(vni: int) -> int:
    return vni % 65535 + 1


def overlay_route_target(fabric: str, vni: int) -> str:
    return "target:{_fnv1a(fabric) % 65535 + 1}:{vni}"


def overlay_route_distinguisher(switch_id: int, evi: int) -> str:
    return "{fabric_loopback(switch_id)}:{evi}"


def server_esi(fabric: str, server: str) -> str:
    return ":".join(["00"] + _hash_bytes("{fabric}/{server}", 8) + ["01"])


def server_lacp_system_id(fabric: str, server: str) -> str:
    return ":".join(["02"] + _hash_bytes("lacp/{fabric}/{server}", 5))


def server_lacp_admin_key(fabric: str, server: str) -> int:
    return _fnv1a("{fabric}/{server}") % 65535 + 1


def irb_index(evi: int) -> int:
    return evi % 9999 + 1


# Device types that bridge in VLANs and name LAGs Port-Channel<n>, apart from
# SR Linux
_EOS = "AristaEOS_4_36_3_2M"
_CRPD = "JuniperCRPD_24_4R1_9"
_NXOS = "CiscoNXOS_10_6_4M"
# Device types that take the EVPN-VXLAN overlay
_OVERLAY_TYPES = {"NokiaSRLinux_25_3_2", _EOS, _CRPD, _NXOS}
# Device types that bridge a network in an internal VLAN of the switch
_VLAN_BRIDGING_TYPES = {_EOS, _CRPD}


def server_lag_name(ports: list[str], switch_type: str) -> str:
    """The LAG of a server on a leaf, named after the lowest of its ports."""
    n = min([_trailing_int(p, 0) for p in ports])
    return "Port-Channel{n}" if switch_type == _EOS else "lag{n}"


def overlay_vlan(vni: int) -> int:
    return 200 + _fnv1a("vlan/{vni}") % 800


def irb_interface(switch_type: str, evi: int, vlan: int) -> str:
    """The routed interface of a network on a leaf, in its VRF."""
    return "Vlan{vlan}" if switch_type == _EOS else "irb0.{irb_index(evi)}"


def ip_vrf_name(tenant: str, vrf: str) -> str:
    return "{tenant}-{vrf}"


def mac_vrf_name(tenant: str, network: str) -> str:
    return "{tenant}-{network}"


def server_es_name(server: str) -> str:
    return "es-{server}"


# The characters SR Linux takes in a network-instance name, which has no
# spaces here, as the name also makes the subinterface and interface names
_SRL_NAME_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&()|+=`~.,_:;?-"


def _is_srl_name(s: str, max_length: int) -> bool:
    """Whether s is a name SR Linux takes for a network instance or an
    ethernet segment."""
    if len(s) == 0 or len(s) > max_length:
        return False
    for c in s:
        if c not in _SRL_NAME_CHARS:
            return False
    return True


def network_vni(fabric: str, tenant: str, network: y_0.ip_fabric__ip_fabric__fabric__tenant__network_entry) -> int:
    """The VNI of a network: its own when set, derived otherwise."""
    vni = network.vni
    if vni is not None:
        return int(vni)
    return overlay_vni(fabric, tenant, network.name)


def vrf_vni(fabric: str, tenant: str, vrf: y_0.ip_fabric__ip_fabric__fabric__tenant__vrf_entry) -> int:
    """The layer 3 VNI of a VRF: its own when set, derived otherwise."""
    vni = vrf.vni
    if vni is not None:
        return int(vni)
    return overlay_l3_vni(fabric, tenant, vrf.name)


def _ipv4_int(address: str) -> int:
    """An IPv4 address, validated by is_ipv4_address, as a number."""
    n = 0
    for octet in address.split("."):
        n = n * 256 + int(octet)
    return n


def _ipv4_subnet(address: str, prefix_length: int) -> int:
    """The network part of an IPv4 address, validated by is_ipv4_address."""
    return _ipv4_int(address) >> (32 - prefix_length) if prefix_length > 0 else 0


def nxos_network_vlans(f: y_0.ip_fabric__ip_fabric__fabric_entry, leaf: str, tenant: str, network: str) -> list[int]:
    """The VLAN tags of the servers of a network on a leaf, without
    repetition, in the order of the servers."""
    res: list[int] = []
    for server in f.server:
        if leaf in server_leaf_ports(server):
            for att in server.attachment:
                tag = att.vlan
                if att.tenant == tenant and att.network == network and tag is not None and int(tag) not in res:
                    res.append(int(tag))
    return res


def nxos_network_vlan(f: y_0.ip_fabric__ip_fabric__fabric_entry, leaf: str, tenant: str, network: str, vni: int) -> int:
    """The VLAN of a network on a Cisco NX-OS leaf. NX-OS bridges a network
    in one VLAN of the switch, which is the VLAN tag of its servers there:
    dorsi does not translate VLAN tags on NX-OS. A network whose servers are
    all untagged there takes its internal VLAN."""
    tags = nxos_network_vlans(f, leaf, tenant, network)
    return tags[0] if len(tags) > 0 else overlay_vlan(vni)


def server_leaf_ports(server: y_0.ip_fabric__ip_fabric__fabric__server_entry) -> dict[str, list[str]]:
    """The ports of a server by leaf, in the order of its links."""
    res: dict[str, list[str]] = {}
    for link in server.connectivity.link:
        if link.switch not in res:
            res[link.switch] = []
        res[link.switch].append(link.switch_port)
    return res


def network_leaves(f: y_0.ip_fabric__ip_fabric__fabric_entry, tenant: str, network: str) -> list[str]:
    """The leaves a network is placed on: those of the servers attached to it,
    in the order of the servers and their links."""
    res: list[str] = []
    for server in f.server:
        for att in server.attachment:
            if att.tenant == tenant and att.network == network:
                for leaf in server_leaf_ports(server).keys():
                    if leaf not in res:
                        res.append(leaf)
    return res


def vrf_leaves(f: y_0.ip_fabric__ip_fabric__fabric_entry, tenant: y_0.ip_fabric__ip_fabric__fabric__tenant_entry, vrf: str) -> list[str]:
    """The leaves a VRF is placed on: those of its routed networks."""
    res: list[str] = []
    for network in tenant.network:
        if network.vrf == vrf and network.gateway is not None:
            for leaf in network_leaves(f, tenant.name, network.name):
                if leaf not in res:
                    res.append(leaf)
    return res


def server_uses_lag(server: y_0.ip_fabric__ip_fabric__fabric__server_entry, ports: list[str]) -> bool:
    """Whether a server attached to the overlay connects to a leaf over a LAG:
    always when dual-homed, for the ethernet segment, and when single-homed
    over more than one port."""
    return len(server.attachment) > 0 and (server.connectivity.profile == "dual-homed" or len(ports) > 1)


# Device types that take their management address from DHCP, or, as Juniper
# cRPD, from the container they run in. The address is not in configuration
# dorsi manages, so they need no management-address. Every other type, a new
# one too, needs it: its address sits in configuration dorsi owns, which would
# otherwise drop it and cut dorsi off from the device.
DHCP_MANAGEMENT_TYPES = {"NokiaSRLinux_25_3_2", "JuniperCRPD_24_4R1_9"}


def _decimal_at_most(s: str, max_digits: int, max_value: int) -> bool:
    """Whether s is a decimal number of at most max_digits digits and
    max_value."""
    if len(s) == 0 or len(s) > max_digits:
        return False
    for c in s:
        if c not in "0123456789":
            return False
    return int(s) <= max_value


def is_ipv4_address(s: str) -> bool:
    """Whether s is an IPv4 address such as 172.20.20.1."""
    octets: list[str] = s.split(".")
    if len(octets) != 4:
        return False
    for octet in octets:
        if not _decimal_at_most(octet, 3, 255):
            return False
    return True


def parse_management_address(s: str) -> ?(address: str, prefix_length: int):
    """The address and prefix length of an IPv4 address such as
    172.20.20.11/24, None if it is not one."""
    parts: list[str] = s.split("/")
    if len(parts) != 2 or not _decimal_at_most(parts[1], 2, 32):
        return None
    if not is_ipv4_address(parts[0]):
        return None
    return (address=parts[0], prefix_length=int(parts[1]))


def validate_fabric(f: y_0.ip_fabric__ip_fabric__fabric_entry) -> list[str]:
    """The problems found in a fabric, an empty list when it is valid.

    Checks the constraints of the ip-fabric model, which are not enforced
    when the data is applied, and the limits of the addressing scheme."""
    errors: list[str] = []
    switches: dict[str, y_0.ip_fabric__ip_fabric__fabric__switch_entry] = {}
    ids: dict[int, str] = {}
    for sw in f.switch:
        switches[sw.name] = sw
        sid = int(sw.id)
        if sid in ids:
            errors.append("switches {ids[sid]} and {sw.name} have the same id {sid}")
        else:
            ids[sid] = sw.name
        if sid > 511:
            errors.append("switch {sw.name}: id {sid} is above 511, which the addressing scheme supports")
        mgmt = sw.management_address
        if mgmt is not None:
            if parse_management_address(mgmt) is None:
                errors.append("switch {sw.name}: management-address {mgmt} is not an IPv4 address with a prefix length, such as 172.20.20.11/24")
        elif sw.type not in DHCP_MANAGEMENT_TYPES:
            errors.append("switch {sw.name}: a {sw.type} switch needs a management-address, or dorsi removes the address from its management interface")
        gateway = sw.management_gateway
        if gateway is not None:
            if not is_ipv4_address(gateway):
                errors.append("switch {sw.name}: management-gateway {gateway} is not an IPv4 address, such as 172.20.20.1")
            elif mgmt is None:
                errors.append("switch {sw.name}: a management-gateway needs a management-address")

    # A port is used by at most one fabric link or server link
    used: dict[str, str] = {}

    def use(switch: str, port: str, what: str):
        key = "{switch}/{port}"
        if key in used:
            errors.append("{switch} port {port} is used by both {used[key]} and {what}")
        else:
            used[key] = what

    for link in f.fabric_link:
        what = "the link {link.lower_switch} [{link.lower_port}] <-> {link.upper_switch} [{link.upper_port}]"
        lower = switches.get(link.lower_switch)
        upper = switches.get(link.upper_switch)
        if lower is None:
            errors.append("{what}: switch {link.lower_switch} does not exist")
        if upper is None:
            errors.append("{what}: switch {link.upper_switch} does not exist")
        use(link.lower_switch, link.lower_port, what)
        use(link.upper_switch, link.upper_port, what)
        if _trailing_int(link.lower_port, -1) < 0 or _trailing_int(link.lower_port, -1) > 63:
            errors.append("{what}: the lower port must end in a number below 64, the addresses are derived from it")
        if lower is not None and upper is not None:
            if lower.role == "leaf" and upper.role == "spine":
                if lower.pod != upper.pod:
                    errors.append("{what}: leaf {lower.name} is in {lower.pod} and spine {upper.name} in {upper.pod}")
            elif lower.role == "spine" and upper.role == "super-spine":
                if lower.plane != upper.plane:
                    errors.append("{what}: spine {lower.name} is in {lower.plane} and super-spine {upper.name} in {upper.plane}")
            else:
                errors.append("{what}: a link joins a leaf to a spine or a spine to a super-spine, not a {lower.role} to a {upper.role}")

    # A five-stage fabric has a super-spine in every plane and a spine in every
    # plane of every pod
    planes: set[str] = set()
    for sw in f.switch:
        if sw.role == "super-spine":
            planes.add(sw.plane)
    if len(planes) > 0:
        spine_planes: dict[str, set[str]] = {}
        for sw in f.switch:
            if sw.role == "spine":
                if sw.pod not in spine_planes:
                    spine_planes[sw.pod] = set()
                spine_planes[sw.pod].add(sw.plane)
                if sw.plane not in planes:
                    errors.append("spine {sw.name}: there is no super-spine in {sw.plane}")
        for pod, pod_planes in spine_planes.items():
            for plane in planes:
                if plane not in pod_planes:
                    errors.append("{pod} has no spine in {plane}")

    for server in f.server:
        what = "server {server.name}"
        profile = server.connectivity.profile
        leaves: list[str] = []
        server_ports: set[str] = set()
        for link in server.connectivity.link:
            use(link.switch, link.switch_port, "{what} [{link.server_port}]")
            sw = switches.get(link.switch)
            if sw is None:
                errors.append("{what}: switch {link.switch} does not exist")
            elif sw!.role != "leaf":
                errors.append("{what}: {link.switch} is a {sw!.role}, a server links to a leaf")
            if link.switch not in leaves:
                leaves.append(link.switch)
            if link.server_port in server_ports:
                errors.append("{what}: port {link.server_port} is used by more than one link")
            server_ports.add(link.server_port)
        if profile == "single-homed" and len(leaves) != 1:
            errors.append("{what}: a single-homed server links to one leaf, not {len(leaves)}")
        if profile == "dual-homed" and len(leaves) != 2:
            errors.append("{what}: a dual-homed server links to two leaves, not {len(leaves)}")

    errors.extend(validate_overlay(f, switches))
    return errors


def validate_overlay(f: y_0.ip_fabric__ip_fabric__fabric_entry, switches: dict[str, y_0.ip_fabric__ip_fabric__fabric__switch_entry]) -> list[str]:
    """The problems found in the EVPN-VXLAN overlay of a fabric."""
    errors: list[str] = []
    if len(f.tenant) == 0:
        return errors

    # The overlay is built on SR Linux, Arista EOS, Juniper cRPD and Cisco
    # NX-OS: every
    # switch carries EVPN routes, the spines too
    for sw in f.switch:
        if sw.type not in _OVERLAY_TYPES:
            errors.append("switch {sw.name}: the EVPN overlay is supported on NokiaSRLinux_25_3_2, {_EOS}, {_CRPD} and {_NXOS} only, not {sw.type}")

    # Identifiers derived or set must be unique in the fabric, those of VRFs
    # and networks together: they share the VNIs, EVIs and the names of
    # network instances
    vnis: dict[int, str] = {}
    evis: dict[int, str] = {}
    vrf_names: dict[str, str] = {}
    # The internal VLANs and IRB subinterfaces are local to a switch, so they
    # need only be unique on each leaf, by leaf
    leaf_irbs: dict[str, dict[int, str]] = {}
    leaf_vlans: dict[str, dict[int, str]] = {}

    def identify(what: str, vni: int, name: str, kind: str):
        if vni in vnis:
            errors.append("{what}: VNI {vni} is also used by {vnis[vni]}, set a vni on one of them")
        else:
            vnis[vni] = what
        evi = overlay_evi(vni)
        if evi in evis:
            errors.append("{what}: EVI {evi}, derived from VNI {vni}, is also used by {evis[evi]}, set another vni on one of them")
        else:
            evis[evi] = what
        if not _is_srl_name(name, 247):
            errors.append("{what}: its {kind} name {name} is not a name SR Linux takes: up to 247 letters, digits and punctuation, no spaces or slashes")
        elif name in vrf_names:
            errors.append("{what}: its {kind} name {name} is also that of {vrf_names[name]}")
        else:
            vrf_names[name] = what

    for tenant in f.tenant:
        for vrf in tenant.vrf:
            identify("VRF {tenant.name}/{vrf.name}", vrf_vni(f.name, tenant.name, vrf), ip_vrf_name(tenant.name, vrf.name), "IP-VRF")
        # The gateways of a VRF, as (subnet, prefix length, network)
        gateways: dict[str, list[(int, int, str)]] = {}
        for network in tenant.network:
            what = "network {tenant.name}/{network.name}"
            vni = network_vni(f.name, tenant.name, network)
            identify(what, vni, mac_vrf_name(tenant.name, network.name), "MAC-VRF")
            # Only switches that bridge in VLANs use the internal VLAN
            vlan = overlay_vlan(vni)
            leaves = network_leaves(f, tenant.name, network.name)
            for leaf in leaves:
                sw = switches.get(leaf)
                if sw is not None and sw.type == _NXOS:
                    tags = nxos_network_vlans(f, leaf, tenant.name, network.name)
                    if len(tags) > 1:
                        errors.append("{what}: its servers on {leaf} ({_NXOS}) use VLANs {", ".join([str(t) for t in tags])}, they must use one VLAN there")
                    nxos_vlan = nxos_network_vlan(f, leaf, tenant.name, network.name, vni)
                    if leaf not in leaf_vlans:
                        leaf_vlans[leaf] = {}
                    if nxos_vlan in leaf_vlans[leaf]:
                        errors.append("{what}: its VLAN {nxos_vlan} on {leaf} ({_NXOS}) is also that of {leaf_vlans[leaf][nxos_vlan]}, the switch bridges a VLAN in one network")
                    else:
                        leaf_vlans[leaf][nxos_vlan] = what
                elif sw is not None and sw.type in _VLAN_BRIDGING_TYPES:
                    if leaf not in leaf_vlans:
                        leaf_vlans[leaf] = {}
                    if vlan in leaf_vlans[leaf]:
                        errors.append("{what}: its internal VLAN {vlan} on {leaf}, derived from VNI {vni}, is also that of {leaf_vlans[leaf][vlan]}, set another vni on one of them")
                    else:
                        leaf_vlans[leaf][vlan] = what
            vrf = network.vrf
            gateway = network.gateway
            if vrf is not None:
                if tenant.vrf.get(vrf) is None:
                    errors.append("{what}: VRF {vrf} does not exist in tenant {tenant.name}")
                if gateway is None:
                    errors.append("{what}: a network in a VRF needs a gateway")
                irb = irb_index(overlay_evi(vni))
                for leaf in leaves:
                    sw = switches.get(leaf)
                    if sw is not None and (sw.type == _CRPD or sw.type == _NXOS):
                        errors.append("{what}: a routed network cannot be placed on {leaf} ({sw.type}) yet")
                    elif sw is not None and sw.type == _EOS:
                        # The gateway of EOS is on the VLAN interface of the
                        # internal VLAN, checked above
                        pass
                    else:
                        if leaf not in leaf_irbs:
                            leaf_irbs[leaf] = {}
                        if irb in leaf_irbs[leaf]:
                            errors.append("{what}: its IRB subinterface irb0.{irb} on {leaf}, derived from VNI {vni}, is also that of {leaf_irbs[leaf][irb]}, set another vni on one of them")
                        else:
                            leaf_irbs[leaf][irb] = what
            if gateway is not None and vrf is None:
                errors.append("{what}: a gateway needs a vrf")
            if gateway is not None and vrf is not None:
                parsed = parse_management_address(gateway)
                address = parsed.address if parsed is not None else ""
                length = parsed.prefix_length if parsed is not None else 0
                if length < 1 or length > 30:
                    errors.append("{what}: gateway {gateway} is not an IPv4 address with a prefix length of 1 to 30, such as 10.10.10.1/24")
                else:
                    if vrf not in gateways:
                        gateways[vrf] = []
                    subnet = _ipv4_subnet(address, length)
                    for other_subnet, other_length, other in gateways[vrf]:
                        shorter = min([length, other_length])
                        if subnet >> (length - shorter) == other_subnet >> (other_length - shorter):
                            errors.append("{what}: its subnet overlaps that of network {tenant.name}/{other} in VRF {vrf}")
                    gateways[vrf].append((subnet, length, network.name))

    # Attachments: an existing network, one VLAN per network on a server and
    # the addresses of a network in one subnet
    subnets: dict[str, (int, int, str)] = {}
    addresses: dict[str, str] = {}
    lags: dict[str, str] = {}
    for server in f.server:
        what = "server {server.name}"
        vlans: dict[str, str] = {}
        for att in server.attachment:
            network = "{att.tenant}/{att.network}"
            tenant = f.tenant.get(att.tenant)
            if tenant is not None:
                if tenant.network.get(att.network) is None:
                    errors.append("{what}: network {network} does not exist")
            else:
                errors.append("{what}: tenant {att.tenant} does not exist")
            gateway: ?str = None
            if tenant is not None:
                net = tenant.network.get(att.network)
                if net is not None:
                    gateway = net.gateway
            vlan_id = att.vlan
            vlan = str(vlan_id) if vlan_id is not None else "untagged"
            if vlan in vlans:
                errors.append("{what}: networks {vlans[vlan]} and {network} are both on VLAN {vlan}")
            else:
                vlans[vlan] = network
            address = att.ipv4_address
            if address is not None:
                parsed = parse_management_address(address)
                if parsed is not None:
                    host = parsed.address
                    length = parsed.prefix_length
                    if host in addresses:
                        errors.append("{what}: address {host} is also that of {addresses[host]}")
                    else:
                        addresses[host] = what
                    subnet = _ipv4_subnet(host, length)
                    if gateway is not None:
                        gw = parse_management_address(gateway)
                        if gw is not None:
                            if gw.address == host:
                                errors.append("{what}: address {host} is the gateway of network {network}")
                            elif gw.prefix_length != length or _ipv4_subnet(gw.address, gw.prefix_length) != subnet:
                                errors.append("{what}: address {address} is not in the subnet of gateway {gateway} of network {network}")
                    if network not in subnets:
                        subnets[network] = (subnet, length, server.name)
                    else:
                        seen_subnet, seen_length, seen_server = subnets[network]
                        if seen_subnet != subnet or seen_length != length:
                            errors.append("{what}: address {address} is not in the subnet of server {seen_server} in network {network}")
                else:
                    errors.append("{what}: ipv4-address {address} of network {network} is not an IPv4 address with a prefix length, such as 10.10.10.11/24")
        leaf_ports = server_leaf_ports(server)
        if len(server.attachment) > 0:
            for leaf in leaf_ports.keys():
                sw = switches.get(leaf)
                if sw is not None and sw.type == _EOS:
                    for att in server.attachment:
                        tag = att.vlan
                        if tag is not None and leaf in leaf_vlans and int(tag) in leaf_vlans[leaf]:
                            other = leaf_vlans[leaf][int(tag)]
                            # The tag of a network that is its own internal
                            # VLAN needs no translation
                            if other != "network {att.tenant}/{att.network}":
                                errors.append("{what}: its VLAN {tag} on {leaf} is the internal VLAN of {other}, the switch would bridge it there")
                if sw is not None and sw.type == _NXOS and server_uses_lag(server, leaf_ports[leaf]):
                    errors.append("{what}: a server on a LAG cannot be attached on {leaf} ({_NXOS}) yet")
                if sw is not None and sw.type == _CRPD:
                    # cRPD bridges a server port as a VLAN subinterface; an
                    # untagged port and a LAG did not come up in the lab
                    if server_uses_lag(server, leaf_ports[leaf]):
                        errors.append("{what}: a server on a LAG cannot be attached on {leaf} ({_CRPD}) yet")
                    for att in server.attachment:
                        if att.vlan is None:
                            errors.append("{what}: an untagged attachment cannot be placed on {leaf} ({_CRPD}) yet, set a vlan")
        if len(server.attachment) > 0 and server.connectivity.profile == "dual-homed":
            es = server_es_name(server.name)
            if not _is_srl_name(es, 32):
                errors.append("{what}: its ethernet segment {es} is not a name SR Linux takes: up to 32 letters, digits and punctuation, no spaces or slashes")
        for leaf, ports in leaf_ports.items():
            if server_uses_lag(server, ports):
                sw = switches.get(leaf)
                lag = server_lag_name(ports, sw.type if sw is not None else "")
                key = "{leaf}/{lag}"
                lag_id = _trailing_int(lag, 0)
                if lag_id < 1 or lag_id > 1000:
                    errors.append("{what}: the LAG on {leaf} is named after its lowest port, whose number must be 1 to 1000")
                elif key in lags:
                    errors.append("{what}: its LAG on {leaf}, {lag}, is also that of server {lags[key]}")
                else:
                    lags[key] = server.name
    return errors


class Fabric(base.Fabric):
    """Transform of a complete fabric.

    The transform sits on the fabric list entry and not on its switch and
    fabric-link entries. A link needs the role, pod, plane and id of both of its
    switches, and a sw:link can only select list entries by key. The switches
    are nested below the fabric list, whose key such a link cannot supply.
    """
    def transform(self, i):
        print("CFS fabric transform running", i.name)
        errors = validate_fabric(i)
        if len(errors) > 0:
            raise ValueError("fabric {i.name} is invalid:\n  " + "\n  ".join(errors))
        o = base.o_root()

        switches = {}
        base_configs = {}
        for sw in i.switch:
            switches[sw.name] = sw
            dev = o.device.create(sw.name, type=sw.type)
            # Connect where the management interface is kept, so that a wrong
            # address fails to connect instead of cutting dorsi off later
            address = sw.name
            mgmt_address = sw.management_address
            if mgmt_address is not None:
                mgmt = parse_management_address(mgmt_address)
                if mgmt is not None:
                    address = mgmt.address
            dev.address.create("oob", address=address)
            dev.credentials.username = "clab"
            dev.credentials.password = "clab@123"
            dev.mock.enabled = sw.mock

            rfs = o.rfs.create(sw.name)
            base_config = rfs.fabric_base_config.create(u64(fabric_asn(sw.role, int(sw.id), sw.pod, sw.plane)))
            base_config.role = sw.role
            base_config.ipv4_address = fabric_loopback(int(sw.id))
            base_config.management_address = sw.management_address
            base_config.management_gateway = sw.management_gateway
            base_config.evpn = len(i.tenant) > 0
            base_configs[sw.name] = base_config

        for link in i.fabric_link:
            print("CFS fabric-link %s [%s] <-> %s [%s]" % (link.lower_switch, link.lower_port, link.upper_switch, link.upper_port))
            lower = switches[link.lower_switch]
            upper = switches[link.upper_switch]
            lower_asn = fabric_asn(lower.role, int(lower.id), lower.pod, lower.plane)
            upper_asn = fabric_asn(upper.role, int(upper.id), upper.pod, upper.plane)
            lower_addr, upper_addr = fabric_link_addresses(int(lower.id), link.lower_port)

            base_configs[link.lower_switch].fabric_port.append(link.lower_port)
            base_configs[link.upper_switch].fabric_port.append(link.upper_port)

            li = o.rfs.create(link.lower_switch).fabric_interface.create(link.lower_port, ipv4_address=lower_addr)
            li.remote.device = link.upper_switch
            li.remote.interface = link.upper_port
            li.bgp.peer_address = upper_addr
            li.bgp.peer_asn = u64(upper_asn)

            ui = o.rfs.create(link.upper_switch).fabric_interface.create(link.upper_port, ipv4_address=upper_addr)
            ui.remote.device = link.lower_switch
            ui.remote.interface = link.lower_port
            ui.bgp.peer_address = lower_addr
            ui.bgp.peer_asn = u64(lower_asn)

            # A Juniper cRPD leaf sends its EVPN routes from its loopback to
            # the loopback of each of its spines (see overlay-peer)
            if len(i.tenant) > 0 and lower.role == "leaf" and lower.type == _CRPD:
                base_configs[link.lower_switch].overlay_peer.create(fabric_loopback(int(upper.id)), u64(upper_asn), link.upper_switch)
                base_configs[link.upper_switch].overlay_peer.create(fabric_loopback(int(lower.id)), u64(lower_asn), link.lower_switch)

        # The port or LAG of every server on each of its leaves, by server and
        # leaf, for the networks it is attached to
        server_interfaces: dict[str, dict[str, str]] = {}
        # The server ports of Cisco NX-OS leaves by leaf and port, which
        # carry the VLANs of their networks (see trunk-vlan)
        nxos_ports: dict[str, dict[str, y_1_loose.stratoweave_rfs__rfs__server_port_entry]] = {}
        for server in i.server:
            print("CFS fabric server", server.name, server.connectivity.profile)
            server_interfaces[server.name] = {}
            for leaf, ports in server_leaf_ports(server).items():
                interface = ports[0]
                uses_lag = server_uses_lag(server, ports)
                if uses_lag:
                    interface = server_lag_name(ports, switches[leaf].type)
                    server_lag = o.rfs.create(leaf).server_lag.create(interface, server.name, server_lacp_system_id(i.name, server.name), u64(server_lacp_admin_key(i.name, server.name)))
                    if server.connectivity.profile == "dual-homed":
                        server_lag.esi = server_esi(i.name, server.name)
                for link in server.connectivity.link:
                    if link.switch == leaf:
                        port = o.rfs.create(leaf).server_port.create(link.switch_port, server=server.name, server_port=link.server_port, profile=server.connectivity.profile)
                        if uses_lag:
                            port.lag = interface
                        if switches[leaf].type == _NXOS:
                            if leaf not in nxos_ports:
                                nxos_ports[leaf] = {}
                            nxos_ports[leaf][link.switch_port] = port
                server_interfaces[server.name][leaf] = interface

        # A network is placed on the leaves of the servers attached to it,
        # a VRF on the leaves of its networks
        for tenant in i.tenant:
            # The IRB subinterfaces of each VRF by leaf
            vrf_irbs: dict[str, dict[str, list[str]]] = {}
            for network in tenant.network:
                vni = network_vni(i.name, tenant.name, network)
                evi = overlay_evi(vni)
                name = mac_vrf_name(tenant.name, network.name)
                route_target = overlay_route_target(i.name, vni)
                print("CFS fabric network {tenant.name}/{network.name} VNI {vni}")
                for server in i.server:
                    for att in server.attachment:
                        if att.tenant != tenant.name or att.network != network.name:
                            continue
                        for leaf, interface in server_interfaces[server.name].items():
                            rd = overlay_route_distinguisher(int(switches[leaf].id), evi)
                            mac_vrf = o.rfs.create(leaf).mac_vrf.create(name, u64(vni), u64(evi), rd, route_target)
                            if switches[leaf].type == _NXOS:
                                net_vlan = nxos_network_vlan(i, leaf, tenant.name, network.name, vni)
                                mac_vrf.vlan = u64(net_vlan)
                                nxos_port = nxos_ports[leaf][interface]
                                if u64(net_vlan) not in nxos_port.trunk_vlan:
                                    nxos_port.trunk_vlan.append(u64(net_vlan))
                                if att.vlan is None:
                                    nxos_port.native_vlan = u64(net_vlan)
                            else:
                                mac_vrf.vlan = u64(overlay_vlan(vni))
                            mac_vrf.interface.create(interface).vlan = att.vlan
                            vrf = network.vrf
                            gateway = network.gateway
                            if vrf is not None and gateway is not None:
                                irb = irb_index(evi)
                                mac_vrf.create_irb(u64(irb), gateway)
                                if vrf not in vrf_irbs:
                                    vrf_irbs[vrf] = {}
                                if leaf not in vrf_irbs[vrf]:
                                    vrf_irbs[vrf][leaf] = []
                                irb_if = irb_interface(switches[leaf].type, evi, overlay_vlan(vni))
                                if irb_if not in vrf_irbs[vrf][leaf]:
                                    vrf_irbs[vrf][leaf].append(irb_if)
            for vrf in tenant.vrf:
                vni = vrf_vni(i.name, tenant.name, vrf)
                evi = overlay_evi(vni)
                print("CFS fabric VRF {tenant.name}/{vrf.name} VNI {vni}")
                if vrf.name not in vrf_irbs:
                    continue
                for leaf, irbs in vrf_irbs[vrf.name].items():
                    rd = overlay_route_distinguisher(int(switches[leaf].id), evi)
                    ip_vrf = o.rfs.create(leaf).ip_vrf.create(ip_vrf_name(tenant.name, vrf.name), u64(vni), u64(evi), rd, overlay_route_target(i.name, vni))
                    ip_vrf.irb_interface = irbs

        return o


# --- Fabric link state lift ---------------------------------------------------
# Combine the two ends' RFS fabric-interface state into the state of the
# fabric-link: up only when both ends are up (see combine_link_status). Served at
# data/ip-fabric:ip-fabric/fabric/fabric-link. A server link has one end DORSI
# can read, its leaf port, whose RFS server-port state becomes the state of the
# link at data/ip-fabric:ip-fabric/fabric/server/connectivity/link.

def combine_link_status(left: ?str, right: ?str) -> ?str:
    if left == "up" and right == "up":
        return "up"
    if left == "down" or right == "down":
        return "down"
    if left is None and right is None:
        return None
    return "unknown"


def down_since(status: ?str, since: ?int, now: int) -> ?int:
    """When a status went down: `since` from the last poll while it stays
    down, `now` when it has just gone down, None when it is read as anything
    else. A status that cannot be read, None or unknown, says nothing new and
    keeps `since`."""
    if status == "down":
        return since if since is not None else now
    if status is None or status == "unknown":
        return since
    return None


def _is_device(seen: str, expected: str) -> bool:
    """Whether the LLDP system name `seen` is the switch `expected`, which it
    is also when the switch reports a fully qualified name."""
    return seen == expected or seen.startswith(expected + ".")


def _is_interface(seen: str, expected: str) -> bool:
    """Whether the LLDP port ID `seen` is the port `expected`. NX-OS names a
    port eth1/2 in its native model but sends Ethernet1/2 over LLDP."""
    if seen == expected:
        return True
    return expected.startswith("eth") and expected[3:4] in "0123456789" and "/" in expected and seen == "Ethernet" + expected[3:]


def end_cabling_status(oper: ?str, seen_device: ?str, seen_interface: ?str, expected_device: str, expected_interface: str) -> ?str:
    """Whether one end of a link sees the switch and port it should over LLDP.
    None when the end is not up, LLDP needs a working link."""
    if oper != "up":
        return None
    if seen_device is None and seen_interface is None:
        return "no-neighbor"
    if seen_device is not None and seen_interface is not None:
        if _is_device(seen_device, expected_device) and _is_interface(seen_interface, expected_interface):
            return "ok"
    return "mismatch"


def combine_cabling_status(left: ?str, right: ?str) -> ?str:
    """The cabling of a link from that of its two ends. One end that sees the
    other is enough to know where the cable goes, an end that sees another
    port says it goes elsewhere."""
    if left == "mismatch" or right == "mismatch":
        return "mismatch"
    if left == "ok" or right == "ok":
        return "ok"
    if left == "no-neighbor" or right == "no-neighbor":
        return "no-neighbor"
    if left is None and right is None:
        return None
    return "unknown"


def _is_mac_address(s: str) -> bool:
    """Whether `s` reads as a MAC address, such as aa:c1:ab:76:ef:bc."""
    if len(s) != 17:
        return False
    for i in range(17):
        c = s[i]
        if i % 3 == 2:
            if c != ":" and c != "-":
                return False
        elif c not in "0123456789abcdefABCDEF":
            return False
    return True


def server_cabling_status(oper: ?str, seen_device: ?str, seen_interface: ?str, server: str, server_port: str) -> ?str:
    """Whether the leaf port of a server link sees the server port over LLDP.

    None when the port is not up or sees no neighbor: many servers send no
    LLDP. Linux lldpd sends the MAC address as the port ID unless set up
    otherwise, so the port is only compared when it is not one."""
    if oper != "up":
        return None
    if seen_device is not None:
        if not _is_device(seen_device, server):
            return "mismatch"
        if seen_interface is not None:
            if not _is_mac_address(seen_interface) and seen_interface != server_port:
                return "mismatch"
        return "ok"
    return None


actor FabricTransform(path: ttt.Path,
                      update_oper: proc(?y_0_oper.ip_fabric__ip_fabric__fabric_entry)->None,
                      lower_tree_provider: ?gdata.TreeProvider):
    _subs = gdata.SubscriptionManager(lower_tree_provider!, str(path))
    # Monotonic time in ns at which the eBGP session of a link went down, by link
    var _bgp_down_since: dict[str, int] = {}

    def on_rfs_state(root: ?y_1_oper.root, err: ?Exception, links: list[(str, str, str, str)], server_links: list[(str, str, str, str)], placements: list[(str, str, str, str, str)]):
        if err is not None:
            print("cfs.FabricTransform RFS subscription error: {err}", err=True)
            return
        # The state is built anew from each delivery, so that a link, server
        # or placement removed from the fabric leaves it
        fabric_state = base.Fabric.new_state(path)
        now = time.monotonic_ns()
        bgp_down_since: dict[str, int] = {}
        for lower, lower_port, upper, upper_port in links:
            lower_oper: ?str = None
            upper_oper: ?str = None
            lower_bgp: ?str = None
            upper_bgp: ?str = None
            lower_seen_device: ?str = None
            lower_seen_interface: ?str = None
            upper_seen_device: ?str = None
            upper_seen_interface: ?str = None
            if root is not None:
                for r in root.rfs:
                    if r.name == lower:
                        for fi in r.fabric_interface:
                            if fi.name == lower_port:
                                lower_oper = fi.state.oper_status
                                lower_bgp = fi.state.bgp_status
                                lower_seen_device = fi.state.lldp_neighbor.device
                                lower_seen_interface = fi.state.lldp_neighbor.interface
                    if r.name == upper:
                        for fi in r.fabric_interface:
                            if fi.name == upper_port:
                                upper_oper = fi.state.oper_status
                                upper_bgp = fi.state.bgp_status
                                upper_seen_device = fi.state.lldp_neighbor.device
                                upper_seen_interface = fi.state.lldp_neighbor.interface
            link = fabric_state.fabric_link.create((lower, lower_port, upper, upper_port))
            link.state.link_status = combine_link_status(lower_oper, upper_oper)
            link.state.bgp_status = combine_link_status(lower_bgp, upper_bgp)
            # Only the time the session is down on a working link counts: it
            # cannot come up before the link does
            key = "{lower}|{lower_port}|{upper}|{upper_port}"
            since = _bgp_down_since.get(key)
            if link.state.link_status == "up":
                since = down_since(link.state.bgp_status, since, now)
            elif link.state.link_status == "down":
                since = None
            if since is not None:
                bgp_down_since[key] = since
            if since is not None and link.state.link_status == "up" and link.state.bgp_status == "down":
                link.state.bgp_down_seconds = u64((now - since) // 1000000000)
            else:
                link.state.bgp_down_seconds = None
            link.state.cabling_status = combine_cabling_status(
                end_cabling_status(lower_oper, lower_seen_device, lower_seen_interface, upper, upper_port),
                end_cabling_status(upper_oper, upper_seen_device, upper_seen_interface, lower, lower_port))
            link.state.lower_neighbor.device = lower_seen_device
            link.state.lower_neighbor.interface = lower_seen_interface
            link.state.upper_neighbor.device = upper_seen_device
            link.state.upper_neighbor.interface = upper_seen_interface
        for server, switch, switch_port, server_port in server_links:
            oper: ?str = None
            seen_device: ?str = None
            seen_interface: ?str = None
            if root is not None:
                for r in root.rfs:
                    if r.name == switch:
                        for sp in r.server_port:
                            if sp.name == switch_port:
                                oper = sp.state.oper_status
                                seen_device = sp.state.lldp_neighbor.device
                                seen_interface = sp.state.lldp_neighbor.interface
            server_link = fabric_state.server.create(server).connectivity.link.create((switch, switch_port))
            server_link.state.link_status = oper
            server_link.state.cabling_status = server_cabling_status(oper, seen_device, seen_interface, server, server_port)
            server_link.state.neighbor.device = seen_device
            server_link.state.neighbor.interface = seen_interface
        # The overlay: each network and VRF on each leaf it is placed on, and
        # each server LAG
        for kind, owner, name, leaf, rfs_name in placements:
            oper_status: ?str = None
            other_status: ?str = None
            if root is not None:
                for r in root.rfs:
                    if r.name == leaf:
                        if kind == "network":
                            for e in r.mac_vrf:
                                if e.name == rfs_name:
                                    oper_status = e.state.oper_status
                                    other_status = e.state.evpn_status
                        elif kind == "vrf":
                            for e in r.ip_vrf:
                                if e.name == rfs_name:
                                    oper_status = e.state.oper_status
                                    other_status = e.state.evpn_status
                        else:
                            for e in r.server_lag:
                                if e.name == rfs_name:
                                    oper_status = e.state.oper_status
                                    other_status = e.state.es_status
            if kind == "network":
                p = fabric_state.tenant.create(owner).network.create(name).state.placement.create(leaf)
                p.oper_status = oper_status
                p.evpn_status = other_status
            elif kind == "vrf":
                p = fabric_state.tenant.create(owner).vrf.create(name).state.placement.create(leaf)
                p.oper_status = oper_status
                p.evpn_status = other_status
            else:
                lag = fabric_state.server.create(owner).state.lag.create(leaf)
                lag.name = rfs_name
                lag.oper_status = oper_status
                lag.es_status = other_status
        _bgp_down_since = bgp_down_since
        update_oper(fabric_state)

    def on_conf(conf: y_0.ip_fabric__ip_fabric__fabric_entry):
        links: list[(str, str, str, str)] = []
        server_links: list[(str, str, str, str)] = []
        want: set[gdata.Delivery] = set()
        subs: set[gdata.SubscriptionSpec] = set()
        for link in conf.fabric_link:
            links.append((link.lower_switch, link.lower_port, link.upper_switch, link.upper_port))
            subs.add(y_1_oper.subs.rfs.entry(link.lower_switch).fabric_interface.entry(link.lower_port).state.subscribe(period=5.0))
            subs.add(y_1_oper.subs.rfs.entry(link.upper_switch).fabric_interface.entry(link.upper_port).state.subscribe(period=5.0))
        for server in conf.server:
            for link in server.connectivity.link:
                server_links.append((server.name, link.switch, link.switch_port, link.server_port))
                subs.add(y_1_oper.subs.rfs.entry(link.switch).server_port.entry(link.switch_port).state.subscribe(period=5.0))
        # (kind, tenant or server, network or VRF, leaf, RFS entry)
        placements: list[(str, str, str, str, str)] = []
        for tenant in conf.tenant:
            for network in tenant.network:
                name = mac_vrf_name(tenant.name, network.name)
                for leaf in network_leaves(conf, tenant.name, network.name):
                    placements.append(("network", tenant.name, network.name, leaf, name))
                    subs.add(y_1_oper.subs.rfs.entry(leaf).mac_vrf.entry(name).state.subscribe(period=5.0))
            for vrf in tenant.vrf:
                name = ip_vrf_name(tenant.name, vrf.name)
                for leaf in vrf_leaves(conf, tenant, vrf.name):
                    placements.append(("vrf", tenant.name, vrf.name, leaf, name))
                    subs.add(y_1_oper.subs.rfs.entry(leaf).ip_vrf.entry(name).state.subscribe(period=5.0))
        switch_types: dict[str, str] = {}
        for sw in conf.switch:
            switch_types[sw.name] = sw.type
        for server in conf.server:
            for leaf, ports in server_leaf_ports(server).items():
                if server_uses_lag(server, ports):
                    lag = server_lag_name(ports, switch_types[leaf] if leaf in switch_types else "")
                    placements.append(("lag", server.name, "", leaf, lag))
                    subs.add(y_1_oper.subs.rfs.entry(leaf).server_lag.entry(lag).state.subscribe(period=5.0))
        dst = y_1_oper.dst(lambda r, e: on_rfs_state(r, e, links, server_links, placements))
        want.add(dst.deliver(subs))
        _subs.declare(want)

    def shutdown():
        pass
