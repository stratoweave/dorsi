import testing

import yang.gdata as gdata

import dorsi.sysspec as sysspec
import dorsi.layers.y_0 as cfs_layer
import stratoweave.test_rig as swts

SRL = "NokiaSRLinux_25_3_2"
EOS = "AristaEOS_4_36_3_2M"
CRPD = "JuniperCRPD_24_4R1_9"
NXOS = "CiscoNXOS_10_6_4M"

def add_switch(fabric: cfs_layer.ip_fabric__ip_fabric__fabric_entry, name: str, id: u64, role: str, pod: ?str=None, plane: ?str=None, device_type: str=SRL, management_address: ?str=None, management_gateway: ?str=None):
    s = fabric.switch.create(name, id, device_type, role)
    s.mock = True
    s.management_address = management_address
    s.management_gateway = management_gateway
    if pod is not None:
        s.pod = pod
    if plane is not None:
        s.plane = plane

def add_link(fabric: cfs_layer.ip_fabric__ip_fabric__fabric_entry, lower: str, lower_port: str, upper: str, upper_port: str):
    fabric.fabric_link.create((lower, lower_port, upper, upper_port))

def add_server(fabric: cfs_layer.ip_fabric__ip_fabric__fabric_entry, name: str, profile: str, links: list[(str, str, str)]):
    conn = cfs_layer.ip_fabric__ip_fabric__fabric__server__connectivity(profile)
    for switch, switch_port, server_port in links:
        conn.link.create((switch, switch_port), server_port)
    fabric.server.create(name, conn)

def _empty_root():
    return cfs_layer.root()

# Servers: two dual-homed to a pair of leaves, one single-homed. The same in
# both topologies, which both have leaf1 to leaf3.
def add_servers(fabric: cfs_layer.ip_fabric__ip_fabric__fabric_entry):
    add_server(fabric, "server1", "dual-homed", [("leaf1", "ethernet-1/1", "eth1"), ("leaf2", "ethernet-1/1", "eth2")])
    add_server(fabric, "server2", "dual-homed", [("leaf2", "ethernet-1/2", "eth1"), ("leaf3", "ethernet-1/1", "eth2")])
    add_server(fabric, "server3", "single-homed", [("leaf3", "ethernet-1/2", "eth1")])

# Three-stage Clos: three leaves, each connected to both spines.
def three_stage():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf")
    add_switch(f, "leaf2", 2, "leaf")
    add_switch(f, "leaf3", 3, "leaf")
    add_switch(f, "spine1", 11, "spine")
    add_switch(f, "spine2", 12, "spine")
    for n, leaf in enumerate(["leaf1", "leaf2", "leaf3"]):
        add_link(f, leaf, "ethernet-1/49", "spine1", "ethernet-1/{n + 1}")
        add_link(f, leaf, "ethernet-1/50", "spine2", "ethernet-1/{n + 1}")
    add_servers(f)
    return root

# The EVPN-VXLAN overlay of the fabric-3stage lab, on the three-stage Clos.
# Tenant t1 has two networks, routed between each other by VRF main: web,
# tagged with VLAN 10, joins server1 (dual-homed to leaf1 and leaf2) to server3
# (single-homed to leaf3); db, untagged, is on server2 (dual-homed to leaf2 and
# leaf3).
def add_overlay(fabric: cfs_layer.ip_fabric__ip_fabric__fabric_entry):
    tenant = fabric.tenant.create("t1")
    tenant.vrf.create("main")
    tenant.network.create("web", vrf="main", gateway="10.10.10.1/24")
    tenant.network.create("db", vrf="main", gateway="10.10.20.1/24")
    fabric.server.get("server1")!.attachment.create(("t1", "web"), vlan=10, ipv4_address="10.10.10.11/24")
    fabric.server.get("server3")!.attachment.create(("t1", "web"), vlan=10, ipv4_address="10.10.10.13/24")
    fabric.server.get("server2")!.attachment.create(("t1", "db"), ipv4_address="10.10.20.12/24")

def three_stage_overlay():
    root = three_stage()
    add_overlay(root.ip_fabric.fabric.get("dc1")!)
    return root

# The three-stage Clos of the fabric-3stage-mixed lab: leaf3 and spine2 run
# Arista EOS (ports EthernetN), the rest SR Linux. It has every kind of link:
# SR Linux to EOS both ways and EOS to EOS (leaf3 to spine2). EOS keeps its
# management address in configuration, so the EOS switches have one, and
# the gateway of the management network.
def three_stage_mixed():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf")
    add_switch(f, "leaf2", 2, "leaf")
    add_switch(f, "leaf3", 3, "leaf", device_type=EOS, management_address="172.31.36.13/24", management_gateway="172.31.36.1")
    add_switch(f, "spine1", 11, "spine")
    add_switch(f, "spine2", 12, "spine", device_type=EOS, management_address="172.31.36.22/24", management_gateway="172.31.36.1")
    for n, leaf in enumerate(["leaf1", "leaf2"]):
        add_link(f, leaf, "ethernet-1/49", "spine1", "ethernet-1/{n + 1}")
        add_link(f, leaf, "ethernet-1/50", "spine2", "Ethernet{n + 1}")
    add_link(f, "leaf3", "Ethernet49", "spine1", "ethernet-1/3")
    add_link(f, "leaf3", "Ethernet50", "spine2", "Ethernet3")
    add_server(f, "server1", "dual-homed", [("leaf1", "ethernet-1/1", "eth1"), ("leaf2", "ethernet-1/1", "eth2")])
    add_server(f, "server2", "dual-homed", [("leaf2", "ethernet-1/2", "eth1"), ("leaf3", "Ethernet1", "eth2")])
    add_server(f, "server3", "single-homed", [("leaf3", "Ethernet2", "eth1")])
    return root

# The EVPN-VXLAN overlay of the fabric-3stage-mixed lab, across SR Linux and
# Arista EOS, layer 2 only: dorsi cannot put an ethernet segment or a VRF on
# EOS yet. Network t1/web joins server1, on an ESI-LAG of leaf1 and leaf2 (SR
# Linux), to server3 on leaf3 (EOS), which sends it with another VLAN tag, and
# to server2, single-homed to leaf3 here, untagged.
def three_stage_mixed_overlay():
    root = three_stage_mixed()
    f = root.ip_fabric.fabric.get("dc1")!
    server2 = f.server.get("server2")!
    server2.connectivity = cfs_layer.ip_fabric__ip_fabric__fabric__server__connectivity("single-homed")
    server2.connectivity.link.create(("leaf3", "Ethernet1"), "eth2")
    f.tenant.create("t1").network.create("web")
    f.server.get("server1")!.attachment.create(("t1", "web"), vlan=10, ipv4_address="10.10.10.11/24")
    f.server.get("server3")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.13/24")
    f.server.get("server2")!.attachment.create(("t1", "web"), ipv4_address="10.10.10.12/24")
    return root

# Five-stage Clos: two pods, each with two leaves and one spine per plane.
# Spines of the same plane connect to the super-spine of that plane.
def five_stage():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf", pod="pod-1")
    add_switch(f, "leaf2", 2, "leaf", pod="pod-1")
    add_switch(f, "leaf3", 3, "leaf", pod="pod-2")
    add_switch(f, "leaf4", 4, "leaf", pod="pod-2")
    add_switch(f, "spine1", 11, "spine", pod="pod-1", plane="plane-1")
    add_switch(f, "spine2", 12, "spine", pod="pod-1", plane="plane-2")
    add_switch(f, "spine3", 13, "spine", pod="pod-2", plane="plane-1")
    add_switch(f, "spine4", 14, "spine", pod="pod-2", plane="plane-2")
    add_switch(f, "superspine1", 21, "super-spine", plane="plane-1")
    add_switch(f, "superspine2", 22, "super-spine", plane="plane-2")
    # Leaf to spine, within a pod. Uplink 49 goes to plane-1, 50 to plane-2.
    for leaf, p1, p2, port in [("leaf1", "spine1", "spine2", 1), ("leaf2", "spine1", "spine2", 2),
                               ("leaf3", "spine3", "spine4", 1), ("leaf4", "spine3", "spine4", 2)]:
        add_link(f, leaf, "ethernet-1/49", p1, "ethernet-1/{port}")
        add_link(f, leaf, "ethernet-1/50", p2, "ethernet-1/{port}")
    # Spine to super-spine, within a plane
    add_link(f, "spine1", "ethernet-1/31", "superspine1", "ethernet-1/1")
    add_link(f, "spine3", "ethernet-1/31", "superspine1", "ethernet-1/2")
    add_link(f, "spine2", "ethernet-1/31", "superspine2", "ethernet-1/1")
    add_link(f, "spine4", "ethernet-1/31", "superspine2", "ethernet-1/2")
    add_servers(f)
    return root

# The five-stage Clos of the fabric-5stage-mixed lab, cut down to fit five
# switches: one plane and two pods with one leaf and one spine each. Every role
# runs on EOS, and it has every kind of link between the vendors: EOS to SR
# Linux (leaf1 to spine1), SR Linux to EOS (leaf2 to spine2, spine1 to
# superspine1) and EOS to EOS (spine2 to superspine1).
def five_stage_mixed():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf", pod="pod-1", device_type=EOS, management_address="172.31.37.11/24", management_gateway="172.31.37.1")
    add_switch(f, "leaf2", 2, "leaf", pod="pod-2")
    add_switch(f, "spine1", 11, "spine", pod="pod-1", plane="plane-1")
    add_switch(f, "spine2", 12, "spine", pod="pod-2", plane="plane-1", device_type=EOS, management_address="172.31.37.22/24", management_gateway="172.31.37.1")
    add_switch(f, "superspine1", 21, "super-spine", plane="plane-1", device_type=EOS, management_address="172.31.37.31/24", management_gateway="172.31.37.1")
    add_link(f, "leaf1", "Ethernet49", "spine1", "ethernet-1/1")
    add_link(f, "leaf2", "ethernet-1/49", "spine2", "Ethernet1")
    add_link(f, "spine1", "ethernet-1/31", "superspine1", "Ethernet1")
    add_link(f, "spine2", "Ethernet31", "superspine1", "Ethernet2")
    add_server(f, "server1", "dual-homed", [("leaf1", "Ethernet1", "eth1"), ("leaf2", "ethernet-1/1", "eth2")])
    add_server(f, "server2", "single-homed", [("leaf2", "ethernet-1/2", "eth1")])
    add_server(f, "server3", "single-homed", [("leaf1", "Ethernet2", "eth1")])
    return root

def five_stage_overlay():
    root = five_stage()
    add_overlay(root.ip_fabric.fabric.get("dc1")!)
    return root

# The five-stage Clos of the fabric-5stage-srl lab: the shape of
# fabric-5stage-mixed, all SR Linux, for the overlay through a super-spine.
# server1 is dual-homed across the pods, to leaf1 and leaf2, so its ethernet
# segment spans the super-spine too. server1 (tagged) and server3 (untagged)
# are in network t1/web, server2 in network t1/db, which VRF main routes to
# t1/web across the super-spine.
def five_stage_srl():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf", pod="pod-1")
    add_switch(f, "leaf2", 2, "leaf", pod="pod-2")
    add_switch(f, "spine1", 11, "spine", pod="pod-1", plane="plane-1")
    add_switch(f, "spine2", 12, "spine", pod="pod-2", plane="plane-1")
    add_switch(f, "superspine1", 21, "super-spine", plane="plane-1")
    add_link(f, "leaf1", "ethernet-1/49", "spine1", "ethernet-1/1")
    add_link(f, "leaf2", "ethernet-1/49", "spine2", "ethernet-1/1")
    add_link(f, "spine1", "ethernet-1/31", "superspine1", "ethernet-1/1")
    add_link(f, "spine2", "ethernet-1/31", "superspine1", "ethernet-1/2")
    add_server(f, "server1", "dual-homed", [("leaf1", "ethernet-1/1", "eth1"), ("leaf2", "ethernet-1/1", "eth2")])
    add_server(f, "server2", "single-homed", [("leaf2", "ethernet-1/2", "eth1")])
    add_server(f, "server3", "single-homed", [("leaf1", "ethernet-1/2", "eth1")])
    tenant = f.tenant.create("t1")
    tenant.vrf.create("main")
    tenant.network.create("web", vrf="main", gateway="10.10.10.1/24")
    tenant.network.create("db", vrf="main", gateway="10.10.20.1/24")
    f.server.get("server1")!.attachment.create(("t1", "web"), vlan=10, ipv4_address="10.10.10.11/24")
    f.server.get("server2")!.attachment.create(("t1", "db"), vlan=20, ipv4_address="10.10.20.12/24")
    f.server.get("server3")!.attachment.create(("t1", "web"), ipv4_address="10.10.10.13/24")
    return root

# The three-stage Clos of the fabric-3stage-crpd lab, all Juniper cRPD (ports
# ethN), the underlay only: cRPD bridges no server traffic yet, so the servers
# are single-homed. cRPD takes its management address from its container.
def three_stage_crpd():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf", device_type=CRPD)
    add_switch(f, "leaf2", 2, "leaf", device_type=CRPD)
    add_switch(f, "leaf3", 3, "leaf", device_type=CRPD)
    add_switch(f, "spine1", 11, "spine", device_type=CRPD)
    add_switch(f, "spine2", 12, "spine", device_type=CRPD)
    for n, leaf in enumerate(["leaf1", "leaf2", "leaf3"]):
        add_link(f, leaf, "eth49", "spine1", "eth{n + 1}")
        add_link(f, leaf, "eth50", "spine2", "eth{n + 1}")
    for n, leaf in enumerate(["leaf1", "leaf2", "leaf3"]):
        add_server(f, "server{n + 1}", "single-homed", [(leaf, "eth1", "eth1")])
    return root

# The three-stage Clos of the fabric-3stage-mixed-crpd lab, of all three
# vendors, the underlay only: leaf1 SR Linux, leaf2 and spine2 Arista EOS,
# leaf3 and spine1 Juniper cRPD. Its links are SR Linux to cRPD and to EOS,
# EOS to cRPD and to EOS, and cRPD to cRPD and to EOS.
def three_stage_mixed_crpd():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf")
    add_switch(f, "leaf2", 2, "leaf", device_type=EOS, management_address="172.31.40.12/24", management_gateway="172.31.40.1")
    add_switch(f, "leaf3", 3, "leaf", device_type=CRPD)
    add_switch(f, "spine1", 11, "spine", device_type=CRPD)
    add_switch(f, "spine2", 12, "spine", device_type=EOS, management_address="172.31.40.22/24", management_gateway="172.31.40.1")
    add_link(f, "leaf1", "ethernet-1/49", "spine1", "eth1")
    add_link(f, "leaf1", "ethernet-1/50", "spine2", "Ethernet1")
    add_link(f, "leaf2", "Ethernet49", "spine1", "eth2")
    add_link(f, "leaf2", "Ethernet50", "spine2", "Ethernet2")
    add_link(f, "leaf3", "eth49", "spine1", "eth3")
    add_link(f, "leaf3", "eth50", "spine2", "Ethernet3")
    add_server(f, "server1", "single-homed", [("leaf1", "ethernet-1/1", "eth1")])
    add_server(f, "server2", "single-homed", [("leaf2", "Ethernet1", "eth1")])
    add_server(f, "server3", "single-homed", [("leaf3", "eth1", "eth1")])
    return root

# The EVPN-VXLAN overlay of the fabric-3stage-mixed-crpd lab: network t1/web
# joins a server on each leaf, all tagged with VLAN 30, across SR Linux (leaf1),
# Arista EOS (leaf2) and Juniper cRPD (leaf3). leaf3 sends its EVPN routes from
# its loopback to those of both spines, cRPD (spine1) and EOS (spine2).
def three_stage_mixed_crpd_overlay():
    root = three_stage_mixed_crpd()
    f = root.ip_fabric.fabric.get("dc1")!
    f.tenant.create("t1").network.create("web")
    f.server.get("server1")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.11/24")
    f.server.get("server2")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.12/24")
    f.server.get("server3")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.13/24")
    return root

# The three-stage Clos of the fabric-3stage-mixed-n9kv lab, the underlay
# only: leaf1 and spine2 SR Linux, leaf2, leaf3 and spine1 Cisco NX-OS
# (Nexus 9300v), which renders every physical port, as NX-OS cannot delete
# one. NX-OS keeps its management address in configuration dorsi owns.
def three_stage_mixed_n9kv():
    root = _empty_root()
    f = root.ip_fabric.fabric.create("dc1")
    add_switch(f, "leaf1", 1, "leaf")
    add_switch(f, "leaf2", 2, "leaf", device_type=NXOS, management_address="172.31.42.12/24", management_gateway="172.31.42.1")
    add_switch(f, "leaf3", 3, "leaf", device_type=NXOS, management_address="172.31.42.13/24", management_gateway="172.31.42.1")
    add_switch(f, "spine1", 11, "spine", device_type=NXOS, management_address="172.31.42.21/24", management_gateway="172.31.42.1")
    add_switch(f, "spine2", 12, "spine")
    add_link(f, "leaf1", "ethernet-1/49", "spine1", "eth1/1")
    add_link(f, "leaf1", "ethernet-1/50", "spine2", "ethernet-1/1")
    add_link(f, "leaf2", "eth1/1", "spine1", "eth1/2")
    add_link(f, "leaf2", "eth1/2", "spine2", "ethernet-1/2")
    add_link(f, "leaf3", "eth1/1", "spine1", "eth1/3")
    add_link(f, "leaf3", "eth1/2", "spine2", "ethernet-1/3")
    return root

# The EVPN-VXLAN overlay of the fabric-3stage-mixed-n9kv lab: network t1/web
# joins server1 on leaf1 (SR Linux) and server3 on leaf3 (Cisco NX-OS),
# tagged with VLAN 30, and network t1/db server2 and server3, on the NX-OS
# leaves, untagged, in the internal VLAN of the network there. NX-OS bridges
# web in VLAN 30, the tag of its servers.
def three_stage_mixed_n9kv_overlay():
    root = three_stage_mixed_n9kv()
    f = root.ip_fabric.fabric.get("dc1")!
    tenant = f.tenant.create("t1")
    tenant.network.create("web")
    tenant.network.create("db")
    add_server(f, "server1", "single-homed", [("leaf1", "ethernet-1/1", "eth1")])
    add_server(f, "server2", "single-homed", [("leaf2", "eth1/3", "eth1")])
    add_server(f, "server3", "single-homed", [("leaf3", "eth1/3", "eth1")])
    f.server.get("server1")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.11/24")
    f.server.get("server3")!.attachment.create(("t1", "web"), vlan=30, ipv4_address="10.10.10.13/24")
    f.server.get("server2")!.attachment.create(("t1", "db"), ipv4_address="10.20.20.12/24")
    f.server.get("server3")!.attachment.create(("t1", "db"), ipv4_address="10.20.20.13/24")
    return root

# The same, with both networks routed in VRF t1/main
def three_stage_mixed_n9kv_routed():
    root = three_stage_mixed_n9kv_overlay()
    tenant = root.ip_fabric.fabric.get("dc1")!.tenant.get("t1")!
    tenant.vrf.create("main")
    web = tenant.network.get("web")!
    web.vrf = "main"
    web.gateway = "10.10.10.1/24"
    db = tenant.network.get("db")!
    db.vrf = "main"
    db.gateway = "10.20.20.1/24"
    return root

# TransformTester takes its snapshot as soon as the CFS commit completes, which
# can be before the device configuration exists. Wait for it to settle: until
# the snapshot has not changed for two seconds. On a busy machine a device can
# get its configuration in parts, with a pause between them while the mock
# device connects, so a fixed or shorter wait can catch it half done.
proc def FabricTester(t: testing.AsyncT, input_config: gdata.Node):
    tr = swts.TestRig.build(sysspec.SYSSPEC, t.log_handler)
    FabricTesterActor(t, input_config, tr)


actor FabricTesterActor(t: testing.AsyncT, input_config: gdata.Node, tr: swts.TestRig):
    var last: ?str = None
    var unchanged = 0

    def snapshot():
        current = tr.device_adata_snapshot()
        if current == last:
            unchanged += 1
            if unchanged >= 2:
                t.success(current)
                return
        else:
            last = current
            unchanged = 0
        after 1.0: snapshot()

    def cont(r: value):
        if isinstance(r, Exception):
            t.failure(r)
            return
        after 1.0: snapshot()

    proc def __startup__():
        tr.edit_config(input_config, cont, 0)

actor _test_fabric_three_stage(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, three_stage().to_gdata())

actor _test_fabric_three_stage_overlay(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, three_stage_overlay().to_gdata())

actor _test_fabric_five_stage_overlay(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, five_stage_overlay().to_gdata())

actor _test_fabric_five_stage_srl(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, five_stage_srl().to_gdata())

actor _test_fabric_three_stage_mixed_overlay(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, three_stage_mixed_overlay().to_gdata())

actor _test_fabric_three_stage_mixed(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, three_stage_mixed().to_gdata())

actor _test_fabric_five_stage(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, five_stage().to_gdata())

actor _test_fabric_five_stage_mixed(t: testing.AsyncT):
    proc def __startup__():
        t.timeout(30.0)
        FabricTester(t, five_stage_mixed().to_gdata())

# An invalid fabric is rejected as a whole, with the problems listed.
actor _test_fabric_invalid_is_rejected(t: testing.AsyncT):
    def cont(r: value):
        if isinstance(r, Exception):
            t.success("rejected: {r}")
        else:
            t.failure(ValueError("the invalid fabric was accepted"))

    proc def __startup__():
        t.timeout(5.0)
        root = three_stage()
        f = root.ip_fabric.fabric.get("dc1")!
        add_server(f, "bad", "single-homed", [("spine1", "ethernet-1/9", "eth1")])
        tr = swts.TestRig.build(sysspec.SYSSPEC, t.log_handler)
        tr.edit_config(root.to_gdata(), cont, 0)

actor _test_fabric_three_stage_crpd(t: testing.AsyncT):
