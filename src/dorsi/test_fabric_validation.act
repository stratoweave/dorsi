import testing

import dorsi.cfs as cfs
import dorsi.layers.y_0 as cfs_layer
import dorsi.test_fabric as fabrics

def _fabric(root: cfs_layer.root) -> cfs_layer.ip_fabric__ip_fabric__fabric_entry:
    return root.ip_fabric.fabric.get("dc1")!

def _single_error(f: cfs_layer.ip_fabric__ip_fabric__fabric_entry, text: str):
    errors = cfs.validate_fabric(f)
    testing.assertEqual(len(errors), 1, "expected one error: {errors}")
    testing.assertTrue(text in errors[0], "'{text}' not in '{errors[0]}'")

def _has_error(f: cfs_layer.ip_fabric__ip_fabric__fabric_entry, text: str):
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any([text in e for e in errors]), "'{text}' not in {errors}")

def _test_valid_three_stage():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.three_stage())), [])

def _test_valid_five_stage():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.five_stage())), [])

def _test_valid_three_stage_mixed():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.three_stage_mixed())), [])

def _test_eos_without_management_address():
    f = _fabric(fabrics.three_stage_mixed())
    sw = f.switch.get("leaf3")!
    sw.management_address = None
    sw.management_gateway = None
    _single_error(f, "a AristaEOS_4_36_3_2M switch needs a management-address")

def _test_management_address_required():
    f = _fabric(fabrics.three_stage())
    sw = f.switch.get("leaf1")!
    sw.type = "CiscoIosXr_25_3_1"
    _single_error(f, "a CiscoIosXr_25_3_1 switch needs a management-address")

def _test_management_address_without_prefix_length():
    f = _fabric(fabrics.three_stage())
    sw = f.switch.get("leaf1")!
    sw.management_address = "172.31.36.11"
    _single_error(f, "not an IPv4 address with a prefix length")

def _test_management_address_out_of_range():
    f = _fabric(fabrics.three_stage())
    sw = f.switch.get("leaf1")!
    sw.management_address = "172.31.36.256/24"
    _single_error(f, "not an IPv4 address with a prefix length")

def _test_valid_five_stage_mixed():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.five_stage_mixed())), [])

def _test_management_gateway_not_an_address():
    f = _fabric(fabrics.three_stage_mixed())
    sw = f.switch.get("leaf3")!
    sw.management_gateway = "172.31.36.1/24"
    _single_error(f, "management-gateway 172.31.36.1/24 is not an IPv4 address")

def _test_management_gateway_without_address():
    f = _fabric(fabrics.three_stage())
    sw = f.switch.get("leaf1")!
    sw.management_gateway = "172.31.36.1"
    _single_error(f, "a management-gateway needs a management-address")

def _test_duplicate_switch_id():
    f = _fabric(fabrics.three_stage())
    fabrics.add_switch(f, "leaf4", 1, "leaf")
    _single_error(f, "have the same id 1")

def _test_switch_id_too_large():
    f = _fabric(fabrics.three_stage())
    fabrics.add_switch(f, "leaf4", 512, "leaf")
    _single_error(f, "above 511")

def _test_link_to_missing_switch():
    f = _fabric(fabrics.three_stage())
    fabrics.add_link(f, "leaf1", "ethernet-1/48", "spine9", "ethernet-1/1")
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any(["switch spine9 does not exist" in e for e in errors]), "{errors}")

def _test_link_between_leaves():
    f = _fabric(fabrics.three_stage())
    fabrics.add_link(f, "leaf1", "ethernet-1/48", "leaf2", "ethernet-1/48")
    _single_error(f, "not a leaf to a leaf")

def _test_link_leaf_and_spine_in_different_pods():
    f = _fabric(fabrics.five_stage())
    sw = f.switch.get("leaf1")!
    sw.pod = "pod-2"
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any(["leaf leaf1 is in pod-2 and spine spine1 in pod-1" in e for e in errors]), "{errors}")

def _test_link_spine_and_super_spine_in_different_planes():
    f = _fabric(fabrics.five_stage())
    sw = f.switch.get("superspine1")!
    sw.plane = "plane-2"
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any(["spine spine1 is in plane-1 and super-spine superspine1 in plane-2" in e for e in errors]), "{errors}")

def _test_port_used_twice():
    f = _fabric(fabrics.three_stage())
    fabrics.add_link(f, "leaf1", "ethernet-1/49", "spine2", "ethernet-1/9")
    _single_error(f, "leaf1 port ethernet-1/49 is used by both")

def _test_lower_port_number_too_large():
    f = _fabric(fabrics.three_stage())
    fabrics.add_link(f, "leaf1", "ethernet-1/64", "spine1", "ethernet-1/9")
    _single_error(f, "below 64")

def _test_super_spine_plane_without_spines():
    f = _fabric(fabrics.five_stage())
    fabrics.add_switch(f, "superspine3", 23, "super-spine", plane="plane-3")
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any(["pod-1 has no spine in plane-3" in e for e in errors]), "{errors}")
    testing.assertTrue(any(["pod-2 has no spine in plane-3" in e for e in errors]), "{errors}")

def _test_spine_plane_without_super_spine():
    f = _fabric(fabrics.five_stage())
    fabrics.add_switch(f, "spine5", 15, "spine", pod="pod-1", plane="plane-3")
    errors = cfs.validate_fabric(f)
    testing.assertTrue(any(["no super-spine in plane-3" in e for e in errors]), "{errors}")

def _test_dual_homed_server_on_one_leaf():
    f = _fabric(fabrics.three_stage())
    fabrics.add_server(f, "bad", "dual-homed", [("leaf1", "ethernet-1/3", "eth1"), ("leaf1", "ethernet-1/4", "eth2")])
    _single_error(f, "a dual-homed server links to two leaves, not 1")

def _test_single_homed_server_on_two_leaves():
    f = _fabric(fabrics.three_stage())
    fabrics.add_server(f, "bad", "single-homed", [("leaf1", "ethernet-1/3", "eth1"), ("leaf2", "ethernet-1/3", "eth2")])
    _single_error(f, "a single-homed server links to one leaf, not 2")

def _test_server_on_spine():
    f = _fabric(fabrics.three_stage())
    fabrics.add_server(f, "bad", "single-homed", [("spine1", "ethernet-1/9", "eth1")])
    _single_error(f, "spine1 is a spine, a server links to a leaf")

def _test_server_port_on_a_fabric_port():
    f = _fabric(fabrics.three_stage())
    fabrics.add_server(f, "bad", "single-homed", [("leaf1", "ethernet-1/49", "eth1")])
    _single_error(f, "leaf1 port ethernet-1/49 is used by both")

def _test_server_port_used_twice():
    f = _fabric(fabrics.three_stage())
    fabrics.add_server(f, "bad", "dual-homed", [("leaf1", "ethernet-1/3", "eth1"), ("leaf2", "ethernet-1/3", "eth1")])
    _single_error(f, "more than one link")

# --- EVPN-VXLAN overlay ---------------------------------------------------------

def _test_valid_three_stage_overlay():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.three_stage_overlay())), [])

def _test_valid_five_stage_overlay():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.five_stage_overlay())), [])

def _test_valid_five_stage_srl():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.five_stage_srl())), [])

def _test_overlay_identifiers_are_stable():
    # The placeholder allocation is a pure function of the names
    testing.assertEqual(cfs.overlay_vni("dc1", "t1", "web"), cfs.overlay_vni("dc1", "t1", "web"))
    testing.assertNotEqual(cfs.overlay_vni("dc1", "t1", "web"), cfs.overlay_vni("dc1", "t1", "db"))
    testing.assertNotEqual(cfs.overlay_vni("dc1", "t1", "web"), cfs.overlay_vni("dc2", "t1", "web"))
    testing.assertEqual(cfs.server_esi("dc1", "server1"), cfs.server_esi("dc1", "server1"))
    testing.assertEqual(len(cfs.server_esi("dc1", "server1")), 29)
    testing.assertTrue(cfs.server_esi("dc1", "server1").startswith("00:"))
    testing.assertEqual(len(cfs.server_lacp_system_id("dc1", "server1")), 17)
    testing.assertTrue(cfs.server_lacp_system_id("dc1", "server1").startswith("02:"))
    testing.assertEqual(cfs.server_lag_name(["ethernet-1/7", "ethernet-1/3"], "NokiaSRLinux_25_3_2"), "lag3")
    testing.assertEqual(cfs.server_lag_name(["Ethernet7", "Ethernet3"], "AristaEOS_4_36_3_2M"), "Port-Channel3")

def _test_overlay_vni_clash():
    f = _fabric(fabrics.three_stage_overlay())
    vni = cfs.overlay_vni("dc1", "t1", "web")
    db = f.tenant.get("t1")!.network.get("db")!
    db.vni = u64(vni)
    _has_error(f, "VNI {vni} is also used by network t1/web")
    _has_error(f, "EVI {cfs.overlay_evi(vni)}, derived from VNI {vni}, is also used by network t1/web")

def _test_overlay_vni_set_resolves_clash():
    f = _fabric(fabrics.three_stage_overlay())
    db = f.tenant.get("t1")!.network.get("db")!
    db.vni = u64(20)
    testing.assertEqual(cfs.validate_fabric(f), [])

def _test_overlay_unknown_network():
    f = _fabric(fabrics.three_stage_overlay())
    f.server.get("server3")!.attachment.create(("t1", "app"), vlan=30)
    _single_error(f, "network t1/app does not exist")

def _test_overlay_vlan_used_twice():
    f = _fabric(fabrics.three_stage_overlay())
    f.server.get("server1")!.attachment.create(("t1", "db"), vlan=10)
    _single_error(f, "networks t1/web and t1/db are both on VLAN 10")

def _test_overlay_address_outside_subnet():
    f = _fabric(fabrics.three_stage_overlay())
    att = f.server.get("server3")!.attachment.get(("t1", "web"))!
    att.ipv4_address = "10.10.11.13/24"
    _has_error(f, "is not in the subnet of server server1 in network t1/web")

def _test_valid_three_stage_mixed_overlay():
    testing.assertEqual(cfs.validate_fabric(_fabric(fabrics.three_stage_mixed_overlay())), [])

def _test_overlay_dual_homed_on_eos_rejected():
    f = _fabric(fabrics.three_stage_mixed())
    f.tenant.create("t1").network.create("web")
    f.server.get("server2")!.attachment.create(("t1", "web"), vlan=10)
    _single_error(f, "server server2: a dual-homed server is an ethernet segment, which dorsi cannot configure on leaf3")

def _test_overlay_server_tag_is_an_internal_vlan():
    f = _fabric(fabrics.three_stage_mixed_overlay())
    f.tenant.get("t1")!.network.create("db")
    vlan = cfs.overlay_vlan(cfs.overlay_vni("dc1", "t1", "db"))
    att = f.server.get("server3")!.attachment.get(("t1", "web"))!
    att.vlan = u64(vlan)
    _single_error(f, "server server3: its VLAN {vlan} on leaf3 is the internal VLAN of network t1/db")

def _test_overlay_routed_network_on_eos_rejected():
    f = _fabric(fabrics.three_stage_mixed_overlay())
    tenant = f.tenant.get("t1")!
    tenant.vrf.create("main")
    web = tenant.network.get("web")!
    web.vrf = "main"
    web.gateway = "10.10.10.1/24"
    _single_error(f, "network t1/web: a routed network cannot be placed on leaf3")

def _test_overlay_network_name_srl_rejects():
    f = _fabric(fabrics.three_stage_overlay())
    f.tenant.get("t1")!.network.create("a/b")
    _single_error(f, "its MAC-VRF name t1-a/b is not a name SR Linux takes")

def _test_overlay_es_name_too_long():
    f = _fabric(fabrics.three_stage_overlay())
    long = "server-with-a-name-of-thirty-chars"
    fabrics.add_server(f, long, "dual-homed", [("leaf1", "ethernet-1/3", "eth1"), ("leaf2", "ethernet-1/3", "eth2")])
    f.server.get(long)!.attachment.create(("t1", "web"), vlan=10)
    _single_error(f, "its ethernet segment es-{long} is not a name SR Linux takes")

def _test_overlay_gateway_without_vrf():
    f = _fabric(fabrics.three_stage_overlay())
    f.tenant.get("t1")!.network.create("app", gateway="10.10.30.1/24")
    _single_error(f, "network t1/app: a gateway needs a vrf")

def _test_overlay_vrf_does_not_exist():
    f = _fabric(fabrics.three_stage_overlay())
    f.tenant.get("t1")!.network.create("app", vrf="other", gateway="10.10.30.1/24")
    _single_error(f, "network t1/app: VRF other does not exist in tenant t1")

def _test_overlay_vrf_network_without_gateway():
    f = _fabric(fabrics.three_stage_overlay())
    f.tenant.get("t1")!.network.create("app", vrf="main")
    _single_error(f, "network t1/app: a network in a VRF needs a gateway")

def _test_overlay_overlapping_subnets():
    f = _fabric(fabrics.three_stage_overlay())
    f.tenant.get("t1")!.network.create("app", vrf="main", gateway="10.10.0.1/16")
    _has_error(f, "network t1/app: its subnet overlaps that of network t1/web in VRF main")

def _test_overlay_server_on_the_gateway():
    f = _fabric(fabrics.three_stage_overlay())
    att = f.server.get("server3")!.attachment.get(("t1", "web"))!
    att.ipv4_address = "10.10.10.1/24"
    _single_error(f, "server server3: address 10.10.10.1 is the gateway of network t1/web")

def _test_overlay_server_outside_the_gateway_subnet():
    f = _fabric(fabrics.three_stage_overlay())
    att = f.server.get("server2")!.attachment.get(("t1", "db"))!
    att.ipv4_address = "10.10.21.12/24"
    _single_error(f, "server server2: address 10.10.21.12/24 is not in the subnet of gateway 10.10.20.1/24 of network t1/db")

def _test_overlay_vrf_vni_is_apart_from_network_vnis():
    testing.assertTrue(cfs.overlay_l3_vni("dc1", "t1", "main") >= 1000000)
    testing.assertTrue(cfs.overlay_vni("dc1", "t1", "main") < 1000000)

# The lift subscribes to the state of the networks and VRFs where these say
# they are placed; the transform places them on the same leaves (see the
# fabric_three_stage_overlay snapshot)
def _test_overlay_placement():
    f = _fabric(fabrics.three_stage_overlay())
    tenant = f.tenant.get("t1")!
    testing.assertEqual(cfs.network_leaves(f, "t1", "web"), ["leaf1", "leaf2", "leaf3"])
    testing.assertEqual(cfs.network_leaves(f, "t1", "db"), ["leaf2", "leaf3"])
    testing.assertEqual(cfs.vrf_leaves(f, tenant, "main"), ["leaf1", "leaf2", "leaf3"])
