    list(generated_device_types.items()) + list(sw_device_types.device_types.items())
)

SYSSPEC = swapp.SysSpec(device_types, get_layers, schema_for_layer, oper_schema_for_layer, src_yang_for_layer,
                        sw_device_types.platform_probes)
