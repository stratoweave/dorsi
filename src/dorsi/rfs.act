def _link_description(remote_device: str, remote_interface: str) -> str:
    return "Link to {remote_device} [{remote_interface}]"


# --- IP fabric ----------------------------------------------------------------
# Underlay of an IP fabric as described in RFC 7938: eBGP on every routed
# point-to-point link, ECMP across all equal-cost paths and the loopback of
# every switch advertised into BGP.
_FABRIC_GROUP = "fabric"
_FABRIC_EXPORT_POLICY = "export-loopbacks"
_FABRIC_IMPORT_POLICY = "accept-all"
_FABRIC_LOOPBACK_PREFIX_SET = "loopbacks"
_FABRIC_ECMP_PATHS = 64
# IP MTU of the fabric links. VXLAN adds 50 bytes to every frame of the
# overlay, so with the default of 1500 a server could send no frame over 1450
# bytes across the fabric. SR Linux ports have an MTU of 9232 by default.
_FABRIC_IP_MTU = 9000
# The MAC address of the anycast gateways, the same on every leaf of every
# vendor. Arista EOS refuses the 00:00:5e:00:01:xx that SR Linux derives
# from the virtual router ID, a VRRP address, so it is set explicitly.
_ANYCAST_GW_MAC = "02:dc:00:00:00:01"
# The VXLAN tunnel interface of Arista EOS and its source, the loopback
_EOS_VXLAN_INTERFACE = "Vxlan1"
_EOS_LOOPBACK = "Loopback0"
_VXLAN_UDP_PORT = 4789
# The eBGP sessions between loopbacks that carry the EVPN routes of a Juniper
# cRPD leaf (see overlay-peer), and the TTL of their packets: leaf and spine
# are one link apart
_OVERLAY_GROUP = "overlay"
_OVERLAY_MAX_HOPS = 2

# Arista EOS is configured through OpenConfig. SR Linux can serve OpenConfig
# too, so EOS is told apart by a module only EOS has.
_EOS_MODULE = "arista-netinst-augments"

# Cisco NX-OS (Nexus 9300v) is configured through its native model
_NXOS_MODULE = "Cisco-NX-OS-device"

# The physical ports of a Nexus 9300v (nexus9300v64), eth1/1 to eth1/64.
# NX-OS refuses to delete a physical port ("Cannot delete object of
# class:l1PhysIf") and reports the layer, MTU and admin state of every port,
# also when they are the defaults. dorsi owns these, so the base config
# renders every port: a fabric port routed, any other with the defaults
# NX-OS reports. Only one transform may set them, as two that differ do not
# merge.
_NXOS_PHYSICAL_PORTS = 64
_NXOS_LOOPBACK = "lo0"
_NXOS_MGMT_INTERFACE = "mgmt0"
_NXOS_MGMT_VRF = "management"
_NXOS_DEFAULT_VRF = "default"
# NX-OS makes this BGP domain of its own with the first BGP configuration,
# with an IPv4 unicast address family, and would have it deleted otherwise
_NXOS_BGP_INTERNAL_DOMAIN = "egress-loadbalance-resolution-"
_NXOS_IPV4_UNICAST = "ipv4-ucast"
# NX-OS applies the layer, MTU and admin state of a port set over NETCONF
# only with these flags
_NXOS_ROUTED_PORT_FLAGS = "admin_layer,admin_mtu,admin_state"
_NXOS_L2VPN_EVPN = "l2vpn-evpn"
# The VTEP, nve1
_NXOS_VTEP = 1
# A spine passes the EVPN routes on with the next hop of the leaf that sent
# them, its VTEP
_NXOS_EVPN_NEXT_HOP_POLICY = "evpn-next-hop-unchanged"

def nxos_physical_ports() -> list[str]:
    return ["eth1/{n}" for n in range(1, _NXOS_PHYSICAL_PORTS + 1)]

def _nxos_ipv4_address(dev: nxos1064.root, vrf: str, interface: str, address: str):
    """address with its prefix length, as 10.0.0.1/32"""
    dom = dev.System.ipv4_items.inst_items.dom_items.Dom_list.create(vrf)
    dom.if_items.If_list.create(interface).addr_items.Addr_list.create(address)

def _nxos_bgp_domain(dev: nxos1064.root, name: str):
    return dev.System.bgp_items.inst_items.dom_items.Dom_list.create(name)

def _nxos_vrf(dev: nxos1064.root, name: str):
    """A VRF with its domain, of the same name"""
    vrf = dev.System.inst_items.Inst_list.create(name)
    vrf.dom_items.Dom_list.create(name)
    return vrf

def _nxos_svi(dev: nxos1064.root, vlan: int, vrf: str) -> str:
    """The VLAN interface of a VLAN, up, in a VRF. Returns its name."""
    name = "vlan{vlan}"
    svi = dev.System.intf_items.svi_items.If_list.create(name)
    svi.adminSt = "up"
    svi.rtvrfMbr_items.tDn = "/System/inst-items/Inst-list[name='{vrf}']"
    return name

def _nxos_route_map(dev: nxos1064.root, name: str):
    """A route map with a single permit entry"""
    entry = dev.System.rpm_items.rtmap_items.Rule_list.create(name).ent_items.Entry_list.create(u64(10))
    entry.action_ = "permit"
    return entry


def nxos_vlan(vlan: int) -> str:
    """A VLAN as NX-OS names it in its native model, such as vlan-30."""
    return "vlan-{vlan}"


def nxos_vlan_list(vlans: list[int]) -> str:
    """VLANs as NX-OS writes the VLANs of a trunk: in order, with the runs
    of consecutive VLANs as ranges, such as 10-12,30."""
    parts: list[str] = []
    ordered = sorted(vlans)
    k = 0
    while k < len(ordered):
        first = ordered[k]
        last = first
        while k + 1 < len(ordered) and ordered[k + 1] <= last + 1:
            k += 1
            last = ordered[k]
        parts.append(str(first) if first == last else "{first}-{last}")
        k += 1
    return ",".join(parts)


def nxos_route_target(rt: str) -> str:
    """A route target such as target:100:10030 as NX-OS has it:
    route-target:as2-nn2:100:10030, as2-nn4 for a number above 65535."""
    value = rt[len("target:"):] if rt.startswith("target:") else rt
    parts = value.split(":")
    kind = "as2-nn2" if int(parts[1]) <= 65535 else "as2-nn4"
    return "route-target:{kind}:{value}"


def nxos_route_distinguisher(rd: str) -> str:
    """A route distinguisher such as 10.0.0.3:30 as NX-OS has it:
    rd:ipv4-nn2:10.0.0.3:30."""
    return "rd:ipv4-nn2:{rd}"


# The VRF of Management0 on EOS. In the default VRF the management default
# route would carry fabric traffic whenever the fabric has no route for it.
# Moving Management0 between VRFs drops its address and the NETCONF session,
# so the switch has to start with it (see ceos-startup.partial.cfg in the
# labs); dorsi only keeps it there.
_EOS_MGMT_VRF = "MGMT"

# Juniper cRPD is configured through the native Junos model, which only Junos
# has. cRPD routes for the Linux of its container: what it is configured with
# becomes Linux addresses, MTUs and routes. Its management address comes from
# the container and is not in its configuration.
_CRPD_MODULE = "junos-conf-root"
_CRPD_LOOPBACK = "lo0"
# The policy that puts every equal-cost path of a route into the forwarding
# table; without it Junos installs one
_CRPD_ECMP_POLICY = "ecmp"


def _crpd_ipv4_address(dev: crpd244.root, name: str, address: str, description: ?str):
    """An address on unit 0 of an interface, address/prefix-length."""
    unit = dev.configuration.interfaces.interface.create(name).unit.create("0")
    unit.description = description
    unit.family.create_inet().address.create(address)


def _crpd_accept_term(dev: crpd244.root, policy: str, term: str):
    """A term of a policy that accepts the routes it matches."""
    t = dev.configuration.policy_options.policy_statement.create(policy).term.create(term)
    t.then.accept = True
    return t


def _overlay_description(device: ?str) -> str:
    return "Overlay to {device}" if device is not None else "Overlay"


def _eos_default_ni(dev: eos436.root):
    ni = dev.network_instances.network_instance.create("default")
    ni.config.name = "default"
    ni.config.type = eos436.openconfig_network_instance_types_DEFAULT_INSTANCE
    return ni


def _eos_bgp(ni):
    proto = ni.protocols.protocol.create((eos436.openconfig_policy_types_BGP, "BGP"))
    proto.config.identifier = eos436.openconfig_policy_types_BGP
    proto.config.name = "BGP"
    return proto.bgp


def _eos_interface(dev: eos436.root, name: str, if_type, description: ?str):
    intf = dev.interfaces.interface.create(name)
    intf.config.name = name
    intf.config.type = if_type
    intf.config.description = description
    intf.config.enabled = True
    return intf


def _eos_ipv4_address(intf, address: str, prefix_length: u64, description: ?str):
    """An address on subinterface 0, which makes an Ethernet port a routed
    port (no switchport)."""
    subif = intf.subinterfaces.subinterface.create(0)
    subif.config.index = 0
    subif.config.description = description
    subif.config.enabled = True
    subif.ipv4.config.enabled = True
    addr = subif.ipv4.addresses.address.create(address)
    addr.config.ip = address
    addr.config.prefix_length = prefix_length


def _eos_lldp_interface(dev: eos436.root, name: str):
    lldp_if = dev.lldp.interfaces.interface.create(name)
    lldp_if.config.name = name
    lldp_if.config.enabled = True


def _eos_policy(dev: eos436.root, name: str):
    """A policy of one statement '10' that accepts the routes it matches.
    EOS turns it into an RCF function."""
    policy = dev.routing_policy.policy_definitions.policy_definition.create(name)
    policy.config.name = name
    statement = policy.statements.statement.create("10")
    statement.config.name = "10"
    statement.actions.config.policy_result = "ACCEPT_ROUTE"
    return statement

def eos_dynamic_vlan_interfaces(names: list[str]) -> list[str]:
    """The VLAN interfaces among names that only EOS makes: those of a VLAN
    above 4094, which EOS takes for the layer 3 VNI of a VRF."""
    found: list[str] = []
    for name in names:
        if name.startswith("Vlan"):
            number = name[len("Vlan"):]
            if number.isdecimal() and int(number) > 4094:
                found.append(name)
    return sorted(found)


class FabricBaseConfig(base.FabricBaseConfig):
    def transform(self, i, di, dynstate: ?FabricBaseConfigDynstate):
        print("RFS /rfs{{{di.name}}}/fabric-base-config transform running {i.role}", err=True)

        if "srl_nokia-system" in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-base-config transform running {i.role} for Nokia SRLinux", err=True)
            dev = srl25.root()
            dev.system.name.host_name = di.name

            # LLDP, globally and on the management port; fabric and server
            # ports enable it themselves
            lldp = dev.system.create_lldp(admin_state="enable")
            lldp.interface.create("mgmt0", admin_state="enable")

            # Loopback
            index = dev.interface.create("system0").subinterface.create(0)
            index.ipv4.admin_state = "enable"
            index.ipv4.address.create("{i.ipv4_address}/32")

            # Management; mgmt0 takes its address from DHCP, so the
            # management-address is not needed here
            intf_mgmt = dev.interface.create("mgmt0", admin_state="enable")
            intf_mgmt0 = intf_mgmt.subinterface.create(0, admin_state="enable")
            intf_mgmt0.ipv4.admin_state = "enable"
            intf_mgmt0.ipv6.admin_state = "enable"
            ni_mgmt = dev.network_instance.create("mgmt", type=srl25.srl_nokia_network_instance_ip_vrf, admin_state="enable", description="Management network instance")
            ni_mgmt.interface.create("mgmt0.0")

            # BGP with ECMP; the group carries the loopback export policy
            ni = dev.network_instance.create("default")
            ni.interface.create("system0.0")
            bgp = ni.protocols.create_bgp(autonomous_system=i.asn, router_id=i.ipv4_address)
            af = bgp.afi_safi.create(srl25.srl_nokia_common_ipv4_unicast, admin_state="enable")
            af.multipath.ebgp.maximum_paths = u64(_FABRIC_ECMP_PATHS)
            group = bgp.group.create(_FABRIC_GROUP)
            group.export_policy = [_FABRIC_EXPORT_POLICY]
            group.import_policy = [_FABRIC_IMPORT_POLICY]

            # Advertise the loopbacks and accept everything the fabric sends us
            rp = dev.routing_policy
            ps = rp.prefix_set.create(_FABRIC_LOOPBACK_PREFIX_SET)
            ps.prefix.create(("10.0.0.0/16", "32..32"))
            exp = rp.policy.create(_FABRIC_EXPORT_POLICY).statement.create("10")
            exp.match.prefix.prefix_set = _FABRIC_LOOPBACK_PREFIX_SET
            exp.action_.policy_result = "accept"
            rp.policy.create(_FABRIC_IMPORT_POLICY).statement.create("10").action_.policy_result = "accept"

            if i.evpn:
                # EVPN on the same eBGP sessions as the underlay. A spine
                # keeps the routes it imports into no network-instance and
                # passes them on; EVPN keeps the next hop, the VTEP of the
                # leaf that sent them. Updates and withdrawals go out at
                # once: held back by the advertisement interval, a link of a
                # multihomed server that goes down cuts its traffic for
                # seconds.
                af_evpn = bgp.afi_safi.create(srl25.srl_nokia_common_evpn, admin_state="enable")
                af_evpn.evpn.rapid_update = True
                if i.role != "leaf":
                    af_evpn.evpn.inter_as_vpn = True
                exp_evpn = rp.policy.create(_FABRIC_EXPORT_POLICY).statement.create("20")
                exp_evpn.match.family = [srl25.srl_nokia_common_evpn]
                exp_evpn.action_.policy_result = "accept"

            if len(i.overlay_peer) > 0:
                # EVPN only, between the loopbacks, with the policies of the
                # fabric
                overlay = bgp.group.create(_OVERLAY_GROUP)
                overlay.export_policy = [_FABRIC_EXPORT_POLICY]
                overlay.import_policy = [_FABRIC_IMPORT_POLICY]
                overlay.multihop.admin_state = "enable"
                overlay.multihop.maximum_hops = u64(_OVERLAY_MAX_HOPS)
                overlay.transport.local_address = i.ipv4_address
                overlay.afi_safi.create(srl25.srl_nokia_common_evpn, admin_state="enable")
                overlay.afi_safi.create(srl25.srl_nokia_common_ipv4_unicast, admin_state="disable")
                for peer in i.overlay_peer:
                    bgp.neighbor.create(peer.address, peer_group=_OVERLAY_GROUP, peer_as=peer.asn, admin_state="enable", description=_overlay_description(peer.device))

            return dev

        if _NXOS_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-base-config transform running {i.role} for Cisco NX-OS", err=True)
            dev = nxos1064.root()
            dev.System.name = di.name

            for port in nxos_physical_ports():
                phys = dev.System.intf_items.phys_items.PhysIf_list.create(port)
                if port in i.fabric_port:
                    phys.layer = "Layer3"
                    phys.mtu = u64(_FABRIC_IP_MTU)
                    phys.adminSt = "up"
                    phys.userCfgdFlags = _NXOS_ROUTED_PORT_FLAGS
                else:
                    phys.layer = "Layer2"
                    phys.mtu = u64(1500)
                    phys.adminSt = "up"
                    phys.userCfgdFlags = ""

            # Management. Its address is in the IPv4 configuration dorsi
            # manages, so it has to be in the target or dorsi removes it. The
            # default route of the management VRF is left as it is.
            mgmt = i.management_address
            if mgmt is not None:
                _nxos_ipv4_address(dev, _NXOS_MGMT_VRF, _NXOS_MGMT_INTERFACE, mgmt)

            # Loopback
            lo = dev.System.intf_items.lb_items.LbRtdIf_list.create(_NXOS_LOOPBACK)
            lo.adminSt = "up"
            _nxos_ipv4_address(dev, _NXOS_DEFAULT_VRF, _NXOS_LOOPBACK, "{i.ipv4_address}/32")

            # Advertise the loopbacks and accept everything the fabric sends us
            pl = dev.System.rpm_items.pfxlistv4_items.RuleV4_list.create(_FABRIC_LOOPBACK_PREFIX_SET)
            pl_entry = pl.ent_items.Entry_list.create(u64(5))
            pl_entry.action_ = "permit"
            pl_entry.criteria = "inexact"
            pl_entry.pfx = "10.0.0.0/16"
            pl_entry.fromPfxLen = u64(32)
            pl_entry.toPfxLen = u64(32)
            exp = _nxos_route_map(dev, _FABRIC_EXPORT_POLICY)
            exp.mrtdst_items.rsrtDstAtt_items.RsRtDstAtt_list.create("/System/rpm-items/pfxlistv4-items/RuleV4-list[name='{_FABRIC_LOOPBACK_PREFIX_SET}']")
            _nxos_route_map(dev, _FABRIC_IMPORT_POLICY)

            # BGP with ECMP. NX-OS advertises only routes in BGP: redistribute
            # the connected routes, of which the export policy lets only the
            # loopbacks out. The peer template carries the policies.
            dev.System.bgp_items.inst_items.asn = str(i.asn)
            dom = _nxos_bgp_domain(dev, _NXOS_DEFAULT_VRF)
            dom.rtrId = i.ipv4_address
            af = dom.af_items.DomAf_list.create(_NXOS_IPV4_UNICAST)
            af.maxExtEcmp = u64(_FABRIC_ECMP_PATHS)
            leak = af.interleak_items.InterLeakP_list.create(("direct", "none"))
            leak.asn = "none"
            leak.rtMap = _FABRIC_EXPORT_POLICY
            template = dom.peercont_items.PeerCont_list.create(_FABRIC_GROUP)
            template_af = template.af_items.PeerAf_list.create(_NXOS_IPV4_UNICAST)
            template_af.rtctrl_items.RtCtrlP_list.create("out").rtMap = _FABRIC_EXPORT_POLICY
            template_af.rtctrl_items.RtCtrlP_list.create("in").rtMap = _FABRIC_IMPORT_POLICY
            _nxos_bgp_domain(dev, _NXOS_BGP_INTERNAL_DOMAIN).af_items.DomAf_list.create(_NXOS_IPV4_UNICAST)

            # VLAN 1 and its VLAN interface, shut, and the VRFs NX-OS has of
            # its own, which it does not remove
            dev.System.bd_items.bd_items.BD_list.create(nxos_vlan(1))
            dev.System.intf_items.svi_items.If_list.create("vlan1").adminSt = "down"
            for vrf_name in [_NXOS_DEFAULT_VRF, _NXOS_MGMT_VRF, _NXOS_BGP_INTERNAL_DOMAIN]:
                _nxos_vrf(dev, vrf_name)

            if i.evpn:
                # EVPN on the same eBGP sessions as the underlay, with the
                # route targets, extended communities. A spine keeps the
                # routes it imports into no network and passes them on with
                # their next hop, the VTEP of the leaf that sent them.
                evpn_af = dom.af_items.DomAf_list.create(_NXOS_L2VPN_EVPN)
                template_evpn = template.af_items.PeerAf_list.create(_NXOS_L2VPN_EVPN)
                template_evpn.sendComExt = "enabled"
                if i.role != "leaf":
                    evpn_af.retainRttAll = "enabled"
                    nh = _nxos_route_map(dev, _NXOS_EVPN_NEXT_HOP_POLICY)
                    nh.nhpa_items.v4Unchange = "enabled"
                    template_evpn.rtctrl_items.RtCtrlP_list.create("out").rtMap = _NXOS_EVPN_NEXT_HOP_POLICY
                else:
                    # The VTEP on the loopback, flooding by ingress
                    # replication with EVPN routes of type 3
                    vtep = dev.System.eps_items.epId_items.Ep_list.create(u64(_NXOS_VTEP))
                    vtep.adminSt = "enabled"
                    vtep.hostReach = "bgp"
                    vtep.sourceInterface = _NXOS_LOOPBACK
                    # The MAC address of the anycast gateways, as NX-OS
                    # writes it
                    dev.System.hmm_items.fwdinst_items.amac = _ANYCAST_GW_MAC.upper()
            return dev

        if _EOS_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-base-config transform running {i.role} for Arista EOS", err=True)
            dev = eos436.root()
            dev.system.config.hostname = di.name
            dev.lldp.config.enabled = True

            # Management. Its address is in the interfaces dorsi manages, so it
            # has to be in the target or dorsi removes it.
            mgmt = i.management_address
            if mgmt is not None:
                # address/prefix-length, validated by the CFS
                parts: list[str] = mgmt.split("/")
                intf_mgmt = _eos_interface(dev, "Management0", eos436.iana_if_type_ethernetCsmacd, None)
                _eos_ipv4_address(intf_mgmt, parts[0], u64(int(parts[1])), None)
                ni_mgmt = dev.network_instances.network_instance.create(_EOS_MGMT_VRF)
                ni_mgmt.config.name = _EOS_MGMT_VRF
                ni_mgmt.config.type = eos436.openconfig_network_instance_types_L3VRF
                ni_mgmt_if = ni_mgmt.interfaces.interface.create("Management0")
                ni_mgmt_if.config.id = "Management0"
                ni_mgmt_if.config.interface = "Management0"
                ni_mgmt_if.config.subinterface = 0
                gateway = i.management_gateway
                if gateway is not None:
                    # The default route of the management VRF. EOS names a
                    # next hop AUTO_1_<address with dashes> and would rename
                    # any other.
                    static = ni_mgmt.protocols.protocol.create((eos436.openconfig_policy_types_STATIC, "STATIC"))
                    static.config.identifier = eos436.openconfig_policy_types_STATIC
                    static.config.name = "STATIC"
                    route = static.static_routes.static.create("0.0.0.0/0")
                    route.config.prefix = "0.0.0.0/0"
                    index = "AUTO_1_" + gateway.replace(".", "-")
                    next_hop = route.next_hops.next_hop.create(index)
                    next_hop.config.index = index
                    next_hop.config.next_hop = gateway

            # Loopback
            lo = _eos_interface(dev, "Loopback0", eos436.iana_if_type_softwareLoopback, None)
            _eos_ipv4_address(lo, i.ipv4_address, 32, None)

            # Routing is off on a fresh cEOS (no ip routing)
            ni = _eos_default_ni(dev)
            ni.config.ipv4_routing_enabled = True

            # BGP with ECMP; the group carries the loopback export policy
            bgp = _eos_bgp(ni)
            bgp.global.config.as_ = i.asn
            bgp.global.config.router_id = i.ipv4_address
            af = bgp.global.afi_safis.afi_safi.create(eos436.openconfig_bgp_types_IPV4_UNICAST)
            af.config.afi_safi_name = eos436.openconfig_bgp_types_IPV4_UNICAST
            af.config.enabled = True
            af.use_multiple_paths.ebgp.config.maximum_paths = u64(_FABRIC_ECMP_PATHS)
            group = bgp.peer_groups.peer_group.create(_FABRIC_GROUP)
            group.config.peer_group_name = _FABRIC_GROUP
            group.apply_policy.config.export_policy = [_FABRIC_EXPORT_POLICY]
            group.apply_policy.config.import_policy = [_FABRIC_IMPORT_POLICY]
            group_af = group.afi_safis.afi_safi.create(eos436.openconfig_bgp_types_IPV4_UNICAST)
            group_af.config.afi_safi_name = eos436.openconfig_bgp_types_IPV4_UNICAST
            group_af.config.enabled = True

            # EOS advertises only routes in BGP: redistribute the connected
            # routes, of which the export policy lets only the loopbacks out
            tc_key = (eos436.openconfig_policy_types_DIRECTLY_CONNECTED, eos436.openconfig_policy_types_BGP, eos436.openconfig_types_IPV4)
            tc = ni.table_connections.table_connection.create(tc_key)
            tc.config.src_protocol = eos436.openconfig_policy_types_DIRECTLY_CONNECTED
            tc.config.dst_protocol = eos436.openconfig_policy_types_BGP
            tc.config.address_family = eos436.openconfig_types_IPV4

            if i.evpn:
                # EVPN on the same eBGP sessions as the underlay; a spine or
                # super-spine keeps the next hop, the VTEP of the leaf
                af_evpn = bgp.global.afi_safis.afi_safi.create(eos436.openconfig_bgp_types_L2VPN_EVPN)
                af_evpn.config.afi_safi_name = eos436.openconfig_bgp_types_L2VPN_EVPN
                af_evpn.config.enabled = True
                if i.role != "leaf":
                    af_evpn.next_hop.config.preserve_next_hop = True
                group_evpn = group.afi_safis.afi_safi.create(eos436.openconfig_bgp_types_L2VPN_EVPN)
                group_evpn.config.afi_safi_name = eos436.openconfig_bgp_types_L2VPN_EVPN
                group_evpn.config.enabled = True
                # EOS sends no communities by default, and an EVPN route is
                # imported by its route target, an extended community
                group.config.send_community_type = ["EXTENDED"]
                if i.role == "leaf":
                    # The VTEP on the loopback, and the MAC address of the
                    # anycast gateways
                    vxlan = _eos_interface(dev, _EOS_VXLAN_INTERFACE, eos436.iana_if_type_other, None)
                    vxlan.arista_vxlan.config.src_ip_intf = _EOS_LOOPBACK
                    vxlan.arista_vxlan.config.udp_port = u64(_VXLAN_UDP_PORT)
                    dev.system.mac_address.config.routing_mac = _ANYCAST_GW_MAC

            # Advertise the loopbacks and accept everything the fabric sends us
            ps = dev.routing_policy.defined_sets.prefix_sets.prefix_set.create(_FABRIC_LOOPBACK_PREFIX_SET)
            ps.config.name = _FABRIC_LOOPBACK_PREFIX_SET
            ps.config.mode = "IPV4"
            prefix = ps.prefixes.prefix.create(("10.0.0.0/16", "32..32"))
            prefix.config.ip_prefix = "10.0.0.0/16"
            prefix.config.masklength_range = "32..32"
            exp = _eos_policy(dev, _FABRIC_EXPORT_POLICY)
            exp.conditions.match_prefix_set.config.prefix_set = _FABRIC_LOOPBACK_PREFIX_SET
            _eos_policy(dev, _FABRIC_IMPORT_POLICY)
            if i.evpn:
                # The export policy applies to every address family on EOS:
                # let the EVPN routes out too
                exp_evpn = dev.routing_policy.policy_definitions.policy_definition.create(_FABRIC_EXPORT_POLICY).statements.statement.create("20")
                exp_evpn.config.name = "20"
                exp_evpn.conditions.bgp_conditions.config.afi_safi_in = [eos436.openconfig_bgp_types_L2VPN_EVPN]
                exp_evpn.actions.config.policy_result = "ACCEPT_ROUTE"

            if len(i.overlay_peer) > 0:
                # EVPN only, between the loopbacks, with the policies of the
                # fabric
                overlay = bgp.peer_groups.peer_group.create(_OVERLAY_GROUP)
                overlay.config.peer_group_name = _OVERLAY_GROUP
                overlay.config.send_community_type = ["EXTENDED"]
                overlay.apply_policy.config.export_policy = [_FABRIC_EXPORT_POLICY]
                overlay.apply_policy.config.import_policy = [_FABRIC_IMPORT_POLICY]
                overlay.transport.config.local_address = _EOS_LOOPBACK
                overlay.ebgp_multihop.config.enabled = True
                overlay.ebgp_multihop.config.multihop_ttl = u64(_OVERLAY_MAX_HOPS)
                overlay_evpn = overlay.afi_safis.afi_safi.create(eos436.openconfig_bgp_types_L2VPN_EVPN)
                overlay_evpn.config.afi_safi_name = eos436.openconfig_bgp_types_L2VPN_EVPN
                overlay_evpn.config.enabled = True
                for peer in i.overlay_peer:
                    neighbor = bgp.neighbors.neighbor.create(peer.address)
                    neighbor.config.neighbor_address = peer.address
                    neighbor.config.peer_group = _OVERLAY_GROUP
                    neighbor.config.peer_as = peer.asn
                    neighbor.config.enabled = True
                    neighbor.config.description = _overlay_description(peer.device)

            # The VLAN interfaces EOS has made for the layer 3 VNIs of its
            # VRFs (Vlan4097 and up). EOS refuses to create or remove them,
            # and would refuse a commit that removes them, so they are
            # rendered as EOS has them, a name and a type and nothing else
            if dynstate is not None:
                for name in dynstate.eos_dynamic_vlan_interface:
                    vlan_if = dev.interfaces.interface.create(name)
                    vlan_if.config.name = name
                    vlan_if.config.type = eos436.iana_if_type_l3ipvlan

            return dev

        if _CRPD_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-base-config transform running {i.role} for Juniper cRPD", err=True)
            dev = crpd244.root()
            conf = dev.configuration
            conf.system.host_name = di.name

            # LLDP names the port, as SR Linux and EOS do, instead of the
            # number Junos assigns it; fabric and server ports enable it
            # themselves
            conf.protocols.lldp.port_id_subtype = "interface-name"

            # Loopback
            _crpd_ipv4_address(dev, _CRPD_LOOPBACK, "{i.ipv4_address}/32", None)

            # BGP with ECMP across the peers of every AS; the group carries the
            # loopback export policy
            conf.routing_options.router_id = i.ipv4_address
            conf.routing_options.autonomous_system.as_number = str(i.asn)
            conf.routing_options.forwarding_table.export = [_CRPD_ECMP_POLICY]
            group = conf.protocols.bgp.group.create(_FABRIC_GROUP, type="external")
            group.export = [_FABRIC_EXPORT_POLICY]
            group.import = [_FABRIC_IMPORT_POLICY]
            group.create_multipath(multiple_as=True)

            # Advertise the loopbacks and accept everything the fabric sends
            # us. Junos passes a route the export policy does not match to its
            # default, which advertises the routes learned over BGP.
            exp = _crpd_accept_term(dev, _FABRIC_EXPORT_POLICY, _FABRIC_LOOPBACK_PREFIX_SET)
            exp.from.route_filter.create((address="10.0.0.0/16", choice_ident="prefix-length-range", choice_value="/32-/32"))
            _crpd_accept_term(dev, _FABRIC_IMPORT_POLICY, "all")
            ecmp = dev.configuration.policy_options.policy_statement.create(_CRPD_ECMP_POLICY).term.create("all")
            # Despite its name, per-packet only lets the paths into the
            # forwarding table; Linux spreads the flows over them
            ecmp.then.load_balance.per_packet = True

            if i.evpn:
                exp_evpn = _crpd_accept_term(dev, _FABRIC_EXPORT_POLICY, "evpn")
                exp_evpn.from.family = "evpn"
                if i.role != "leaf":
                    # A spine or super-spine passes the EVPN routes on over
                    # the sessions of the links with their next hop, the VTEP
                    # of the leaf, which is not on the link. Junos changes the
                    # next hop on an eBGP session unless it is multihop with
                    # no-nexthop-change, which would keep that of the loopback
                    # routes too: those go out with the address of the link.
                    group.family.inet.create_unicast()
                    group.family.evpn.create_signaling()
                    group.create_multihop(ttl=1, no_nexthop_change=True)
                    group.accept_remote_nexthop = True
                    exp.then.next_hop.self_ = True

            if len(i.overlay_peer) > 0:
                # EVPN only, between the loopbacks, keeping the next hop of
                # the routes passed on
                overlay = conf.protocols.bgp.group.create(_OVERLAY_GROUP, type="external", accept_remote_nexthop=True, local_address=i.ipv4_address)
                overlay.create_multihop(no_nexthop_change=True)
                overlay.family.evpn.create_signaling()
                overlay.export = [_FABRIC_EXPORT_POLICY]
                overlay.import = [_FABRIC_IMPORT_POLICY]
                overlay.create_multipath(multiple_as=True)
                for peer in i.overlay_peer:
                    overlay.neighbor.create(peer.address, description=_overlay_description(peer.device), peer_as=str(peer.asn))

            return dev

        raise UnsupportedDevice()


class FabricInterface(base.FabricInterface):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/fabric-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}]", err=True)
        if_description = _link_description(i.remote.device, i.remote.interface)

        if "srl_nokia-system" in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for Nokia SRLinux", err=True)
            dev = srl25.root()

            # Routed point-to-point interface
            intf = dev.interface.create(i.name)
            intf.description = if_description
            intf.admin_state = "enable"
            subif = intf.subinterface.create(0)
            subif.admin_state = "enable"
            subif.description = if_description
            subif.ip_mtu = u64(_FABRIC_IP_MTU)
            subif.ipv4.admin_state = "enable"
            subif.ipv4.address.create("%s/%s" % (i.ipv4_address, str(i.ipv4_prefix_length)))

            dev.system.create_lldp().interface.create(i.name, admin_state="enable")

            ni = dev.network_instance.create("default")
            ni.interface.create("%s.0" % i.name)

            # eBGP session to the other end of the link
            bgp = ni.protocols.create_bgp()
            bgp.neighbor.create(i.bgp.peer_address, peer_group=_FABRIC_GROUP, peer_as=i.bgp.peer_asn, admin_state="enable", description=if_description)

            return dev

        if _NXOS_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for Cisco NX-OS", err=True)
            dev = nxos1064.root()
            # The base config makes the port routed, from fabric-port
            dev.System.intf_items.phys_items.PhysIf_list.create(i.name).descr = if_description
            _nxos_ipv4_address(dev, _NXOS_DEFAULT_VRF, i.name, "%s/%s" % (i.ipv4_address, str(i.ipv4_prefix_length)))

            # eBGP session to the other end of the link, with the peer
            # template of the fabric
            peer = _nxos_bgp_domain(dev, _NXOS_DEFAULT_VRF).peer_items.Peer_list.create(i.bgp.peer_address)
            peer.asn = str(i.bgp.peer_asn)
            peer.name = if_description
            peer.peerImp = _FABRIC_GROUP
            return dev

        if _EOS_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for Arista EOS", err=True)
            dev = eos436.root()

            # Routed point-to-point interface
            intf = _eos_interface(dev, i.name, eos436.iana_if_type_ethernetCsmacd, if_description)
            _eos_ipv4_address(intf, i.ipv4_address, i.ipv4_prefix_length, if_description)
            # EOS takes the IPv4 MTU only when the IPv6 one is the same
            fabric_subif = intf.subinterfaces.subinterface.create(0)
            fabric_subif.ipv4.config.mtu = u64(_FABRIC_IP_MTU)
            fabric_subif.ipv6.config.mtu = u64(_FABRIC_IP_MTU)

            _eos_lldp_interface(dev, i.name)

            # eBGP session to the other end of the link
            bgp = _eos_bgp(_eos_default_ni(dev))
            neighbor = bgp.neighbors.neighbor.create(i.bgp.peer_address)
            neighbor.config.neighbor_address = i.bgp.peer_address
            neighbor.config.peer_group = _FABRIC_GROUP
            neighbor.config.peer_as = i.bgp.peer_asn
            neighbor.config.enabled = True
            neighbor.config.description = if_description

            return dev

        if _CRPD_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/fabric-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for Juniper cRPD", err=True)
            dev = crpd244.root()
            conf = dev.configuration

            # Routed point-to-point interface. cRPD sets the MTU of the Linux
            # interface, which is its IP MTU.
            conf.interfaces.interface.create(i.name, description=if_description, mtu=_FABRIC_IP_MTU)
            _crpd_ipv4_address(dev, i.name, "%s/%s" % (i.ipv4_address, str(i.ipv4_prefix_length)), if_description)

            conf.protocols.lldp.interface.create(i.name)

            # eBGP session to the other end of the link
            group = conf.protocols.bgp.group.create(_FABRIC_GROUP)
            group.neighbor.create(i.bgp.peer_address, description=if_description, peer_as=str(i.bgp.peer_asn))

            return dev

        raise UnsupportedDevice()


# --- Port state -----------------------------------------------------------------
# Poll the oper-state and the LLDP neighbor of each fabric interface and server
# port from the device, and the state of the eBGP session of a fabric interface.
# The CFS FabricTransform lift turns them into the state of the fabric-link and
# of the server link.
_POLL_PERIOD = 5.0
# A device that stops answering does not fail the poll, the poll just never
# returns. After this long without a delivery the state is no longer reported,
# so that it reads as unknown instead of the last state seen.
_STALE_AFTER_NS = 20 * 1000000000


def _srl_oper_status(root: srl25_oper_root) -> ?str:
    """The oper-state of the one interface subscribed to."""
    for interface in root.interface:
        raw = interface.oper_state
        if raw == "up" or raw == "down":
            return raw
        if raw is not None:
            return "unknown"
    return None


def _srl_lldp_neighbor(root: srl25_oper_root) -> (?str, ?str):
    """System name and port ID of the LLDP neighbor of the one interface
    subscribed to. A point-to-point link has one neighbor; with more, such as
    behind a hub, the first one stands for them."""
    lldp = root.system.lldp
    if lldp is not None:
        for lldp_if in lldp.interface:
            for neighbor in lldp_if.neighbor:
                port_id = neighbor.port_id
                return (neighbor.system_name, str(port_id) if port_id is not None else None)
    return (None, None)


def _srl_port_subscriptions(name: str) -> set[gdata.SubscriptionSpec]:
    return {
        srl25_oper.subs.interface.entry(name).oper_state.subscribe(period=_POLL_PERIOD),
        srl25_oper.subs.system.lldp.interface.entry(name).neighbor.system_name.subscribe(period=_POLL_PERIOD),
        srl25_oper.subs.system.lldp.interface.entry(name).neighbor.port_id.subscribe(period=_POLL_PERIOD)
    }


def _eos_oper_status(root: eos436_oper_root) -> ?str:
    """The oper-status of the one interface subscribed to."""
    for interface in root.interfaces.interface:
        raw = interface.state.oper_status
        if raw == "UP":
            return "up"
        if raw == "DOWN" or raw == "LOWER_LAYER_DOWN":
            return "down"
        if raw is not None:
            return "unknown"
    return None


def _eos_lldp_neighbor(root: eos436_oper_root) -> (?str, ?str):
    """System name and port ID of the LLDP neighbor of the one interface
    subscribed to, like _srl_lldp_neighbor."""
    for lldp_if in root.lldp.interfaces.interface:
        for neighbor in lldp_if.neighbors.neighbor:
            return (neighbor.state.system_name, neighbor.state.port_id)
    return (None, None)


def _eos_port_subscriptions(name: str) -> set[gdata.SubscriptionSpec]:
    # The whole LLDP entry of the interface: EOS fails a filter that names the
    # neighbors when an interface has none ("unexpected element neighbors"),
    # and one that names neighbor leaves without the key id.
    return {
        eos436_oper.subs.interfaces.interface.entry(name).state.oper_status.subscribe(period=_POLL_PERIOD),
        eos436_oper.subs.lldp.interfaces.interface.entry(name).subscribe(period=_POLL_PERIOD)
    }


def _eos_bgp_subscriptions(peer_address: str) -> set[gdata.SubscriptionSpec]:
    # The whole entry of the neighbor, as EOS fails a filter that names
    # session-state before the session has any state. Until the neighbor is
    # configured the filter still fails on neighbors, so the BGP state is
    # polled apart from the port state, which then keeps coming, and that
    # failure reads as no session (see _eos_no_neighbor).
    bgp = eos436_oper.subs.network_instances.network_instance.entry("default").protocols.protocol.entry(eos436.openconfig_policy_types_BGP, "BGP").bgp
    return {
        bgp.neighbors.neighbor.entry(peer_address).subscribe(period=_POLL_PERIOD)
    }


# The first BGP poll often comes before the configuration with the neighbor
# reaches the switch. Only a neighbor still missing after this long is logged.
_NO_NEIGHBOR_LOG_AFTER_NS = 30 * 1000000000


def _eos_no_neighbor(err: Exception) -> bool:
    """Whether the BGP poll failed because the device has no BGP neighbor yet.
    EOS answers a filter that names a node it does not have with an error
    instead of an empty reply, as RFC 6241 has it."""
    return 'unexpected element "neighbors"' in str(err)


def _xml_find(node: xml.Node, tag: str) -> ?xml.Node:
    """The first element named tag at or below node, depth first."""
    if node.tag == tag:
        return node
    for child in node.children:
        found = _xml_find(child, tag)
        if found is not None:
            return found
    return None


def _xml_find_all(node: xml.Node, tag: str) -> list[xml.Node]:
    """Every element named tag at or below node, depth first."""
    found: list[xml.Node] = []
    if node.tag == tag:
        found.append(node)
    for child in node.children:
        found.extend(_xml_find_all(child, tag))
    return found


def _xml_text(node: xml.Node, tag: str) -> ?str:
    """The text of the first element named tag at or below node, stripped."""
    found = _xml_find(node, tag)
    if found is not None:
        text = found.text
        if text is not None:
            return text.strip()
    return None


def _crpd_rpc(name: str, arg: str, value: str) -> xml.Node:
    return xml.Node(name, children=[xml.Node(arg, text=value)])


def crpd_oper_status(reply: xml.Node, name: str) -> ?str:
    """The oper status of an interface from get-interfaces-routing, the
    interfaces as rpd sees them. cRPD answers with the text of the CLI table,
    a line per interface of its name, Up or Down, and addresses. It answers
    get-interface-information with the text of `ip address show`, whose
    <BROADCAST,...> it does not escape, which breaks the XML of the reply."""
    text = _xml_text(reply, "output")
    if text is not None:
        for line in text.split("\n"):
            fields = line.split()
            if len(fields) >= 2 and fields[0] == name:
                state = fields[1]
                if state == "Up":
                    return "up"
                if state == "Down":
                    return "down"
                return "unknown"
    return None


def crpd_evpn_instance_status(reply: xml.Node) -> ?str:
    """The state of a MAC-VRF from get-evpn-instance-information of one
    instance: up while a server port of it is up, None while the instance
    does not run. Besides its server ports an instance lists an interface of
    its own, .local..<n>, which is up whenever the instance runs."""
    instance = _xml_find(reply, "evpn-instance")
    if instance is not None:
        for intf in _xml_find_all(instance, "evpn-interface"):
            name = _xml_text(intf, "evpn-interface-name")
            if name is not None and not name.startswith(".local"):
                if _xml_text(intf, "evpn-interface-status") == "Up":
                    return "up"
        return "down"
    return None


def crpd_bgp_status(reply: xml.Node) -> ?str:
    """The state of the BGP session from get-bgp-neighbor-information of one
    neighbor; None while the neighbor or BGP is not configured."""
    state = _xml_text(reply, "peer-state")
    if state == "Established":
        return "up"
    if state is not None:
        # Idle, Connect, Active, OpenSent and OpenConfirm
        return "down"
    return None


def crpd_lldp_neighbor(reply: xml.Node) -> (?str, ?str):
    """System name and port ID of the LLDP neighbor from
    get-lldp-interface-neighbors, like _srl_lldp_neighbor."""
    neighbor = _xml_find(reply, "lldp-neighbor-information")
    if neighbor is not None:
        return (_xml_text(neighbor, "lldp-remote-system-name"), _xml_text(neighbor, "lldp-remote-port-id"))
    return (None, None)


actor _CrpdPortPoll(path, dev: swdev.DeviceMgr, on_state: proc(?str, ?str, ?str, ?str)->None):
    """Polls the state of a port of a cRPD and, for a fabric port, of the BGP
    session over it. cRPD has no state in a datastore to subscribe to, only in
    the replies of Junos RPCs. Each reply passes on the last state of the
    others; a device that does not answer passes on nothing."""
    var _port: ?str = None
    var _peer_address: ?str = None
    var _running = True
    var _oper_status: ?str = None
    var _bgp_status: ?str = None
    var _neighbor: (?str, ?str) = (None, None)
    var _error_logged = False

    def watch(port: str, peer_address: ?str):
        _port = port
        _peer_address = peer_address

    def stop():
        _running = False

    def _failed(err: Exception):
        # Not connected is for the watchdog of the transform to report; any
        # other failure is logged once until the next reply
        if not isinstance(err, NotConnectedError) and not _error_logged:
            print("{path}: polling the cRPD failed: {err}", err=True)
            _error_logged = True

    def _publish():
        if not _running:
            return
        _error_logged = False
        on_state(_oper_status, _bgp_status, _neighbor.0, _neighbor.1)

    def on_port(reply: ?xml.Node, err: ?Exception, port: str):
        if err is not None:
            _failed(err)
        elif reply is not None:
            _oper_status = crpd_oper_status(reply, port)
            _publish()

    def on_lldp(reply: ?xml.Node, err: ?Exception):
        if err is not None:
            _failed(err)
        elif reply is not None:
            _neighbor = crpd_lldp_neighbor(reply)
            _publish()

    def on_bgp(reply: ?xml.Node, err: ?Exception):
        if err is not None:
            _failed(err)
        elif reply is not None:
            _bgp_status = crpd_bgp_status(reply)
            _publish()

    def _poll():
        if not _running:
            return
        port = _port
        if port is not None:
            dev.rpc_xml(lambda r, e: on_port(r, e, port), _crpd_rpc("get-interfaces-routing", "interface-name", port))
            dev.rpc_xml(on_lldp, _crpd_rpc("get-lldp-interface-neighbors", "interface-device", port))
            peer_address = _peer_address
            if peer_address is not None:
                dev.rpc_xml(on_bgp, _crpd_rpc("get-bgp-neighbor-information", "neighbor-address", peer_address))
        after _POLL_PERIOD: _poll()

    proc def __startup__():
        _poll()


# Cisco NX-OS has the state of a port, of its LLDP neighbor and of its BGP
# session in the native model, config false below the PhysIf-list, the LLDP
# If-list and the BGP Peer-list. The LLDP If-list is configuration that NX-OS
# has for every port, which dorsi would own, and delete, if it were in the
# schema of the device type. So the state is read with a <get> and a subtree
# filter, as raw XML, like the state of a cRPD.
_NXOS_NAMESPACE = "http://cisco.com/ns/yang/cisco-nx-os-device"


def _nxos_path(tags: list[str], leaf: xml.Node) -> xml.Node:
    """Nested elements tags, outermost first, around leaf."""
    node = leaf
    for tag in reversed(tags):
        node = xml.Node(tag, children=[node])
    return node


def _nxos_entry(tag: str, key: str, value: str, children: list[xml.Node]) -> xml.Node:
    return xml.Node(tag, children=[xml.Node(key, text=value)] + children)


def nxos_state_request(port: str, peer_address: ?str) -> xml.Node:
    """The <get> of the oper state and the LLDP neighbors of a port and, for
    a fabric port, of the state of the BGP session to peer_address."""
    parts = [
        _nxos_path(["intf-items", "phys-items"],
            _nxos_entry("PhysIf-list", "id", port, [xml.Node("phys-items", children=[xml.Node("operSt")])])),
        _nxos_path(["lldp-items", "inst-items", "if-items"],
            _nxos_entry("If-list", "id", port, [xml.Node("adj-items")])),
    ]
    if peer_address is not None:
        peer = _nxos_entry("Peer-list", "addr", peer_address, [
            _nxos_path(["ent-items", "PeerEntry-list"], xml.Node("operSt"))])
        parts.append(_nxos_path(["bgp-items", "inst-items", "dom-items"],
            _nxos_entry("Dom-list", "name", _NXOS_DEFAULT_VRF, [xml.Node("peer-items", children=[peer])])))
    system = xml.Node("System", nsdefs=[(None, _NXOS_NAMESPACE)], children=parts)
    return xml.Node("get", children=[xml.Node("filter", attributes=[("type", "subtree")], children=[system])])


def nxos_oper_status(reply: xml.Node, port: str) -> ?str:
    """The operSt of a port from the reply to nxos_state_request: up, down,
    or unknown for the others, such as link-up or sfp-missing."""
    intf = _xml_find(reply, "intf-items")
    if intf is not None:
        for phys in _xml_find_all(intf, "PhysIf-list"):
            if _xml_text(phys, "id") == port:
                state = _xml_text(phys, "operSt")
                if state == "up" or state == "down":
                    return state
                if state is not None:
                    return "unknown"
    return None


def nxos_lldp_neighbor(reply: xml.Node) -> (?str, ?str):
    """System name and port ID of the LLDP neighbor from the reply to
    nxos_state_request, like _srl_lldp_neighbor."""
    lldp = _xml_find(reply, "lldp-items")
    if lldp is not None:
        neighbor = _xml_find(lldp, "AdjEp-list")
        if neighbor is not None:
            return (_xml_text(neighbor, "sysName"), _xml_text(neighbor, "portIdV"))
    return (None, None)


def nxos_bgp_status(reply: xml.Node, peer_address: str) -> ?str:
    """The state of the BGP session to peer_address from the reply to
    nxos_state_request; None while the peer is not configured."""
    bgp = _xml_find(reply, "bgp-items")
    if bgp is not None:
        for entry in _xml_find_all(bgp, "PeerEntry-list"):
            if _xml_text(entry, "addr") == peer_address:
                state = _xml_text(entry, "operSt")
                if state == "established":
                    return "up"
                if state is not None:
                    # idle, connect, active, open-sent, open-confirm, shut
                    # and the others
                    return "down"
    return None


actor _NxosPortPoll(path, dev: swdev.DeviceMgr, on_state: proc(?str, ?str, ?str, ?str)->None):
    """Polls the state of a port of an NX-OS and of the BGP session over it,
    with one <get> per poll. A device that does not answer passes on
    nothing."""
    var _port: ?str = None
    var _peer_address: ?str = None
    var _running = True
    var _error_logged = False

    def watch(port: str, peer_address: ?str):
        _port = port
        _peer_address = peer_address

    def stop():
        _running = False

    def on_reply(reply: ?xml.Node, err: ?Exception, port: str, peer_address: ?str):
        if not _running:
            return
        if err is not None:
            # Not connected is for the watchdog of the transform to report;
            # any other failure is logged once until the next reply
            if not isinstance(err, NotConnectedError) and not _error_logged:
                print("{path}: polling the NX-OS failed: {err}", err=True)
                _error_logged = True
        elif reply is not None:
            _error_logged = False
            bgp_status = nxos_bgp_status(reply, peer_address) if peer_address is not None else None
            neighbor = nxos_lldp_neighbor(reply)
            on_state(nxos_oper_status(reply, port), bgp_status, neighbor.0, neighbor.1)

    def _poll():
        if not _running:
            return
        port = _port
        if port is not None:
            peer_address = _peer_address
            dev.rpc_xml(lambda r, e: on_reply(r, e, port, peer_address), nxos_state_request(port, peer_address))
        after _POLL_PERIOD: _poll()

    proc def __startup__():
        _poll()


proc def FabricInterfaceTransform(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__fabric_interface_entry)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    return FabricInterfaceTransformActor(path, update_oper, dev, provider)


actor FabricInterfaceTransformActor(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__fabric_interface_entry)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider):
    _subs = gdata.SubscriptionManager(provider, str(path))
    _oper = base.FabricInterface.new_state(path)
    var _last_delivery: ?int = None
    var _stale = False
    var _running = True
    # EOS port and BGP state come in two deliveries; each publish carries the
    # last state of the other
    var _eos_oper_status_seen: ?str = None
    var _eos_bgp_status_seen: ?str = None
    var _eos_neighbor_seen: (?str, ?str) = (None, None)
    # Since when the BGP poll finds no neighbor on the device, and whether
    # that was logged
    var _eos_no_neighbor_since: ?int = None
    var _eos_no_neighbor_logged = False
    var _crpd_poll: ?_CrpdPortPoll = None
    var _nxos_poll: ?_NxosPortPoll = None

    def _watchdog():
        if not _running:
            return
        last = _last_delivery
        if last is not None and not _stale and time.monotonic_ns() - last > _STALE_AFTER_NS:
            print("FabricInterfaceTransform {path}: no state from the device for {_STALE_AFTER_NS // 1000000000} s, reporting it as unknown", err=True)
            _stale = True
            _eos_oper_status_seen = None
            _eos_bgp_status_seen = None
            _eos_neighbor_seen = (None, None)
            publish(None, None, None, None)
        after _POLL_PERIOD: _watchdog()

    def publish(oper_status: ?str, bgp_status: ?str, neighbor_device: ?str, neighbor_interface: ?str):
        # A reply to a poll sent before the interface was removed would
        # bring its state back
        if not _running:
            return
        _oper.state.oper_status = oper_status
        _oper.state.bgp_status = bgp_status
        _oper.state.lldp_neighbor.device = neighbor_device
        _oper.state.lldp_neighbor.interface = neighbor_interface
        update_oper(_oper)

    def on_srl_state(root: ?srl25_oper_root, err: ?Exception, peer_address: str):
        oper_status: ?str = None
        bgp_status: ?str = None
        neighbor_device: ?str = None
        neighbor_interface: ?str = None
        if err is not None:
            print("FabricInterfaceTransform subscription error: {err}", err=True)
        elif root is not None:
            oper_status = _srl_oper_status(root)
            for ni in root.network_instance:
                bgp = ni.protocols.bgp
                if bgp is not None:
                    for neighbor in bgp.neighbor:
                        if neighbor.peer_address == peer_address:
                            session = neighbor.session_state
                            if session == "established":
                                bgp_status = "up"
                            elif session is not None:
                                # idle, connect, active, opensent and openconfirm
                                bgp_status = "down"
            neighbor_device, neighbor_interface = _srl_lldp_neighbor(root)
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(oper_status, bgp_status, neighbor_device, neighbor_interface)

    def _eos_publish():
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(_eos_oper_status_seen, _eos_bgp_status_seen, _eos_neighbor_seen.0, _eos_neighbor_seen.1)

    def on_eos_port_state(root: ?eos436_oper_root, err: ?Exception):
        oper_status: ?str = None
        neighbor: (?str, ?str) = (None, None)
        if err is not None:
            print("FabricInterfaceTransform subscription error: {err}", err=True)
        elif root is not None:
            oper_status = _eos_oper_status(root)
            neighbor = _eos_lldp_neighbor(root)
        _eos_oper_status_seen = oper_status
        _eos_neighbor_seen = neighbor
        _eos_publish()

    def on_eos_bgp_state(root: ?eos436_oper_root, err: ?Exception, peer_address: str):
        bgp_status: ?str = None
        if err is not None and _eos_no_neighbor(err):
            # No session yet, the state stays unknown
            now = time.monotonic_ns()
            if _eos_no_neighbor_since is None:
                _eos_no_neighbor_since = now
            since = _eos_no_neighbor_since
            if since is not None and not _eos_no_neighbor_logged and now - since > _NO_NEIGHBOR_LOG_AFTER_NS:
                print("FabricInterfaceTransform {path}: BGP neighbor {peer_address} still not on the device after {_NO_NEIGHBOR_LOG_AFTER_NS // 1000000000} s", err=True)
                _eos_no_neighbor_logged = True
        elif err is not None:
            print("FabricInterfaceTransform BGP subscription error: {err}", err=True)
        elif root is not None:
            _eos_no_neighbor_since = None
            _eos_no_neighbor_logged = False
            for ni in root.network_instances.network_instance:
                for proto in ni.protocols.protocol:
                    for neighbor in proto.bgp.neighbors.neighbor:
                        if neighbor.neighbor_address == peer_address:
                            session = neighbor.state.session_state
                            if session == "ESTABLISHED":
                                bgp_status = "up"
                            elif session is not None:
                                # IDLE, CONNECT, ACTIVE, OPENSENT and OPENCONFIRM
                                bgp_status = "down"
        _eos_bgp_status_seen = bgp_status
        _eos_publish()

    def on_polled_state(oper_status: ?str, bgp_status: ?str, neighbor_device: ?str, neighbor_interface: ?str):
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(oper_status, bgp_status, neighbor_device, neighbor_interface)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__fabric_interface_entry):
        want: set[gdata.Delivery] = set()
        modset = dev.get_modules().0
        if "srl_nokia-system" in modset:
            peer_address = conf.bgp.peer_address
            srl_dst = srl25_oper.dst(lambda r, e: on_srl_state(r, e, peer_address))
            subs = _srl_port_subscriptions(conf.name)
            subs.add(srl25_oper.subs.network_instance.entry("default").protocols.bgp.neighbor.entry(peer_address).session_state.subscribe(period=_POLL_PERIOD))
            want.add(srl_dst.deliver(subs))
        elif _EOS_MODULE in modset:
            peer_address = conf.bgp.peer_address
            port_dst = eos436_oper.dst(on_eos_port_state)
            want.add(port_dst.deliver(_eos_port_subscriptions(conf.name)))
            bgp_dst = eos436_oper.dst(lambda r, e: on_eos_bgp_state(r, e, peer_address))
            want.add(bgp_dst.deliver(_eos_bgp_subscriptions(peer_address)))
        elif _CRPD_MODULE in modset:
            poll = _crpd_poll
            if poll is not None:
                poll.watch(conf.name, conf.bgp.peer_address)
            else:
                new_poll = _CrpdPortPoll(path, dev, on_polled_state)
                new_poll.watch(conf.name, conf.bgp.peer_address)
                _crpd_poll = new_poll
        elif _NXOS_MODULE in modset:
            nxos_poll = _nxos_poll
            if nxos_poll is not None:
                nxos_poll.watch(conf.name, conf.bgp.peer_address)
            else:
                new_nxos_poll = _NxosPortPoll(path, dev, on_polled_state)
                new_nxos_poll.watch(conf.name, conf.bgp.peer_address)
                _nxos_poll = new_nxos_poll
        _subs.declare(want)

    def shutdown():
        _running = False
        poll = _crpd_poll
        if poll is not None:
            poll.stop()
        nxos_poll = _nxos_poll
        if nxos_poll is not None:
            nxos_poll.stop()

    proc def __startup__():
        after _POLL_PERIOD: _watchdog()


# How long a port of a server LAG is held down after it comes up. When a port
# came back, SR Linux lost the first frame of the server on it in 8 of 30
# tries in the fabric-5stage-srl lab; held for 2 s, in 2 of 30.
_LAG_MEMBER_HOLD_TIME_UP_MS = 2000


class ServerPort(base.ServerPort):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/server-port transform running [{i.name}] <-> {i.server} [{i.server_port}] {i.profile}", err=True)
        if_description = "Server {i.server} [{i.server_port}] ({i.profile})"

        if "srl_nokia-system" in di.modules:
            print("RFS /rfs{{{di.name}}}/server-port transform running [{i.name}] for Nokia SRLinux", err=True)
            dev = srl25.root()
            intf = dev.interface.create(i.name)
            intf.description = if_description
            intf.admin_state = "enable"
            lag = i.lag
            if lag is not None:
                intf.ethernet.aggregate_id = lag
                intf.ethernet.hold_time.up = u64(_LAG_MEMBER_HOLD_TIME_UP_MS)
            dev.system.create_lldp().interface.create(i.name, admin_state="enable")
            return dev

        if _EOS_MODULE in di.modules:
            print("RFS /rfs{{{di.name}}}/server-port transform running [{i.name}] for Arista EOS", err=True)
            dev = eos436.root()
            intf = _eos_interface(dev, i.name, eos436.iana_if_type_ethernetCsmacd, if_description)
            lag = i.lag
            if lag is not None:
                intf.ethernet.config.aggregate_id = lag
            _eos_lldp_interface(dev, i.name)
            return dev

        if _CRPD_MODULE in di.modules:
            # The port only; the units that bridge the server VLANs come with
            # the MAC-VRFs
            print("RFS /rfs{{{di.name}}}/server-port transform running [{i.name}] for Juniper cRPD", err=True)
            dev = crpd244.root()
            dev.configuration.interfaces.interface.create(i.name, description=if_description)
            dev.configuration.protocols.lldp.interface.create(i.name)
            return dev

        if _NXOS_MODULE in di.modules:
            # The base configuration has the port as a layer 2 port; a port
            # of networks trunks their VLANs, the untagged one as its native
            # VLAN
            print("RFS /rfs{{{di.name}}}/server-port transform running [{i.name}] for Cisco NX-OS", err=True)
            if i.lag is not None:
                raise ValueError("server-port {i.name}: dorsi cannot put a server port in a LAG on Cisco NX-OS yet")
            dev = nxos1064.root()
            phys = dev.System.intf_items.phys_items.PhysIf_list.create(i.name)
            phys.descr = if_description
            if len(i.trunk_vlan) > 0:
                phys.mode = "trunk"
                phys.trunkVlans = nxos_vlan_list([int(v) for v in i.trunk_vlan])
                native = i.native_vlan
                if native is not None:
                    phys.nativeVlan = nxos_vlan(int(native))
            return dev

        raise UnsupportedDevice()


# --- EVPN-VXLAN overlay -----------------------------------------------------------
# Layer 2 networks bridged between the leaves over VXLAN, as in the SR Linux
# l2evpn tutorial, with EVPN on the eBGP sessions of the underlay instead of an
# iBGP overlay. Every network has its own vxlan-interface on vxlan1, numbered
# by its EVI. Flooded traffic uses ingress replication.
_VXLAN_TUNNEL = "vxlan1"
_EVPN_BGP_INSTANCE = 1
# Paths to a MAC address over the leaves of a multihomed server (aliasing)
_EVPN_ECMP = 8
# Priority of the LACP system ID shared by the leaves of a server
_LACP_SYSTEM_PRIORITY = 32768
# The anycast gateways of the networks, with the MAC address _ANYCAST_GW_MAC
_IRB_INTERFACE = "irb0"
_ANYCAST_GW_VRID = 1


class MacVrf(base.MacVrf):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/mac-vrf transform running {i.name} VNI {i.vni}", err=True)

        if "srl_nokia-system" in di.modules:
            dev = srl25.root()
            vxlan_if = "{_VXLAN_TUNNEL}.{i.evi}"
            vx = dev.tunnel_interface.create(_VXLAN_TUNNEL).vxlan_interface.create(i.evi)
            vx.type = srl25.srl_nokia_interfaces_bridged
            vx.ingress.vni = i.vni

            ni = dev.network_instance.create(i.name, type=srl25.srl_nokia_network_instance_mac_vrf, admin_state="enable", description="Overlay network VNI {i.vni}")
            for itf in i.interface:
                # The subinterface index is the VLAN, 0 for untagged traffic
                vlan = itf.vlan
                index = vlan if vlan is not None else 0
                intf = dev.interface.create(itf.name)
                intf.vlan_tagging = True
                subif = intf.subinterface.create(index)
                subif.type = srl25.srl_nokia_interfaces_bridged
                subif.admin_state = "enable"
                if vlan is not None:
                    subif.vlan.encap.create_single_tagged(vlan_id=vlan)
                else:
                    subif.vlan.encap.create_untagged()
                ni.interface.create("{itf.name}.{index}")
            ni.vxlan_interface.create(vxlan_if)

            irb = i.irb
            if irb is not None:
                # Anycast gateway. The leaf learns the hosts of the network
                # from ARP, also from the gratuitous ARP of a host, advertises
                # them with their IP in MAC/IP routes and puts them in the
                # IP-VRF as host routes, which go out as IP prefix routes.
                irb_if = dev.interface.create(_IRB_INTERFACE)
                irb_if.admin_state = "enable"
                irb_sub = irb_if.subinterface.create(irb.index)
                irb_sub.admin_state = "enable"
                irb_sub.create_anycast_gw(virtual_router_id=u64(_ANYCAST_GW_VRID), anycast_gw_mac=_ANYCAST_GW_MAC)
                irb_sub.ipv4.admin_state = "enable"
                irb_sub.ipv4.address.create(irb.gateway, anycast_gw=True)
                arp = irb_sub.ipv4.arp
                arp.learn_unsolicited = True
                arp.host_route.populate.create("dynamic")
                arp.create_evpn().advertise.create("dynamic")
                ni.interface.create("{_IRB_INTERFACE}.{irb.index}")

            _srl_evpn_instance(ni, vxlan_if, i.evi, i.route_distinguisher, i.route_target)
            return dev

        if _EOS_MODULE in di.modules:
            if i.vlan is None:
                raise ValueError("mac-vrf {i.name}: Arista EOS needs the internal VLAN of the network")
            net_vlan = i.vlan!
            dev = eos436.root()
            # The VLAN of the network inside the switch and its VNI
            eos_vlan = _eos_default_ni(dev).vlans.vlan.create(net_vlan)
            eos_vlan.config.vlan_id = net_vlan
            eos_vlan.config.name = i.name
            eos_vxlan = dev.interfaces.interface.create(_EOS_VXLAN_INTERFACE)
            eos_vxlan.config.name = _EOS_VXLAN_INTERFACE
            vni_map = eos_vxlan.arista_vxlan.vlan_to_vnis.vlan_to_vni.create(net_vlan)
            vni_map.config.vlan = net_vlan
            vni_map.config.vni = i.vni

            # Its EVPN instance
            eos_evi = dev.arista.eos.evpn.evpn_instances.evpn_instance.create(str(net_vlan))
            eos_evi.config.name = str(net_vlan)
            eos_evi.config.route_distinguisher = i.route_distinguisher
            eos_evi.config.redistribute = ["LEARNED"]
            eos_rt = _eos_route_target(i.route_target)
            eos_evi.route_target.config.import = [eos_rt]
            eos_evi.route_target.config.export = [eos_rt]
            evi_vlan = eos_evi.vlans.vlan.create(net_vlan)
            evi_vlan.config.vlan_id = net_vlan

            # The server ports and LAGs trunk it, with the VLAN tag of the
            # server translated to it both ways, or untagged as their native
            # VLAN
            trunk: list[atom] = [net_vlan]
            for itf in i.interface:
                eos_intf = dev.interfaces.interface.create(itf.name)
                eos_intf.config.name = itf.name
                tag = itf.vlan
                if itf.name.startswith("Port-Channel"):
                    lag_vlan = eos_intf.aggregation.switched_vlan
                    lag_vlan.config.interface_mode = "TRUNK"
                    lag_vlan.config.trunk_vlans = trunk
                    if tag is not None:
                        if tag != net_vlan:
                            eos_ingress = lag_vlan.vlan_translation.ingress.create(tag)
                            eos_ingress.config.translation_key = tag
                            eos_ingress.config.bridging_vlan = net_vlan
                            # On the way out EOS takes the VLAN it bridges in as
                            # the key and the tag it sends as bridging-vlan
                            eos_egress = lag_vlan.vlan_translation.egress.create(net_vlan)
                            eos_egress.config.translation_key = net_vlan
                            eos_egress.config.bridging_vlan = tag
                    else:
                        lag_vlan.config.native_vlan = net_vlan
                else:
                    port_vlan = eos_intf.ethernet.switched_vlan
                    port_vlan.config.interface_mode = "TRUNK"
                    port_vlan.config.trunk_vlans = trunk
                    if tag is not None:
                        if tag != net_vlan:
                            eos_port_ingress = port_vlan.vlan_translation.ingress.create(tag)
                            eos_port_ingress.config.translation_key = tag
                            eos_port_ingress.config.bridging_vlan = net_vlan
                            # On the way out EOS takes the VLAN it bridges in as
                            # the key and the tag it sends as bridging-vlan
                            eos_port_egress = port_vlan.vlan_translation.egress.create(net_vlan)
                            eos_port_egress.config.translation_key = net_vlan
                            eos_port_egress.config.bridging_vlan = tag
                    else:
                        port_vlan.config.native_vlan = net_vlan

            eos_irb = i.irb
            if eos_irb is not None:
                # The anycast gateway: a virtual address on the VLAN
                # interface, answering with the MAC of every leaf
                gw_parts: list[str] = eos_irb.gateway.split("/")
                name = "Vlan{net_vlan}"
                vlan_if = _eos_interface(dev, name, eos436.iana_if_type_l3ipvlan, None)
                vlan_if.routed_vlan.config.vlan = name
                vlan_if.arista_varp.virtual_address.config.ip = gw_parts[0]
                vlan_if.arista_varp.virtual_address.config.prefix_length = u64(int(gw_parts[1]))
            return dev

        if _CRPD_MODULE in di.modules:
            if i.vlan is None:
                raise ValueError("mac-vrf {i.name}: Juniper cRPD needs the internal VLAN of the network")
            if i.irb is not None:
                raise ValueError("mac-vrf {i.name}: dorsi cannot route a network on Juniper cRPD yet")
            dev = crpd244.root()
            conf = dev.configuration
            # A bridge domain of the network in a vlan-based MAC-VRF, with its
            # VTEP on the loopback. cRPD makes it a Linux bridge with a VXLAN
            # device of the VNI. cRPD requires the service type; vlan-based is
            # added to its YANG in spec/yang, which lacks it.
            inst = conf.routing_instances.instance.create(i.name, instance_type="mac-vrf", service_type="vlan-based")
            inst.protocols.create_evpn(encapsulation="vxlan")
            inst.vtep_source_interface.interface_name = "{_CRPD_LOOPBACK}.0"
            inst.route_distinguisher.rd_type = i.route_distinguisher
            inst.vrf_target.community = i.route_target
            bd = inst.bridge_domains.domain.create(i.name, vlan_id=str(i.vlan))
            bd.vxlan.vni = i.vni
            for itf in i.interface:
                # A unit of the VLAN tag of the server, which cRPD makes the
                # Linux VLAN subinterface <port>.<tag> in the bridge. Without
                # the vlan-bridge encapsulation rpd counts the port as not
                # there and keeps its EVPN routes back.
                tag = itf.vlan
                if tag is None:
                    raise ValueError("mac-vrf {i.name}: Juniper cRPD cannot bridge untagged traffic on {itf.name} yet")
                conf.interfaces.interface.create(itf.name).unit.create(str(tag), vlan_id=str(tag), encapsulation="vlan-bridge")
                bd.interface.create("{itf.name}.{tag}")
            return dev

        if _NXOS_MODULE in di.modules:
            if i.vlan is None:
                raise ValueError("mac-vrf {i.name}: Cisco NX-OS needs the VLAN of the network")
            dev = nxos1064.root()
            # The VLAN of the network and its VNI on the VTEP, flooded by
            # ingress replication. The server ports trunk the VLAN (see
            # ServerPort).
            bd = dev.System.bd_items.bd_items.BD_list.create(nxos_vlan(int(i.vlan!)))
            bd.accEncap = "vxlan-{i.vni}"
            vtep = dev.System.eps_items.epId_items.Ep_list.create(u64(_NXOS_VTEP))
            vtep.nws_items.vni_items.Nw_list.create(i.vni).IngRepl_items.proto = "bgp"
            # Its EVPN instance
            evi = dev.System.evpn_items.bdevi_items.BDEvi_list.create("vxlan-{i.vni}")
            evi.rd = nxos_route_distinguisher(i.route_distinguisher)
            rt = nxos_route_target(i.route_target)
            evi.rttp_items.RttP_list.create("import").ent_items.RttEntry_list.create(rt)
            evi.rttp_items.RttP_list.create("export").ent_items.RttEntry_list.create(rt)

            nxos_irb = i.irb
            if nxos_irb is not None:
                # The anycast gateway, on the VLAN interface of the network
                # in its VRF
                irb_vrf = nxos_irb.vrf
                if irb_vrf is None:
                    raise ValueError("mac-vrf {i.name}: Cisco NX-OS needs the VRF of the network")
                svi = _nxos_svi(dev, int(i.vlan!), irb_vrf!)
                _nxos_ipv4_address(dev, irb_vrf!, svi, nxos_irb.gateway)
                dev.System.hmm_items.fwdinst_items.if_items.FwdIf_list.create(svi).mode = "anycastGW"
            return dev

        raise UnsupportedDevice()


def _eos_route_target(rt: str) -> str:
    """A route target as EOS writes it, without the target: of SR Linux."""
    return rt[len("target:"):] if rt.startswith("target:") else rt


def _srl_evpn_instance(ni, vxlan_if: str, evi: u64, rd: str, rt: str):
    """EVPN on the vxlan-interface of a network instance, with its route
    distinguisher and route target."""
    evpn = ni.protocols.create_bgp_evpn().bgp_instance.create(u64(_EVPN_BGP_INSTANCE))
    evpn.admin_state = "enable"
    evpn.vxlan_interface = vxlan_if
    evpn.evi = evi
    evpn.ecmp = u64(_EVPN_ECMP)
    vpn = ni.protocols.create_bgp_vpn().bgp_instance.create(u64(_EVPN_BGP_INSTANCE))
    vpn.route_distinguisher.rd = rd
    vpn.route_target.export_rt = rt
    vpn.route_target.import_rt = rt


class IpVrf(base.IpVrf):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/ip-vrf transform running {i.name} VNI {i.vni}", err=True)

        if "srl_nokia-system" in di.modules:
            dev = srl25.root()
            vxlan_if = "{_VXLAN_TUNNEL}.{i.evi}"
            vx = dev.tunnel_interface.create(_VXLAN_TUNNEL).vxlan_interface.create(i.evi)
            vx.type = srl25.srl_nokia_interfaces_routed
            vx.ingress.vni = i.vni

            ni = dev.network_instance.create(i.name, type=srl25.srl_nokia_network_instance_ip_vrf, admin_state="enable", description="Overlay VRF VNI {i.vni}")
            for irb_if in i.irb_interface:
                ni.interface.create(irb_if)
            ni.vxlan_interface.create(vxlan_if)
            _srl_evpn_instance(ni, vxlan_if, i.evi, i.route_distinguisher, i.route_target)
            return dev

        if _EOS_MODULE in di.modules:
            # For the layer 3 VNI EOS adds a VLAN interface of its own
            # (Vlan4097 and up), which the base configuration keeps
            dev = eos436.root()
            ni = dev.network_instances.network_instance.create(i.name)
            ni.config.name = i.name
            ni.config.type = eos436.openconfig_network_instance_types_L3VRF
            ni.config.route_distinguisher = i.route_distinguisher
            ni.config.ipv4_routing_enabled = True
            for irb_if in i.irb_interface:
                member = ni.interfaces.interface.create(irb_if)
                member.config.id = irb_if
                member.config.interface = irb_if

            # Its layer 3 VNI, and its routes in EVPN: the subnets of its
            # networks, redistributed as IP prefix routes
            vxlan = dev.interfaces.interface.create(_EOS_VXLAN_INTERFACE)
            vxlan.config.name = _EOS_VXLAN_INTERFACE
            vni = vxlan.arista_vxlan.vrf_to_vnis.vrf_to_vni.create(i.name)
            vni.config.vrf = i.name
            vni.config.vni = i.vni
            bgp = _eos_bgp(ni)
            rt = _eos_route_target(i.route_target)
            bgp.global.evpn.import_target = [rt]
            bgp.global.evpn.export_target = [rt]
            tc_key = (eos436.openconfig_policy_types_DIRECTLY_CONNECTED, eos436.openconfig_policy_types_BGP, eos436.openconfig_types_IPV4)
            tc = ni.table_connections.table_connection.create(tc_key)
            tc.config.src_protocol = eos436.openconfig_policy_types_DIRECTLY_CONNECTED
            tc.config.dst_protocol = eos436.openconfig_policy_types_BGP
            tc.config.address_family = eos436.openconfig_types_IPV4
            return dev

        if _NXOS_MODULE in di.modules:
            if i.vlan is None:
                raise ValueError("ip-vrf {i.name}: Cisco NX-OS needs the VLAN of its layer 3 VNI")
            l3_vlan = int(i.vlan!)
            dev = nxos1064.root()
            # The VRF with its layer 3 VNI, and its routes in EVPN
            vrf = _nxos_vrf(dev, i.name)
            vrf.encap = "vxlan-{i.vni}"
            dom = vrf.dom_items.Dom_list.create(i.name)
            dom.rd = nxos_route_distinguisher(i.route_distinguisher)
            ctrl = dom.af_items.DomAf_list.create(_NXOS_IPV4_UNICAST).ctrl_items.AfCtrl_list.create(_NXOS_L2VPN_EVPN)
            rt = nxos_route_target(i.route_target)
            ctrl.rttp_items.RttP_list.create("import").ent_items.RttEntry_list.create(rt)
            ctrl.rttp_items.RttP_list.create("export").ent_items.RttEntry_list.create(rt)

            # The layer 3 VNI is routed on a VLAN of its own and its VLAN
            # interface, on the VTEP as the VNI of the VRF
            dev.System.bd_items.bd_items.BD_list.create(nxos_vlan(l3_vlan)).accEncap = "vxlan-{i.vni}"
            svi = _nxos_svi(dev, l3_vlan, i.name)
            dev.System.ipv4_items.inst_items.dom_items.Dom_list.create(i.name).if_items.If_list.create(svi).forward = "enabled"
            dev.System.eps_items.epId_items.Ep_list.create(u64(_NXOS_VTEP)).nws_items.vni_items.Nw_list.create(i.vni).associateVrfFlag = True

            # BGP in the VRF: the subnets of its networks, its connected
            # routes, go out as IP prefix routes
            af = _nxos_bgp_domain(dev, i.name).af_items.DomAf_list.create(_NXOS_IPV4_UNICAST)
            af.advertL2vpnEvpn = "enabled"
            leak = af.interleak_items.InterLeakP_list.create(("direct", "none"))
            leak.asn = "none"
            leak.rtMap = _FABRIC_IMPORT_POLICY
            return dev

        raise UnsupportedDevice()


def eos_esi(esi: str) -> str:
    """An ESI as EOS takes it in OpenConfig: 20 hex digits, no colons."""
    return esi.replace(":", "")


def es_import_route_target(esi: str) -> str:
    """The ES-import route target of a type 0 ESI, as RFC 7432 section 7.6
    derives it: the 6 bytes after the type. EOS does not derive it itself."""
    return ":".join(esi.split(":")[1:7])


class ServerLag(base.ServerLag):
    def transform(self, i, di, dynstate: ?ServerLagDynstate):
        print("RFS /rfs{{{di.name}}}/server-lag transform running {i.name} {i.server}", err=True)

        if "srl_nokia-system" in di.modules:
            dev = srl25.root()
            intf = dev.interface.create(i.name)
            intf.description = "Server {i.server}"
            intf.admin_state = "enable"
            lag = intf.create_lag(lag_type="lacp")
            lag.create_lacp(interval="FAST", lacp_mode="ACTIVE", admin_key=i.lacp_admin_key, system_id_mac=i.lacp_system_id, system_priority=u64(_LACP_SYSTEM_PRIORITY))

            esi = i.esi
            if esi is not None:
                # All-active ethernet segment, shared with the other leaf of
                # the server
                protocols = dev.system.create_network_instance().protocols
                protocols.create_bgp_vpn().bgp_instance.create(u64(_EVPN_BGP_INSTANCE))
                es_bgp = protocols.create_evpn().create_ethernet_segments().bgp_instance.create(u64(_EVPN_BGP_INSTANCE))
                es = es_bgp.ethernet_segment.create("es-{i.server}")
                es.admin_state = "enable"
                es.esi = esi
                es.multi_homing_mode = "all-active"
                es.interface.create(i.name)
            return dev

        if _EOS_MODULE in di.modules:
            dev = eos436.root()
            intf = _eos_interface(dev, i.name, eos436.iana_if_type_ieee8023adLag, "Server {i.server}")
            intf.aggregation.config.lag_type = "LACP"
            lacp = dev.lacp.interfaces.interface.create(i.name)
            lacp.config.name = i.name
            lacp.config.interval = "FAST"
            lacp.config.lacp_mode = "ACTIVE"
            lacp.config.system_id_mac = i.lacp_system_id

            esi = i.esi
            if esi is not None and dynstate is not None and dynstate.lag_present == True:
                # EOS takes an ethernet segment only on a LAG that is already
                # there, not in the transaction that creates it: the segment
                # comes in a second transaction, once the transform actor
                # sees the LAG on the device
                es = dev.ethernet_segments.ethernet_segment.create("es-{i.server}")
                es.config.name = "es-{i.server}"
                es.config.esi_type = "TYPE_0_OPERATOR_CONFIGURED"
                es.config.esi = eos_esi(esi)
                # A string in the patched model, as EOS reports it: see
                # openconfig-ethernet-segments. Without it EOS makes the
                # segment single-active
                es.config.redundancy_mode = "openconfig-evpn-types:ALL_ACTIVE"
                es.config.es_import_route_target = es_import_route_target(esi)
                es.config.interface = i.name
            return dev

        raise UnsupportedDevice()


proc def ServerPortTransform(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__server_port_entry)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    return ServerPortTransformActor(path, update_oper, dev, provider)


actor ServerPortTransformActor(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__server_port_entry)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider):
    _subs = gdata.SubscriptionManager(provider, str(path))
    _oper = base.ServerPort.new_state(path)
    var _last_delivery: ?int = None
    var _stale = False
    var _running = True
    var _crpd_poll: ?_CrpdPortPoll = None
    var _nxos_poll: ?_NxosPortPoll = None

    def _watchdog():
        if not _running:
            return
        last = _last_delivery
        if last is not None and not _stale and time.monotonic_ns() - last > _STALE_AFTER_NS:
            print("ServerPortTransform {path}: no state from the device for {_STALE_AFTER_NS // 1000000000} s, reporting it as unknown", err=True)
            _stale = True
            publish(None, None, None)
        after _POLL_PERIOD: _watchdog()

    def publish(oper_status: ?str, neighbor_device: ?str, neighbor_interface: ?str):
        # A reply to a poll sent before the port was removed would bring its
        # state back
        if not _running:
            return
        _oper.state.oper_status = oper_status
        _oper.state.lldp_neighbor.device = neighbor_device
        _oper.state.lldp_neighbor.interface = neighbor_interface
        update_oper(_oper)

    def on_srl_state(root: ?srl25_oper_root, err: ?Exception):
        oper_status: ?str = None
        neighbor_device: ?str = None
        neighbor_interface: ?str = None
        if err is not None:
            print("ServerPortTransform subscription error: {err}", err=True)
        elif root is not None:
            oper_status = _srl_oper_status(root)
            neighbor_device, neighbor_interface = _srl_lldp_neighbor(root)
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(oper_status, neighbor_device, neighbor_interface)

    def on_eos_state(root: ?eos436_oper_root, err: ?Exception):
        oper_status: ?str = None
        neighbor_device: ?str = None
        neighbor_interface: ?str = None
        if err is not None:
            print("ServerPortTransform subscription error: {err}", err=True)
        elif root is not None:
            oper_status = _eos_oper_status(root)
            neighbor_device, neighbor_interface = _eos_lldp_neighbor(root)
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(oper_status, neighbor_device, neighbor_interface)

    def on_polled_state(oper_status: ?str, bgp_status: ?str, neighbor_device: ?str, neighbor_interface: ?str):
        _last_delivery = time.monotonic_ns()
        _stale = False
        publish(oper_status, neighbor_device, neighbor_interface)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__server_port_entry):
        want: set[gdata.Delivery] = set()
        modset = dev.get_modules().0
        if "srl_nokia-system" in modset:
            srl_dst = srl25_oper.dst(lambda r, e: on_srl_state(r, e))
            want.add(srl_dst.deliver(_srl_port_subscriptions(conf.name)))
        elif _EOS_MODULE in modset:
            eos_dst = eos436_oper.dst(lambda r, e: on_eos_state(r, e))
            want.add(eos_dst.deliver(_eos_port_subscriptions(conf.name)))
        elif _CRPD_MODULE in modset:
            poll = _crpd_poll
            if poll is not None:
                poll.watch(conf.name, None)
            else:
                new_poll = _CrpdPortPoll(path, dev, on_polled_state)
                new_poll.watch(conf.name, None)
                _crpd_poll = new_poll
        elif _NXOS_MODULE in modset:
            nxos_poll = _nxos_poll
            if nxos_poll is not None:
                nxos_poll.watch(conf.name, None)
            else:
                new_nxos_poll = _NxosPortPoll(path, dev, on_polled_state)
                new_nxos_poll.watch(conf.name, None)
                _nxos_poll = new_nxos_poll
        _subs.declare(want)

    def shutdown():
        _running = False
        poll = _crpd_poll
        if poll is not None:
            poll.stop()
        nxos_poll = _nxos_poll
        if nxos_poll is not None:
            nxos_poll.stop()

    proc def __startup__():
        after _POLL_PERIOD: _watchdog()


# --- Overlay state --------------------------------------------------------------
# Poll the state of the overlay from the device: the network instance of each
# MAC-VRF and IP-VRF with its EVPN instance, and each server LAG with its
# ethernet segment. The CFS FabricTransform lift turns them into the state of
# the networks, VRFs and servers. On Arista EOS a network is a VLAN rather than
# a network instance, and EOS takes no VRF or ethernet segment from dorsi yet.
# On Juniper cRPD the state comes from Junos RPCs, for networks only.

def _srl_status(raw: ?str) -> ?str:
    """An SR Linux oper-state as up, down or unknown, None when not read."""
    if raw == "up" or raw == "down":
        return raw
    if raw is not None:
        return "unknown"
    return None


proc def FabricBaseConfigTransform(path, update_dynstate: proc(?FabricBaseConfigDynstate)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    dynstate = base.FabricBaseConfig.dynstate_type()()
    return FabricBaseConfigTransformActor(path, update_dynstate, dev, provider, dynstate)


actor FabricBaseConfigTransformActor(path, update_dynstate: proc(?FabricBaseConfigDynstate)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider, dynstate: FabricBaseConfigDynstate):
    """Follows the VLAN interfaces an EOS switch makes of its own, for the
    transform to keep them in the configuration."""
    _subs = gdata.SubscriptionManager(provider, str(path))
    _dynstate = dynstate

    def on_eos(root: ?eos436_oper_root, err: ?Exception):
        # A failed poll leaves the interfaces as they were last seen
        if err is not None:
            print("FabricBaseConfigTransform {path}: subscription error: {err}", err=True)
        elif root is not None:
            names: list[str] = []
            for interface in root.interfaces.interface:
                names.append(interface.name)
            found = eos_dynamic_vlan_interfaces(names)
            if found != _dynstate.eos_dynamic_vlan_interface:
                print("FabricBaseConfigTransform {path}: EOS VLAN interfaces of its own: {found}", err=True)
                _dynstate.eos_dynamic_vlan_interface = found
                update_dynstate(_dynstate)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__fabric_base_config_entry):
        want: set[gdata.Delivery] = set()
        if _EOS_MODULE in dev.get_modules().0:
            eos_dst = eos436_oper.dst(on_eos)
            want.add(eos_dst.deliver({eos436_oper.subs.interfaces.interface.name.subscribe(period=_POLL_PERIOD)}))
        _subs.declare(want)

    def shutdown():
        pass


actor _OverlayPoll(path, dev: swdev.DeviceMgr, provider: gdata.TreeProvider, on_srl: proc(?srl25_oper_root)->None, on_eos: proc(?eos436_oper_root, ?Exception)->None):
    """Polls subscriptions from an SR Linux or Arista EOS device and hands
    each delivery to on_srl or on_eos, and None once the device stops
    answering, like FabricInterfaceTransform. An EOS error goes to on_eos,
    which tells a node EOS does not have yet from a failure."""
    _subs = gdata.SubscriptionManager(provider, str(path))
    var _last_delivery: ?int = None
    var _stale = False
    var _running = True
    var _eos = False

    def _watchdog():
        if not _running:
            return
        last = _last_delivery
        if last is not None and not _stale and time.monotonic_ns() - last > _STALE_AFTER_NS:
            print("{path}: no state from the device for {_STALE_AFTER_NS // 1000000000} s, reporting it as unknown", err=True)
            _stale = True
            if _eos:
                on_eos(None, None)
            else:
                on_srl(None)
        after _POLL_PERIOD: _watchdog()

    def _on_srl_delivery(root: ?srl25_oper_root, err: ?Exception):
        if err is not None:
            print("{path}: subscription error: {err}", err=True)
        _last_delivery = time.monotonic_ns()
        _stale = False
        on_srl(root if err is None else None)

    def _on_eos_delivery(root: ?eos436_oper_root, err: ?Exception):
        _last_delivery = time.monotonic_ns()
        _stale = False
        on_eos(root if err is None else None, err)

    def declare(srl_subs: set[gdata.SubscriptionSpec], eos_subs: set[gdata.SubscriptionSpec]):
        want: set[gdata.Delivery] = set()
        modset = dev.get_modules().0
        if "srl_nokia-system" in modset:
            _eos = False
            want.add(srl25_oper.dst(_on_srl_delivery).deliver(srl_subs))
        elif _EOS_MODULE in modset:
            _eos = True
            if len(eos_subs) > 0:
                want.add(eos436_oper.dst(_on_eos_delivery).deliver(eos_subs))
        _subs.declare(want)

    def shutdown():
        _running = False

    proc def __startup__():
        after _POLL_PERIOD: _watchdog()


def _srl_network_instance_subscriptions(name: str) -> set[gdata.SubscriptionSpec]:
    ni = srl25_oper.subs.network_instance.entry(name)
    return {
        ni.oper_state.subscribe(period=_POLL_PERIOD),
        ni.protocols.bgp_evpn.bgp_instance.entry(u64(_EVPN_BGP_INSTANCE)).oper_state.subscribe(period=_POLL_PERIOD)
    }


def _srl_network_instance_status(root: ?srl25_oper_root) -> (?str, ?str):
    """The oper-state of the one network instance subscribed to and of its
    EVPN instance."""
    if root is not None:
        for ni in root.network_instance:
            evpn_status: ?str = None
            bgp_evpn = ni.protocols.bgp_evpn
            if bgp_evpn is not None:
                for instance in bgp_evpn.bgp_instance:
                    evpn_status = _srl_status(instance.oper_state)
            return (_srl_status(ni.oper_state), evpn_status)
    return (None, None)


def _eos_vlan_subscriptions(vlan: u64) -> set[gdata.SubscriptionSpec]:
    # The whole entry of the VLAN, as EOS fails a filter that names the
    # members of a VLAN that has none
    return {
        eos436_oper.subs.network_instances.network_instance.entry("default").vlans.vlan.entry(vlan).subscribe(period=_POLL_PERIOD)
    }


def _eos_no_vlans(err: Exception) -> bool:
    """Whether the VLAN poll failed because the device has no VLAN at all, an
    error where EOS answers an empty reply for a VLAN it does not have."""
    return 'unexpected element "vlans"' in str(err)


def _eos_network_status(root: ?eos436_oper_root) -> (?str, ?str):
    """The state of a network on EOS, from its VLAN: up while the VLAN is
    there, and its EVPN instance up while Vxlan1 forwards in it. EOS has no
    state of its own for an EVPN instance, nor an oper-status for Vxlan1, but
    takes Vxlan1 out of the members of the VLAN when Vxlan1 goes down."""
    if root is not None:
        for ni in root.network_instances.network_instance:
            for vlan in ni.vlans.vlan:
                vxlan_up = False
                for member in vlan.members.member:
                    if member.state.interface == _EOS_VXLAN_INTERFACE:
                        vxlan_up = True
                return ("up", "up" if vxlan_up else "down")
    return (None, None)


def _crpd_vxlan_device(vni: u64) -> str:
    """The Linux VXLAN device cRPD makes for the VNI of a bridge domain."""
    return "vxlan{vni}"


actor _CrpdMacVrfPoll(path, dev: swdev.DeviceMgr, on_state: proc(?str, ?str)->None):
    """Polls the state of a MAC-VRF on a cRPD with Junos RPCs, as
    _CrpdPortPoll does for a port: the EVPN instance, and its VXLAN device
    as rpd sees it. That device stays down while another VXLAN device holds
    UDP port 4789, such as the irb rpd makes at start. Each reply passes on the
    last state of the other; after _STALE_AFTER_NS without a reply the state
    is reported unknown."""
    var _name: ?str = None
    var _vni: ?u64 = None
    var _running = True
    var _oper_status: ?str = None
    var _evpn_status: ?str = None
    var _last_reply: ?int = None
    var _stale = False
    var _error_logged = False

    def watch(name: str, vni: u64):
        _name = name
        _vni = vni

    def stop():
        _running = False

    def _failed(err: Exception):
        if not isinstance(err, NotConnectedError) and not _error_logged:
            print("{path}: polling the cRPD failed: {err}", err=True)
            _error_logged = True

    def _publish():
        if not _running:
            return
        _last_reply = time.monotonic_ns()
        _stale = False
        _error_logged = False
        on_state(_oper_status, _evpn_status)

    def on_instance(reply: ?xml.Node, err: ?Exception):
        if err is not None:
            _failed(err)
        elif reply is not None:
            _oper_status = crpd_evpn_instance_status(reply)
            _publish()

    def on_vxlan(reply: ?xml.Node, err: ?Exception, device: str):
        if err is not None:
            _failed(err)
        elif reply is not None:
            _evpn_status = crpd_oper_status(reply, device)
            _publish()

    def _poll():
        if not _running:
            return
        name = _name
        vni = _vni
        if name is not None and vni is not None:
            device = _crpd_vxlan_device(vni)
            # extensive: the brief reply lists no interfaces
            dev.rpc_xml(on_instance, xml.Node("get-evpn-instance-information", children=[xml.Node("instance-name", text=name), xml.Node("extensive")]))
            dev.rpc_xml(lambda r, e: on_vxlan(r, e, device), _crpd_rpc("get-interfaces-routing", "interface-name", device))
        last = _last_reply
        if last is not None and not _stale and time.monotonic_ns() - last > _STALE_AFTER_NS:
            print("{path}: no state from the device for {_STALE_AFTER_NS // 1000000000} s, reporting it as unknown", err=True)
            _stale = True
            _oper_status = None
            _evpn_status = None
            on_state(None, None)
        after _POLL_PERIOD: _poll()

    proc def __startup__():
        _poll()


def nxos_network_request(vlan: u64, vni: u64) -> xml.Node:
    """The <get> of the state of a network on an NX-OS: its VLAN and its
    VNI on the VTEP."""
    bd = _nxos_path(["bd-items", "bd-items"],
        _nxos_entry("BD-list", "fabEncap", nxos_vlan(int(vlan)), [xml.Node("operSt")]))
    nw = _nxos_path(["eps-items", "epId-items"],
        _nxos_entry("Ep-list", "epId", str(_NXOS_VTEP), [_nxos_path(["nws-items", "opervni-items"],
            _nxos_entry("OperNw-list", "vni", str(vni), [xml.Node("state")]))]))
    system = xml.Node("System", nsdefs=[(None, _NXOS_NAMESPACE)], children=[bd, nw])
    return xml.Node("get", children=[xml.Node("filter", attributes=[("type", "subtree")], children=[system])])


def _nxos_up_down(state: ?str) -> ?str:
    """up or down from an NX-OS state, which some objects spell Up and
    Down, unknown for any other."""
    if state is not None:
        value = state.lower()
        if value == "up" or value == "down":
            return value
        return "unknown"
    return None


def nxos_network_status(reply: xml.Node) -> (?str, ?str):
    """The state of the VLAN of a network and of its VNI on the VTEP from
    the reply to nxos_network_request; None for what NX-OS does not have."""
    oper_status: ?str = None
    evpn_status: ?str = None
    bd = _xml_find(reply, "BD-list")
    if bd is not None:
        oper_status = _nxos_up_down(_xml_text(bd, "operSt"))
    nw = _xml_find(reply, "OperNw-list")
    if nw is not None:
        evpn_status = _nxos_up_down(_xml_text(nw, "state"))
    return (oper_status, evpn_status)


actor _NxosMacVrfPoll(path, dev: swdev.DeviceMgr, on_state: proc(?str, ?str)->None):
    """Polls the state of a network on an NX-OS with one <get> per poll, as
    _NxosPortPoll does for a port. After _STALE_AFTER_NS without a reply the
    state is reported unknown."""
    var _vlan: ?u64 = None
    var _vni: ?u64 = None
    var _running = True
    var _last_reply: ?int = None
    var _stale = False
    var _error_logged = False

    def watch(vlan: u64, vni: u64):
        _vlan = vlan
        _vni = vni

    def stop():
        _running = False

    def on_reply(reply: ?xml.Node, err: ?Exception):
        if not _running:
            return
        if err is not None:
            if not isinstance(err, NotConnectedError) and not _error_logged:
                print("{path}: polling the NX-OS failed: {err}", err=True)
                _error_logged = True
        elif reply is not None:
            _last_reply = time.monotonic_ns()
            _stale = False
            _error_logged = False
            oper_status, evpn_status = nxos_network_status(reply)
            on_state(oper_status, evpn_status)

    def _poll():
        if not _running:
            return
        vlan = _vlan
        vni = _vni
        if vlan is not None and vni is not None:
            dev.rpc_xml(on_reply, nxos_network_request(vlan, vni))
        last = _last_reply
        if last is not None and not _stale and time.monotonic_ns() - last > _STALE_AFTER_NS:
            print("{path}: no state from the device for {_STALE_AFTER_NS // 1000000000} s, reporting it as unknown", err=True)
            _stale = True
            on_state(None, None)
        after _POLL_PERIOD: _poll()

    proc def __startup__():
        _poll()


proc def MacVrfTransform(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__mac_vrf_entry)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    return MacVrfTransformActor(path, update_oper, dev, provider)


actor MacVrfTransformActor(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__mac_vrf_entry)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider):
    _oper = base.MacVrf.new_state(path)
    var _running = True
    var _crpd_poll: ?_CrpdMacVrfPoll = None
    var _nxos_poll: ?_NxosMacVrfPoll = None

    def publish(oper_status: ?str, evpn_status: ?str):
        # A reply to a poll sent before the network was removed would bring
        # its state back
        if not _running:
            return
        _oper.state.oper_status = oper_status
        _oper.state.evpn_status = evpn_status
        update_oper(_oper)

    def on_srl(root: ?srl25_oper_root):
        oper_status, evpn_status = _srl_network_instance_status(root)
        publish(oper_status, evpn_status)

    def on_eos(root: ?eos436_oper_root, err: ?Exception):
        if err is not None and not _eos_no_vlans(err):
            print("MacVrfTransform {path}: subscription error: {err}", err=True)
        oper_status, evpn_status = _eos_network_status(root)
        publish(oper_status, evpn_status)

    _poll = _OverlayPoll(path, dev, provider, on_srl, on_eos)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__mac_vrf_entry):
        vlan = conf.vlan
        eos_subs = _eos_vlan_subscriptions(vlan) if vlan is not None else set()
        _poll.declare(_srl_network_instance_subscriptions(conf.name), eos_subs)
        if _CRPD_MODULE in dev.get_modules().0:
            poll = _crpd_poll
            if poll is not None:
                poll.watch(conf.name, conf.vni)
            else:
                new_poll = _CrpdMacVrfPoll(path, dev, publish)
                new_poll.watch(conf.name, conf.vni)
                _crpd_poll = new_poll
        elif _NXOS_MODULE in dev.get_modules().0 and vlan is not None:
            nxos_poll = _nxos_poll
            if nxos_poll is not None:
                nxos_poll.watch(vlan, conf.vni)
            else:
                new_nxos_poll = _NxosMacVrfPoll(path, dev, publish)
                new_nxos_poll.watch(vlan, conf.vni)
                _nxos_poll = new_nxos_poll

    def shutdown():
        _running = False
        _poll.shutdown()
        poll = _crpd_poll
        if poll is not None:
            poll.stop()
        nxos_poll = _nxos_poll
        if nxos_poll is not None:
            nxos_poll.stop()


proc def IpVrfTransform(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__ip_vrf_entry)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    return IpVrfTransformActor(path, update_oper, dev, provider)


actor IpVrfTransformActor(path, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__ip_vrf_entry)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider):
    _oper = base.IpVrf.new_state(path)

    def on_srl(root: ?srl25_oper_root):
        oper_status, evpn_status = _srl_network_instance_status(root)
        _oper.state.oper_status = oper_status
        _oper.state.evpn_status = evpn_status
        update_oper(_oper)

    def on_eos(root: ?eos436_oper_root, err: ?Exception):
        # EOS has no OpenConfig state of a VRF that dorsi reads yet
        pass

    _poll = _OverlayPoll(path, dev, provider, on_srl, on_eos)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__ip_vrf_entry):
        _poll.declare(_srl_network_instance_subscriptions(conf.name), set())

    def shutdown():
        _poll.shutdown()


proc def ServerLagTransform(path, update_dynstate: proc(?ServerLagDynstate)->None, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__server_lag_entry)->None, dev: swdev.DeviceMgr):
    provider = await async dev.tree_provider()
    dynstate = base.ServerLag.dynstate_type()()
    return ServerLagTransformActor(path, update_dynstate, update_oper, dev, provider, dynstate)


actor ServerLagTransformActor(path, update_dynstate: proc(?ServerLagDynstate)->None, update_oper: proc(?y_1_oper.stratoweave_rfs__rfs__server_lag_entry)->None, dev: swdev.DeviceMgr, provider: gdata.TreeProvider, dynstate: ServerLagDynstate):
    _oper = base.ServerLag.new_state(path)
    _dynstate = dynstate

    def publish(oper_status: ?str, es_status: ?str):
        _oper.state.oper_status = oper_status
        _oper.state.es_status = es_status
        update_oper(_oper)

    def on_srl(root: ?srl25_oper_root):
        oper_status: ?str = None
        es_status: ?str = None
        if root is not None:
            oper_status = _srl_oper_status(root)
            system_ni = root.system.network_instance
            if system_ni is not None:
                evpn = system_ni.protocols.evpn
                if evpn is not None:
                    segments = evpn.ethernet_segments
                    if segments is not None:
                        for instance in segments.bgp_instance:
                            for es in instance.ethernet_segment:
                                es_status = _srl_status(es.oper_state)
        publish(oper_status, es_status)

    def on_eos(root: ?eos436_oper_root, err: ?Exception):
        if err is not None:
            print("ServerLagTransform {path}: subscription error: {err}", err=True)
        oper_status = _eos_oper_status(root) if root is not None else None
        # The LAG is on the device once it has an oper-status: the transform
        # can then add its ethernet segment. It is never taken back, so that
        # a poll that fails does not remove the segment
        if oper_status is not None and _dynstate.lag_present != True:
            _dynstate.lag_present = True
            update_dynstate(_dynstate)
        publish(oper_status, None)

    _poll = _OverlayPoll(path, dev, provider, on_srl, on_eos)

    def on_conf(conf: y_1.stratoweave_rfs__rfs__server_lag_entry):
        srl_subs = {srl25_oper.subs.interface.entry(conf.name).oper_state.subscribe(period=_POLL_PERIOD)}
        if conf.esi is not None:
            es = srl25_oper.subs.system.network_instance.protocols.evpn.ethernet_segments.bgp_instance.entry(u64(_EVPN_BGP_INSTANCE)).ethernet_segment.entry("es-{conf.server}")
            srl_subs.add(es.oper_state.subscribe(period=_POLL_PERIOD))
        eos_subs = {eos436_oper.subs.interfaces.interface.entry(conf.name).state.oper_status.subscribe(period=_POLL_PERIOD)}
        _poll.declare(srl_subs, eos_subs)

    def shutdown():
        _poll.shutdown()
